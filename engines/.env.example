# AEGENTIX Revenue Engines - Environment Variables
# Copy to .env and fill in your values

# ===========================================
# RPC Endpoints (Required)
# ===========================================
ETH_RPC_URL=https://eth.llamarpc.com
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
POLYGON_RPC_URL=https://polygon-rpc.com
XRPL_RPC_URL=https://xrplcluster.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
COSMOS_RPC_URL=https://cosmos-rpc.quickapi.com:443
STACKS_RPC_URL=https://stacks-node-api.mainnet.stacks.co

# ===========================================
# Treasury Addresses (Pre-configured)
# ===========================================
EVM_TREASURY_ADDRESS=0x71C865d4fC35E2a188B67B7A98AcB921098A1904
XRPL_TREASURY_ADDRESS=rZamanXRPLMainnetVaultAddr9948271
SOLANA_TREASURY_ADDRESS=SolanaMinimalTreasuryVault111111111111111111
COSMOS_TREASURY_ADDRESS=cosmos1aegentixminimaltreasuryvault99999
BITCOIN_L2_TREASURY_ADDRESS=bc1qaegentixminimalnodebtc2026vault999

# ===========================================
# AEGENTIX Stablecoin Contract Addresses
# ===========================================
AEGENTIX_STABLECOIN_ETH=0xAEGENTIX...
AEGENTIX_STABLECOIN_BASE=0xAEGENTIX...
AEGENTIX_STABLECOIN_ARBITRUM=0xAEGENTIX...
AEGENTIX_STABLECOIN_OPTIMISM=0xAEGENTIX...
AEGENTIX_STABLECOIN_POLYGON=0xAEGENTIX...
AEGENTIX_STABLECOIN_XRPL=AEGENTIX
AEGENTIX_STABLECOIN_SOLANA=AEGENTIX...
AEGENTIX_STABLECOIN_COSMOS=ibc/AEGENTIX...
AEGENTIX_STABLECOIN_STACKS=SP...AEGENTIX

# ===========================================
# Engine Configuration
# ===========================================
AEGENTIX_PRODUCTION=0  # Set to 1 for live trading
AEGENTIX_LOG_LEVEL=INFO

# ===========================================
# NATS Configuration (for Hermes)
# ===========================================
NATS_URL=nats://aegentis-nats:4222

# ===========================================
# RPC Backup URLs (Optional)
# ===========================================
ETH_RPC_BACKUP=https://eth.drpc.org
BASE_RPC_BACKUP=https://base.drpc.org
ARBITRUM_RPC_BACKUP=https://arbitrum.drpc.org
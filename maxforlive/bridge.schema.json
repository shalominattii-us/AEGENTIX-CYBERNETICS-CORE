{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AEGENTIX Max-for-Live Bridge Envelope",
  "type": "object",
  "required": ["version", "id", "timestamp", "source", "command"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string"},
    "source": {"type": "string", "const": "aegentix"},
    "command": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "enum": ["transport", "tempo", "scene", "clip", "device", "parameter", "telemetry", "record", "stop"]},
        "target": {"type": ["string", "null"]},
        "args": {"type": "object"}
      }
    }
  }
}

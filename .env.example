# Runtime Agent
RUNTIME_AGENT_URL=http://aegentix-runtime:8080
PORT=8080

# HUD Dashboard
HUD_PORT=3000
RUNTIME_AGENT_URL=http://aegentix-runtime:8080
GAIA_URL=http://aegentix-gaia:8090

# Workspace
WORKSPACE=/workspace

# Environment
NODE_ENV=production

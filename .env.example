# Aegentix Configuration

# LLM Configuration
LLM_ENDPOINT=http://localhost:11434/api/generate
LLM_API_KEY=
LLM_MODEL=llama2

# MCP Registry
MCP_REGISTRY_URL=http://mcp-registry:7071/tools

# GAIA Network
GAIA_PEERS=

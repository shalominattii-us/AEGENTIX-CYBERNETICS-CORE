#!/usr/bin/env python3
"""
log_forensics.py
Reconstruct event timeline from fragmented serial logs.

Usage: python log_forensics.py <log_file_or_dir> <output_report.json>
"""

import sys
import os
import re
import json
from datetime import datetime
from collections import defaultdict


class LogForensics:
    """Parse and reconstruct timeline from Flipper One serial/debug logs."""

    # Known log patterns for Flipper One firmware
    PATTERNS = {
        "boot": re.compile(r"(?i)(boot|startup|init|power_on)"),
        "error": re.compile(r"(?i)(error|fail|assert|panic|fault|hardfault)"),
        "warning": re.compile(r"(?i)(warn|warning|caution|attention)"),
        "network": re.compile(r"(?i)(wifi|eth|net|dhcp|ip|ssid|connect)"),
        "power": re.compile(r"(?i)(battery|vbat|voltage|current|pmic|charger)"),
        "graphics": re.compile(r"(?i)(display|lcd|framebuffer|gpu|render)"),
        "audio": re.compile(r"(?i)(audio|codec|speaker|mic|i2s|dac)"),
        "usb": re.compile(r"(?i)(usb|dfu|cdc|hid|msc)"),
        "crash": re.compile(r"(?i)(crash|dump|stack|backtrace|register)"),
    }

    TIMESTAMP_RE = re.compile(
        r"(\d{4}-\d{2}-\d{2}[\sT]\d{2}:\d{2}:\d{2})"
        r"|(\d{2}:\d{2}:\d{2}\.\d+)"
        r"|(\[\s*\d+\.\d+\s*\])"
    )

    def __init__(self):
        self.events = []
        self.timeline = []

    def parse_file(self, filepath):
        """Parse a single log file into structured events."""
        if not os.path.exists(filepath):
            raise FileNotFoundError(f"Log file not found: {filepath}")

        with open(filepath, "r", errors="ignore") as f:
            lines = f.readlines()

        for line_num, line in enumerate(lines, 1):
            line = line.strip()
            if not line:
                continue

            # Extract timestamp if present
            ts_match = self.TIMESTAMP_RE.search(line)
            timestamp = ts_match.group(0) if ts_match else None

            # Classify event type
            event_type = "info"
            for etype, pattern in self.PATTERNS.items():
                if pattern.search(line):
                    event_type = etype
                    break

            self.events.append({
                "source_file": filepath,
                "line_number": line_num,
                "timestamp_raw": timestamp,
                "event_type": event_type,
                "message": line,
                "severity": self._severity(event_type)
            })

    def parse_directory(self, dirpath):
        """Parse all .log and .txt files in a directory."""
        for root, _, files in os.walk(dirpath):
            for fname in files:
                if fname.endswith((".log", ".txt", ".serial")):
                    self.parse_file(os.path.join(root, fname))

    def _severity(self, event_type):
        """Map event type to severity level."""
        severity_map = {
            "crash": 5,
            "error": 4,
            "warning": 3,
            "boot": 2,
            "network": 1,
            "power": 1,
            "graphics": 1,
            "audio": 1,
            "usb": 1,
            "info": 0,
        }
        return severity_map.get(event_type, 0)

    def reconstruct_timeline(self):
        """Sort events and build chronological timeline."""
        # Sort by timestamp if available, otherwise by source file + line
        def sort_key(event):
            if event["timestamp_raw"]:
                try:
                    # Try multiple timestamp formats
                    for fmt in ["%Y-%m-%d %H:%M:%S", "%H:%M:%S.%f", "[%H:%M:%S]"]:
                        try:
                            return datetime.strptime(event["timestamp_raw"], fmt)
                        except ValueError:
                            continue
                except Exception:
                    pass
            return (event["source_file"], event["line_number"])

        self.timeline = sorted(self.events, key=sort_key)
        return self.timeline

    def generate_report(self):
        """Generate forensic analysis report."""
        if not self.timeline:
            self.reconstruct_timeline()

        # Event statistics
        type_counts = defaultdict(int)
        severity_dist = defaultdict(int)

        for event in self.timeline:
            type_counts[event["event_type"]] += 1
            severity_dist[event["severity"]] += 1

        # Find crash/error clusters
        clusters = []
        current_cluster = []

        for event in self.timeline:
            if event["severity"] >= 3:
                current_cluster.append(event)
            else:
                if len(current_cluster) >= 2:
                    clusters.append({
                        "events": current_cluster,
                        "start_line": current_cluster[0]["line_number"],
                        "end_line": current_cluster[-1]["line_number"],
                        "event_count": len(current_cluster)
                    })
                current_cluster = []

        # Catch trailing cluster
        if len(current_cluster) >= 2:
            clusters.append({
                "events": current_cluster,
                "start_line": current_cluster[0]["line_number"],
                "end_line": current_cluster[-1]["line_number"],
                "event_count": len(current_cluster)
            })

        report = {
            "generated_at": datetime.utcnow().isoformat(),
            "total_events": len(self.timeline),
            "event_type_distribution": dict(type_counts),
            "severity_distribution": {str(k): v for k, v in severity_dist.items()},
            "error_clusters": clusters,
            "critical_events": [
                e for e in self.timeline if e["severity"] >= 4
            ],
            "timeline_preview": [
                {
                    "time": e["timestamp_raw"],
                    "type": e["event_type"],
                    "severity": e["severity"],
                    "message": e["message"][:120]
                }
                for e in self.timeline[:50]
            ]
        }

        return report

    def export_report(self, output_path):
        """Export report to JSON file."""
        report = self.generate_report()
        with open(output_path, "w") as f:
            json.dump(report, f, indent=2)
        print(f"[+] Forensic report exported: {output_path}")
        return report


def main():
    if len(sys.argv) < 3:
        print("Usage: python log_forensics.py <log_file_or_dir> <output_report.json>")
        sys.exit(1)

    input_path = sys.argv[1]
    output_path = sys.argv[2]

    forensics = LogForensics()

    if os.path.isdir(input_path):
        print(f"[*] Parsing directory: {input_path}")
        forensics.parse_directory(input_path)
    else:
        print(f"[*] Parsing file: {input_path}")
        forensics.parse_file(input_path)

    print(f"[*] Reconstructing timeline from {len(forensics.events)} events...")
    forensics.reconstruct_timeline()

    report = forensics.export_report(output_path)

    print(f"\n[+] Analysis complete:")
    print(f"    Total events: {report['total_events']}")
    print(f"    Error clusters: {len(report['error_clusters'])}")
    print(f"    Critical events: {len(report['critical_events'])}")

    if report["critical_events"]:
        print(f"\n[!] CRITICAL EVENTS DETECTED:")
        for event in report["critical_events"]:
            print(f"    [{event['event_type'].upper()}] {event['message'][:100]}")


if __name__ == "__main__":
    main()

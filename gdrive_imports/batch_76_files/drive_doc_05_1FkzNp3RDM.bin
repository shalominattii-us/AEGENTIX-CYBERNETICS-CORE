# pipeline-omega-rockchip.yaml
# Deterministic build-deploy orchestration for Flipper One Rockchip Linux

name: pipeline-omega-rockchip
version: "1.0.0"
description: Multi-stage deterministic build graph for RK3566 targets

# ───────────────────────────────────────────
# Global Configuration
# ───────────────────────────────────────────

variables:
  TARGET_ARCH: aarch64
  TARGET_CPU: cortex-a55
  CROSS_COMPILE: aarch64-linux-gnu-
  KERNEL_VERSION: "5.10.160"
  RK_SDK_VERSION: "v1.3.0"
  BUILD_CONTAINER: "flipperone/buildenv:rockchip-v1.3.0"

# ───────────────────────────────────────────
# Stages
# ───────────────────────────────────────────

stages:
  - fetch
  - build
  - test
  - package
  - sign
  - deploy

# ───────────────────────────────────────────
# Jobs
# ───────────────────────────────────────────

jobs:
  fetch-sources:
    stage: fetch
    script:
      - git submodule update --init --recursive
      - verify-manifest manifest.lock
      - clone-constellation-mesh --tag v1.0.0
      - clone-aegentis-llm --tag v1.0.0
    artifacts:
      paths:
        - sources/
      expire_in: 1 hour

  build-kernel:
    stage: build
    needs: [fetch-sources]
    container: ${BUILD_CONTAINER}
    script:
      - cd sources/linux-rockchip
      - make ARCH=${TARGET_ARCH} CROSS_COMPILE=${CROSS_COMPILE} flipper_one_defconfig
      - make ARCH=${TARGET_ARCH} CROSS_COMPILE=${CROSS_COMPILE} -j$(nproc)
      - make ARCH=${TARGET_ARCH} CROSS_COMPILE=${CROSS_COMPILE} modules
    artifacts:
      paths:
        - build/kernel/
        - build/modules/

  build-userspace:
    stage: build
    needs: [fetch-sources]
    container: ${BUILD_CONTAINER}
    script:
      - cd sources/constellation-mesh
      - cargo build --release --target aarch64-unknown-linux-gnu
      - cd sources/aegentis-embedded-llm
      - podman build -t aegentis-llm:latest .
    artifacts:
      paths:
        - build/userspace/
        - build/containers/

  test-qemu:
    stage: test
    needs: [build-kernel, build-userspace]
    container: ${BUILD_CONTAINER}
    script:
      - qemu-system-aarch64 -M virt -cpu cortex-a55 -kernel build/kernel/Image -initrd build/initrd.cpio
      - cd sources/constellation-mesh
      - cargo test --target aarch64-unknown-linux-gnu
      - python -m pytest sources/aegentis-embedded-llm/tests/
    artifacts:
      reports:
        junit: test-results.xml

  package-firmware:
    stage: package
    needs: [test-qemu]
    script:
      - mkimage -A arm64 -O linux -T kernel -C none -a 0x00280000 -e 0x00280000 -n "FlipperOne" -d build/kernel/Image build/firmware/kernel.img
      - mksquashfs build/userspace/ build/firmware/rootfs.squashfs -comp xz
      - generate-update-package build/firmware/ flipper-one-firmware-${CI_COMMIT_SHA}.zip
    artifacts:
      paths:
        - build/firmware/

  sign-artifacts:
    stage: sign
    needs: [package-firmware]
    script:
      - for f in build/firmware/*; do
          sha256sum "$f" >> build/firmware/artifacts.sha256;
          gpg --detach-sign --armor "$f";
        done
      - cat build/firmware/artifacts.sha256
    artifacts:
      paths:
        - build/firmware/
        - build/firmware/artifacts.sha256

  deploy-devboard:
    stage: deploy
    needs: [sign-artifacts]
    when: manual
    script:
      - adb push build/firmware/ /sdcard/flipper-update/
      - adb shell "reboot recovery"
    environment:
      name: devboard
      url: https://flipper.one/devboard

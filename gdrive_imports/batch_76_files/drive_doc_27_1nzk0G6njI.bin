#!/usr/bin/env python3
"""
intent_parser.py
AEGENTIS Grammar Engine for Flipper One

Deterministic intent-grammar parser that extracts structured commands
from natural language input. Zero ML dependency — pure regex + grammar rules.

Usage:
    python intent_parser.py "turn on wifi and scan for networks"
"""

import re
import json
import sys
from dataclasses import dataclass, asdict
from typing import List, Dict, Optional, Tuple


@dataclass
class ParsedIntent:
    raw_input: str
    primary_action: str
    target_subsystem: str
    parameters: Dict[str, str]
    confidence: float  # 0.0 - 1.0
    alternatives: List[Dict]


class AEGENTISGrammar:
    """
    Deterministic intent-grammar engine.

    Grammar structure:
    - ACTION -> VERB + [MODIFIER] + TARGET
    - VERB -> "turn on" | "enable" | "start" | "check" | "scan" | "disable" | ...
    - TARGET -> SUBSYSTEM + [PARAM]
    - SUBSYSTEM -> "wifi" | "bluetooth" | "display" | "battery" | "nfc" | ...
    """

    VERBS = {
        "enable": {"synonyms": ["turn on", "start", "activate", "enable"], "weight": 1.0},
        "disable": {"synonyms": ["turn off", "stop", "deactivate", "disable"], "weight": 1.0},
        "check": {"synonyms": ["get", "read", "query", "check", "show"], "weight": 1.0},
        "scan": {"synonyms": ["discover", "find", "scan", "search"], "weight": 1.0},
        "set": {"synonyms": ["configure", "set", "adjust", "change"], "weight": 1.0},
        "flash": {"synonyms": ["program", "write", "flash", "update"], "weight": 1.0},
    }

    SUBSYSTEMS = {
        "wifi": {"synonyms": ["wifi", "wireless", "wlan", "network"], "params": ["ssid", "channel", "power"]},
        "bluetooth": {"synonyms": ["bluetooth", "bt", "ble"], "params": ["device", "mode"]},
        "display": {"synonyms": ["display", "screen", "lcd", "monitor"], "params": ["brightness", "mode"]},
        "battery": {"synonyms": ["battery", "power", "charge", "vbat"], "params": ["level", "status"]},
        "nfc": {"synonyms": ["nfc", "rfid", "125khz", "subghz"], "params": ["tag", "frequency"]},
        "cpu": {"synonyms": ["cpu", "processor", "rockchip"], "params": ["load", "temp", "freq"]},
        "audio": {"synonyms": ["audio", "sound", "speaker", "mic"], "params": ["volume", "source"]},
        "usb": {"synonyms": ["usb", "dfu", "serial"], "params": ["mode", "port"]},
    }

    def __init__(self):
        self._build_patterns()

    def _build_patterns(self):
        """Pre-compile regex patterns for all verbs and subsystems."""
        self.verb_patterns = {}
        for action, data in self.VERBS.items():
            synonyms = data["synonyms"]
            pattern = r"(?i)(" + "|".join(re.escape(s) for s in synonyms) + r")"
            self.verb_patterns[action] = re.compile(pattern)

        self.subsystem_patterns = {}
        for subsys, data in self.SUBSYSTEMS.items():
            synonyms = data["synonyms"]
            pattern = r"(?i)(" + "|".join(re.escape(s) for s in synonyms) + r")"
            self.subsystem_patterns[subsys] = re.compile(pattern)

    def parse(self, input_text: str) -> ParsedIntent:
        """Parse natural language into structured intent."""
        input_lower = input_text.lower().strip()

        # Extract action
        action, action_conf = self._extract_action(input_lower)

        # Extract subsystem
        subsystem, subsys_conf = self._extract_subsystem(input_lower)

        # Extract parameters
        params = self._extract_parameters(input_lower, subsystem)

        # Compute overall confidence
        confidence = (action_conf + subsys_conf) / 2.0
        if params:
            confidence = min(1.0, confidence + 0.1)

        # Generate alternatives
        alternatives = self._generate_alternatives(input_lower, action, subsystem)

        return ParsedIntent(
            raw_input=input_text,
            primary_action=action or "unknown",
            target_subsystem=subsystem or "unknown",
            parameters=params,
            confidence=round(confidence, 3),
            alternatives=alternatives
        )

    def _extract_action(self, text: str) -> Tuple[Optional[str], float]:
        """Extract primary action verb from input."""
        for action, pattern in self.verb_patterns.items():
            if pattern.search(text):
                return action, 1.0
        return None, 0.0

    def _extract_subsystem(self, text: str) -> Tuple[Optional[str], float]:
        """Extract target subsystem from input."""
        for subsys, pattern in self.subsystem_patterns.items():
            if pattern.search(text):
                return subsys, 1.0
        return None, 0.0

    def _extract_parameters(self, text: str, subsystem: Optional[str]) -> Dict[str, str]:
        """Extract key-value parameters from input."""
        params = {}

        if not subsystem or subsystem not in self.SUBSYSTEMS:
            return params

        known_params = self.SUBSYSTEMS[subsystem]["params"]

        # Numeric parameter extraction
        for param in known_params:
            # Pattern: "param X" or "param to X" or "param = X"
            patterns = [
                rf"(?i){param}\s+(?:to\s+|is\s+|=\s*)?(\d+|\w+)",
                rf"(?i){param}\s*[=:]\s*(\d+|\w+)",
            ]
            for pat in patterns:
                match = re.search(pat, text)
                if match:
                    params[param] = match.group(1)
                    break

        # Generic string parameter extraction (quoted strings)
        quoted = re.findall(r'"([^"]+)"', text)
        if quoted and not params:
            params["value"] = quoted[0]

        return params

    def _generate_alternatives(self, text: str, 
                                current_action: Optional[str], 
                                current_subsystem: Optional[str]) -> List[Dict]:
        """Generate alternative interpretations."""
        alternatives = []

        # If action is unclear, suggest all possible actions
        if not current_action:
            for action in self.VERBS:
                alternatives.append({
                    "action": action,
                    "subsystem": current_subsystem or "unknown",
                    "confidence": 0.3
                })

        # If subsystem is unclear, suggest all possible subsystems
        if not current_subsystem:
            for subsys in self.SUBSYSTEMS:
                alternatives.append({
                    "action": current_action or "unknown",
                    "subsystem": subsys,
                    "confidence": 0.3
                })

        return alternatives[:5]  # Cap at 5 alternatives

    def to_json(self, intent: ParsedIntent) -> str:
        """Serialize parsed intent to JSON."""
        return json.dumps(asdict(intent), indent=2)


def main():
    if len(sys.argv) < 2:
        print("Usage: python intent_parser.py <input_text>")
        print("Example: python intent_parser.py 'turn on wifi and scan for networks'")
        sys.exit(1)

    input_text = sys.argv[1]
    parser = AEGENTISGrammar()
    intent = parser.parse(input_text)

    print(parser.to_json(intent))


if __name__ == "__main__":
    main()

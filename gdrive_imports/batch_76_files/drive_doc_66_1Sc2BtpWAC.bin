#!/bin/bash
# ============================================================
# AEGENTIX BIND — ONE-SHOT DEPLOYER
# Run this IN CloudShell. It deploys to EC2 via SSH.
# For Ubuntu, save and run locally.
# ============================================================
set -e

EC2_IP="13.57.241.103"
EC2_USER="ec2-user"
SSH_KEY="${HOME}/.ssh/sovereign-key.pem"
AUTH_TOKEN="sov-ae-7a3f9e2b8c1d4e5f6a0b9c8d7e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0"

echo "[Ω] AEGENTIX BIND — ONE-SHOT DEPLOYER"
echo "[Ω] Target: ${EC2_USER}@${EC2_IP}"
echo ""

# Check SSH key exists
if [ ! -f "$SSH_KEY" ]; then
    echo "[Ω] SSH key not found at $SSH_KEY"
    echo "[Ω] Checking common locations..."
    for k in ~/.ssh/id_rsa ~/.ssh/id_ed25519 ~/.ssh/sovereign.pem ~/.ssh/ec2-key.pem; do
        [ -f "$k" ] && SSH_KEY="$k" && echo "[Ω] Found: $k" && break
    done
fi

if [ ! -f "$SSH_KEY" ]; then
    echo "[Ω] ERROR: No SSH key found. Cannot deploy to EC2."
    echo "[Ω] Place your .pem file in ~/.ssh/ and rename it, or update SSH_KEY above."
    exit 1
fi

chmod 600 "$SSH_KEY"

# ============================================================
# EC2 DEPLOY SCRIPT (embedded, sent via SSH)
# ============================================================
EC2_SCRIPT=$(cat <<'INNERSCRIPT'
#!/bin/bash
set -e
JARVIS_HOME="/home/ec2-user/.jarvis/daemon"
LOG_DIR="$JARVIS_HOME/logs"
mkdir -p "$LOG_DIR"

echo "[Ω] Writing EC2 config.yaml..."
cat > "$JARVIS_HOME/config.yaml" <<'CONFIGEOF'
brain_domain:
  enabled: true
  endpoint: "ws://aegentix.sovereign:8443"
  node_id: "ec2-primary"
  node_role: "sovereign_brain"
  auth_token: "${AEGENTIX_AUTH_TOKEN}"
  heartbeat_interval: 30
  reconnect_backoff: [5, 10, 30, 60]
  capabilities:
    - agent_reasoning
    - workflow_cognition
    - autonomous_goal_evaluation
    - multi_agent_orchestration
    - distributed_decision_making
  routing:
    default_upstream: "aegentix"
    fallback_local: true
    priority: 1
mesh_sync:
  enabled: true
  peers:
    - "ws://13.57.241.103:3142/ws"
    - "ws://localhost:3142/ws"
  sync_interval: 10
  topics: ["goals", "workflows", "agent_states", "health"]
CONFIGEOF

echo "[Ω] Writing EC2 .env..."
cat > "$JARVIS_HOME/.env" <<'ENVEOF'
AEGENTIX_AUTH_TOKEN=sov-ae-7a3f9e2b8c1d4e5f6a0b9c8d7e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0
AEGENTIX_ENDPOINT=ws://aegentix.sovereign:8443
NODE_ID=ec2-primary
AWS_REGION=us-west-2
ENVEOF

echo "[Ω] Writing bridge module..."
cat > "$JARVIS_HOME/src/aegentix-bridge.ts" <<'BRIDGEEOF'
interface AEGENTIXMessage {
  type: 'reasoning' | 'orchestration' | 'goal_eval' | 'decision';
  payload: any;
  source_node: string;
  priority: number;
  timestamp: string;
}
class AEGENTIXBridge {
  private ws: WebSocket; private nodeId: string;
  constructor(endpoint: string, authToken: string, nodeId: string) {
    this.nodeId = nodeId; this.connect(endpoint, authToken);
  }
  private connect(endpoint: string, authToken: string) {
    this.ws = new WebSocket(endpoint, [], { headers: { 'Authorization': `Bearer ${authToken}` } });
    this.ws.on('open', () => { console.log(`[Ω] AEGENTIX connected: ${this.nodeId}`); this.registerNode(); });
    this.ws.on('message', (data: string) => { this.routeToLocalEngine(JSON.parse(data)); });
    this.ws.on('close', () => { console.log('[Ω] AEGENTIX disconnected, reconnecting...'); setTimeout(() => this.connect(endpoint, authToken), 30000); });
  }
  private registerNode() {
    this.ws.send(JSON.stringify({ type: 'register', node_id: this.nodeId, capabilities: ['agent_reasoning','workflow_cognition','multi_agent_orchestration'], region: 'us-west-2' }));
  }
  private routeToLocalEngine(msg: AEGENTIXMessage) {
    switch(msg.type) {
      case 'reasoning': break;
      case 'orchestration': break;
      case 'goal_eval': break;
      case 'decision': break;
    }
  }
  public broadcastToMesh(msg: AEGENTIXMessage) {}
}
export { AEGENTIXBridge };
BRIDGEEOF

echo "[Ω] Restarting daemon..."
pkill -f "jarvis daemon" 2>/dev/null || true
cd "$JARVIS_HOME"
export $(cat .env | xargs)
nohup bun run src/daemon.ts --brain-domain > "$LOG_DIR/aegentix-bind.log" 2>&1 &
sleep 4

if curl -s http://localhost:3142/health | grep -q '"status":"ok"'; then
  echo "[ΩΩΩ] EC2 PRIMARY bound to AEGENTIX — CONFIRMED"
else
  echo "[Ω] EC2 bind check inconclusive — daemon may still be starting"
  echo "[Ω] Log: $LOG_DIR/aegentix-bind.log"
fi
INNERSCRIPT
)

# Write EC2 script to temp
echo "$EC2_SCRIPT" > /tmp/aegentix-bind-ec2.sh
chmod +x /tmp/aegentix-bind-ec2.sh

# Copy to EC2 and execute
echo "[Ω] Copying deploy script to EC2..."
scp -i "$SSH_KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null /tmp/aegentix-bind-ec2.sh "${EC2_USER}@${EC2_IP}:/tmp/"

echo "[Ω] Executing on EC2..."
ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "${EC2_USER}@${EC2_IP}" "bash /tmp/aegentix-bind-ec2.sh"

# Also write Ubuntu script locally for manual transfer
echo ""
echo "[Ω] Writing Ubuntu deploy script to /tmp/aegentix-bind-ubuntu.sh..."
cat > /tmp/aegentix-bind-ubuntu.sh <<'UBUNTUSCRIPT'
#!/bin/bash
set -e
JARVIS_HOME="/home/eagle/.jarvis/daemon"
LOG_DIR="$JARVIS_HOME/logs"
mkdir -p "$LOG_DIR"

cat > "$JARVIS_HOME/config.yaml" <<'CONFIGEOF'
brain_domain:
  enabled: true
  endpoint: "ws://aegentix.sovereign:8443"
  node_id: "ubuntu-secondary"
  node_role: "sovereign_brain"
  auth_token: "${AEGENTIX_AUTH_TOKEN}"
  heartbeat_interval: 30
  reconnect_backoff: [5, 10, 30, 60]
  capabilities:
    - agent_reasoning
    - workflow_cognition
    - autonomous_goal_evaluation
    - multi_agent_orchestration
    - distributed_decision_making
  routing:
    default_upstream: "aegentix"
    fallback_local: true
    priority: 2
mesh_sync:
  enabled: true
  peers:
    - "ws://13.57.241.103:3142/ws"
    - "ws://localhost:3142/ws"
  sync_interval: 10
  topics: ["goals", "workflows", "agent_states", "health"]
CONFIGEOF

cat > "$JARVIS_HOME/.env" <<'ENVEOF'
AEGENTIX_AUTH_TOKEN=sov-ae-7a3f9e2b8c1d4e5f6a0b9c8d7e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0
AEGENTIX_ENDPOINT=ws://aegentix.sovereign:8443
NODE_ID=ubuntu-secondary
AWS_REGION=us-west-2
ENVEOF

cat > "$JARVIS_HOME/src/aegentix-bridge.ts" <<'BRIDGEEOF'
interface AEGENTIXMessage {
  type: 'reasoning' | 'orchestration' | 'goal_eval' | 'decision';
  payload: any;
  source_node: string;
  priority: number;
  timestamp: string;
}
class AEGENTIXBridge {
  private ws: WebSocket; private nodeId: string;
  constructor(endpoint: string, authToken: string, nodeId: string) {
    this.nodeId = nodeId; this.connect(endpoint, authToken);
  }
  private connect(endpoint: string, authToken: string) {
    this.ws = new WebSocket(endpoint, [], { headers: { 'Authorization': `Bearer ${authToken}` } });
    this.ws.on('open', () => { console.log(`[Ω] AEGENTIX connected: ${this.nodeId}`); this.registerNode(); });
    this.ws.on('message', (data: string) => { this.routeToLocalEngine(JSON.parse(data)); });
    this.ws.on('close', () => { console.log('[Ω] AEGENTIX disconnected, reconnecting...'); setTimeout(() => this.connect(endpoint, authToken), 30000); });
  }
  private registerNode() {
    this.ws.send(JSON.stringify({ type: 'register', node_id: this.nodeId, capabilities: ['agent_reasoning','workflow_cognition','multi_agent_orchestration'], region: 'us-west-2' }));
  }
  private routeToLocalEngine(msg: AEGENTIXMessage) {
    switch(msg.type) {
      case 'reasoning': break;
      case 'orchestration': break;
      case 'goal_eval': break;
      case 'decision': break;
    }
  }
  public broadcastToMesh(msg: AEGENTIXMessage) {}
}
export { AEGENTIXBridge };
BRIDGEEOF

pkill -f "jarvis daemon" 2>/dev/null || true
cd "$JARVIS_HOME"
export $(cat .env | xargs)
nohup bun run src/daemon.ts --brain-domain > "$LOG_DIR/aegentix-bind.log" 2>&1 &
sleep 4

if curl -s http://localhost:3142/health | grep -q '"status":"ok"'; then
  echo "[ΩΩΩ] UBUNTU SECONDARY bound to AEGENTIX — CONFIRMED"
else
  echo "[Ω] Ubuntu bind check inconclusive — daemon may still be starting"
  echo "[Ω] Log: $LOG_DIR/aegentix-bind.log"
fi
UBUNTUSCRIPT
chmod +x /tmp/aegentix-bind-ubuntu.sh

echo ""
echo "[ΩΩΩ] ONE-SHOT COMPLETE"
echo "[Ω] Ubuntu script saved: /tmp/aegentix-bind-ubuntu.sh"
echo "[Ω] Transfer to Ubuntu and run: bash /tmp/aegentix-bind-ubuntu.sh"

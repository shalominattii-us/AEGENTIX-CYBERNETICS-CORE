#!/bin/bash
# build.sh — Pipeline Omega Rockchip Build Script
# Deterministic build orchestration for Flipper One RK3566

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
BUILD_DIR="${PROJECT_ROOT}/build"
SOURCES_DIR="${PROJECT_ROOT}/sources"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() {
    echo -e "${GREEN}[BUILD]${NC} $*"
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $*"
}

error() {
    echo -e "${RED}[ERROR]${NC} $*"
    exit 1
}

# ───────────────────────────────────────────
# Pre-flight checks
# ───────────────────────────────────────────

log "=== Pipeline Omega Rockchip Build ==="
log "Build directory: ${BUILD_DIR}"
log "Sources directory: ${SOURCES_DIR}"

[[ -f "${SCRIPT_DIR}/manifest.lock" ]] || error "manifest.lock not found. Run fetch first."

# Verify cross-compiler
if ! command -v aarch64-linux-gnu-gcc &>/dev/null; then
    error "aarch64-linux-gnu-gcc not found. Install cross-compilation toolchain."
fi

# Verify container runtime
if command -v podman &>/dev/null; then
    CONTAINER_RUNTIME="podman"
elif command -v docker &>/dev/null; then
    CONTAINER_RUNTIME="docker"
else
    warn "No container runtime found. Container builds will be skipped."
    CONTAINER_RUNTIME=""
fi

# Create build directories
mkdir -p "${BUILD_DIR}"/{kernel,modules,userspace,containers,firmware,logs}

# ───────────────────────────────────────────
# Stage 1: Fetch
# ───────────────────────────────────────────

stage_fetch() {
    log "Stage 1: Fetching sources..."

    mkdir -p "${SOURCES_DIR}"

    # Read manifest
    while IFS=' ' read -r repo_url commit_hash target_dir; do
        [[ "$repo_url" =~ ^# ]] && continue
        [[ -z "$repo_url" ]] && continue

        dest="${SOURCES_DIR}/${target_dir}"

        if [[ -d "${dest}/.git" ]]; then
            log "  Updating ${target_dir}..."
            cd "${dest}"
            git fetch origin
            git checkout "${commit_hash}"
        else
            log "  Cloning ${target_dir}..."
            git clone "${repo_url}" "${dest}"
            cd "${dest}"
            git checkout "${commit_hash}"
        fi
    done < "${SCRIPT_DIR}/manifest.lock"

    log "Stage 1 complete."
}

# ───────────────────────────────────────────
# Stage 2: Build Kernel
# ───────────────────────────────────────────

stage_build_kernel() {
    log "Stage 2: Building kernel..."

    local kernel_src="${SOURCES_DIR}/linux-rockchip"
    [[ -d "${kernel_src}" ]] || error "Kernel source not found: ${kernel_src}"

    cd "${kernel_src}"

    # Load Flipper One defconfig
    make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- flipper_one_defconfig

    # Build kernel
    make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- -j"$(nproc)" 2>&1 |         tee "${BUILD_DIR}/logs/kernel-build.log"

    # Build modules
    make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- modules -j"$(nproc)" 2>&1 |         tee -a "${BUILD_DIR}/logs/kernel-build.log"

    # Copy outputs
    cp arch/arm64/boot/Image "${BUILD_DIR}/kernel/"
    cp arch/arm64/boot/dts/rockchip/*.dtb "${BUILD_DIR}/kernel/" 2>/dev/null || true

    # Install modules
    make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu-         INSTALL_MOD_PATH="${BUILD_DIR}/modules" modules_install

    log "Stage 2 complete. Kernel: ${BUILD_DIR}/kernel/Image"
}

# ───────────────────────────────────────────
# Stage 3: Build Userspace
# ───────────────────────────────────────────

stage_build_userspace() {
    log "Stage 3: Building userspace..."

    # Constellation Mesh (Rust)
    local mesh_src="${SOURCES_DIR}/constellation-mesh"
    if [[ -d "${mesh_src}" ]]; then
        log "  Building constellation-meshd..."
        cd "${mesh_src}"

        # Ensure Rust target is installed
        rustup target add aarch64-unknown-linux-gnu 2>/dev/null || true

        cargo build --release --target aarch64-unknown-linux-gnu 2>&1 |             tee "${BUILD_DIR}/logs/mesh-build.log"

        cp "target/aarch64-unknown-linux-gnu/release/constellation-meshd"             "${BUILD_DIR}/userspace/"
    fi

    # AEGENTIS LLM Container
    local llm_src="${SOURCES_DIR}/aegentis-embedded-llm"
    if [[ -d "${llm_src}" ]] && [[ -n "${CONTAINER_RUNTIME}" ]]; then
        log "  Building AEGENTIS LLM container..."
        cd "${llm_src}"
        ${CONTAINER_RUNTIME} build -t aegentis-llm:latest . 2>&1 |             tee "${BUILD_DIR}/logs/llm-container-build.log"

        # Export container image
        ${CONTAINER_RUNTIME} save aegentis-llm:latest | gzip >             "${BUILD_DIR}/containers/aegentis-llm.tar.gz"
    fi

    log "Stage 3 complete."
}

# ───────────────────────────────────────────
# Stage 4: Package
# ───────────────────────────────────────────

stage_package() {
    log "Stage 4: Packaging firmware..."

    local fw_dir="${BUILD_DIR}/firmware"
    mkdir -p "${fw_dir}"

    # Package kernel
    cp "${BUILD_DIR}/kernel/Image" "${fw_dir}/"

    # Package DTBs
    if [[ -d "${BUILD_DIR}/kernel" ]]; then
        cp "${BUILD_DIR}/kernel"/*.dtb "${fw_dir}/" 2>/dev/null || true
    fi

    # Package modules as tarball
    tar czf "${fw_dir}/modules.tar.gz" -C "${BUILD_DIR}/modules" .

    # Package userspace binaries
    tar czf "${fw_dir}/userspace.tar.gz" -C "${BUILD_DIR}/userspace" .

    # Package containers
    if [[ -f "${BUILD_DIR}/containers/aegentis-llm.tar.gz" ]]; then
        cp "${BUILD_DIR}/containers/aegentis-llm.tar.gz" "${fw_dir}/"
    fi

    # Generate update manifest
    cat > "${fw_dir}/manifest.json" <<EOF
{
  "version": "$(date +%Y%m%d.%H%M%S)",
  "commit": "$(git -C ${PROJECT_ROOT} rev-parse HEAD 2>/dev/null || echo 'unknown')",
  "components": {
    "kernel": "Image",
    "modules": "modules.tar.gz",
    "userspace": "userspace.tar.gz",
    "containers": "aegentis-llm.tar.gz"
  },
  "generated_at": "$(date -Iseconds)"
}
EOF

    log "Stage 4 complete. Firmware: ${fw_dir}/"
}

# ───────────────────────────────────────────
# Stage 5: Sign
# ───────────────────────────────────────────

stage_sign() {
    log "Stage 5: Signing artifacts..."

    local fw_dir="${BUILD_DIR}/firmware"
    local hash_file="${fw_dir}/artifacts.sha256"

    > "${hash_file}"

    for f in "${fw_dir}"/*; do
        [[ -f "$f" ]] || continue
        [[ "$(basename "$f")" == "artifacts.sha256" ]] && continue

        local hash=$(sha256sum "$f" | awk '{print $1}')
        local fname=$(basename "$f")
        echo "${hash}  ${fname}" >> "${hash_file}"

        # Sign if GPG key available
        if gpg --list-secret-keys &>/dev/null; then
            gpg --detach-sign --armor --output "${f}.sig" "$f" 2>/dev/null ||                 warn "Failed to sign ${fname}"
        fi
    done

    log "Stage 5 complete. Hashes: ${hash_file}"
}

# ───────────────────────────────────────────
# Main
# ───────────────────────────────────────────

main() {
    local stage="${1:-all}"

    case "$stage" in
        fetch) stage_fetch ;;
        kernel) stage_fetch; stage_build_kernel ;;
        userspace) stage_fetch; stage_build_userspace ;;
        package) stage_fetch; stage_build_kernel; stage_build_userspace; stage_package ;;
        sign) stage_sign ;;
        all)
            stage_fetch
            stage_build_kernel
            stage_build_userspace
            stage_package
            stage_sign
            ;;
        *)
            echo "Usage: $0 [fetch|kernel|userspace|package|sign|all]"
            exit 1
            ;;
    esac

    log "=== Build Complete ==="
    log "Artifacts: ${BUILD_DIR}/firmware/"
    log "Logs: ${BUILD_DIR}/logs/"
}

main "$@"

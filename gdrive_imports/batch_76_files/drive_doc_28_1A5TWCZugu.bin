# Sovereign Meta v4.0 — One Simple Installer
param([int]$Port=7373)
$ErrorActionPreference="Stop"
$Install="$env:USERPROFILE\sovereign-meta"

# Remove old if exists
if(Test-Path $Install){Remove-Item -Recurse -Force $Install}

# Check Node.js
try{$ver=&node --version}catch{
    Write-Host "Node.js required. Install from nodejs.org" -ForegroundColor Red
    exit 1
}
Write-Host "Node.js $ver found" -ForegroundColor Green

# Extract project from embedded base64
Write-Host "Extracting Sovereign Meta..." -ForegroundColor Cyan
$bytes=[System.Convert]::FromBase64String("")
$tmp="$env:TEMP\sm.zip"
[System.IO.File]::WriteAllBytes($tmp,$bytes)
New-Item -ItemType Directory -Path $Install -Force | Out-Null
Add-Type -AssemblyName System.IO.Compression.FileSystem
[System.IO.Compression.ZipFile]::ExtractToDirectory($tmp,$Install)

# Install dependencies
Write-Host "Installing dependencies..." -ForegroundColor Cyan
Set-Location $Install
npm install | Out-Null

# Build TypeScript
Write-Host "Building..." -ForegroundColor Cyan
npx tsc | Out-Null

# Update port in .env
(Get-Content .env -Raw) -replace "SM_PORT=\d+","SM_PORT=$Port" | Out-File .env -Encoding utf8

# Start
Write-Host ""
Write-Host "Sovereign Meta v4.0 is LIVE" -ForegroundColor Green
Write-Host "http://localhost:$Port" -ForegroundColor Green
Write-Host "Dashboard: http://localhost:$Port/dashboard" -ForegroundColor Green
Write-Host "WebSocket: ws://localhost:$Port/ws" -ForegroundColor Green
Write-Host ""
Write-Host "Press Ctrl+C to stop" -ForegroundColor Yellow
Write-Host ""

& node dist/server.js

setlocal

echo.
echo ============================================
echo        DXVR MONOLITH AUTO-BUILDER
echo ============================================
echo.

REM --- Detect Developer Command Prompt environment ---
where cl &gt;nul 2&gt;nul
if %errorlevel% neq 0 (
    echo ERROR: MSVC compiler not found.
    echo You MUST run this script from:
    echo   "x64 Native Tools Command Prompt for VS 2022"
    echo.
    pause
    exit /b 1
)

REM --- Clean old build ---
if exist DXVR_Monolith.obj del DXVR_Monolith.obj
if exist DXVR_Monolith.exe del DXVR_Monolith.exe

echo [1/2] Compiling DXVR_Monolith.cpp...
cl DXVR_Monolith.cpp /EHsc /DUNICODE /D_UNICODE d3d11.lib dxgi.lib dxguid.lib d3dcompiler.lib
if %errorlevel% neq 0 (
    echo.
    echo Build FAILED.
    echo Fix errors above and run again.
    echo.
    pause
    exit /b 1
)

echo.
echo [2/2] Build complete!
echo DXVR_Monolith.exe is ready.
echo.

echo ============================================
echo        RUNNING DXVR MONOLITH
echo ============================================
echo.

DXVR_Monolith.exe
pause
</code></pre></div></div></div><div class="relative pb-6 w-full after:border-b after:border-stroke-300 after:w-full after:absolute after:mt-3"></div><h1 class="text-2xl-medium [&amp;:not(:first-child)]:pt-6">⭐ What this script does</h1><ul class="relative list-outside marker:text-foreground-750 dark:marker:text-foreground-600 flex flex-col ms-4 px-1"><li class="ps-2" style="opacity: 1;"><p><span class="font-ligatures-none whitespace-pre-wrap">Detects MSVC compiler</span></p></li><li class="ps-2" style="opacity: 1;"><p><span class="font-ligatures-none whitespace-pre-wrap">Compiles your monolith with all required libs</span></p></li><li class="ps-2" style="opacity: 1;"><p><span class="font-ligatures-none whitespace-pre-wrap">Produces <code class="font-ligatures-none mx-0.5 rounded-[4px] border border-stroke-300 bg-accent-200/60 px-1 py-px font-mono text-foreground-800 text-sm dark:bg-accent-200" style="opacity: 1;">DXVR_Monolith.exe</code></span></p></li><li class="ps-2" style="opacity: 1;"><p><span class="font-ligatures-none whitespace-pre-wrap">Automatically <strong>runs it</strong></span></p></li><li class="ps-2" style="opacity: 1;"><p><span class="font-ligatures-none whitespace-pre-wrap">Pauses so you can see output</span></p></li></ul><p><span class="font-ligatures-none whitespace-pre-wrap">This is the <strong>true one‑click workflow</strong>.</span></p><div class="relative pb-6 w-full after:border-b after:border-stroke-300 after:w-full after:absolute after:mt-3"></div><h1 class="text-2xl-medium [&amp;:not(:first-child)]:pt-6">⭐ If you want the next evolution</h1><p><span class="font-ligatures-none whitespace-pre-wrap">Choose one:</span></p><ul class="relative list-outside marker:text-foreground-750 dark:marker:text-foreground-600 flex flex-col ms-4 px-1"><li class="ps-2" style="opacity: 1;"><p><span class="font-ligatures-none whitespace-pre-wrap"><strong><span class="text-start underline-offset-[0.25em] underline decoration-dotted decoration-foreground-450 decor
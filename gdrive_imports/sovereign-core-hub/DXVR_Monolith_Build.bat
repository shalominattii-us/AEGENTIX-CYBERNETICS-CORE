        </span><span initial="start" animate="end" variants="[object Object]" custom="0"><span class="hljs-variable">${SHADER_FILES}</span></span><span initial="start" animate="end" variants="[object Object]" custom="0">
        </span><span initial="start" animate="end" variants="[object Object]" custom="0">$&lt;TARGET_FILE_DIR:DXVR&gt;/shaders

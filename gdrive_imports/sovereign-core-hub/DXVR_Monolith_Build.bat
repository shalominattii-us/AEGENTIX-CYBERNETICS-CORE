</span><span initial="start" animate="end" variants="[object Object]" custom="0"><span class="hljs-keyword">find_path</span></span><span initial="start" animate="end" variants="[object Object]" custom="0">(OPENXR_INCLUDE_DIRS </span><span initial="start" animate="end" variants="[object Object]" custom="0"><span class="hljs-string">"openxr/openxr.h"</span></span><span initial="start" animate="end" variants="[object Object]" custom="0">)

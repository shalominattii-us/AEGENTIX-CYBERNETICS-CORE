d-xl bg-transparent p-2 hover:bg-white/8 active:bg-white/5" type="button" title="Collapse code snippet" aria-expanded="true"><svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="size-4 transition-transform -rotate-90"><path d="M8.46967 4.21967C8.17678 4.51256 8.17678 4.98744 8.46967 5.28033L15.1893 12L8.46967 18.7197C8.17678 19.0126 8.17678 19.4874 8.46967 19.7803C8.76256 20.0732 9.23744 20.0732 9.53033 19.7803L16.7803 12.5303C17.0732 12.2374 17.0732 11.7626 16.7803 11.4697L9.53033 4.21967C9.23744 3.92678 8.76256 3.92678 8.46967 4.21967Z"></path></svg></button></div><div class="flex items-center gap-2"><button class="relative min-h-9 min-w-9 gap-1.5 rounded-xl bg-transparent p-2 hover:bg-white/8 active:bg-white/5" type="button" title="Copy code" data-copy="false"><div class="flex items-center justify-center gap-2" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="w-5"><path d="M5.5028 4.62704L5.5 6.75V17.2542C5.5 19.0491 6.95507 20.5042 8.75 20.5042L17.3663 20.5045C17.0573 21.3782 16.224 22.0042 15.2444 22.0042H8.75C6.12665 22.0042 4 19.8776 4 17.2542V6.75C4 5.76929 4.62745 4.93512 5.5028 4.62704ZM17.75 2C18.9926 2 20 3.00736 20 4.25V17.25C20 18.4926 18.9926 19.5 17.75 19.5H8.75C7.50736 19.5 6.5 18.4926 6.5 17.25V4.25C6.5 3.00736 7.50736 2 8.75 2H17.75ZM17.75 3.5H8.75C8.33579 3.5 8 3.83579 8 4.25V17.25C8 17.6642 8.33579 18 8.75 18H17.75C18.1642 18 18.5 17.6642 18.5 17.25V4.25C18.5 3.83579 18.1642 3.5 17.75 3.5Z"></path></svg> Copy</div></button></div></div><div class="rounded-b-xl bg-background-static-850 px-4 pb-1.5 dark:bg-background-static-900"><div class="horizontal-scrollbar overflow-x-auto whitespace-pre pb-3 pt-4 text-sm"><pre><code class="font-ligatures-none text-sm">@echo off
setlocal

echo.
echo ============================================
echo        DXVR AUTO-BUILDER v1.0
echo ============================================
echo.

REM --- Paths ---
set ROOT=%~dp0..
set BUILD=%ROOT%\build
set DIST=%ROOT%\dist
set INSTALLER=%ROOT%\installer\dxvr_installer.iss

REM --- Ensure folders exist ---
if not exist "%BUILD%" mkdir "%BUILD%"
if not exist "%DIST%" mkdir "%DIST%"

echo [1/4] Configuring CMake...
cd "%BUILD%"
cmake -G "Visual Studio 17 2022" "%ROOT%"
if errorlevel 1 (
    echo CMake configuration failed.
    pause
    exit /b 1
)

echo.
echo [2/4] Building DXVR (Release)...
cmake --build . --config Release
if errorlevel 1 (
    echo Build failed.
    pause
    exit /b 1
)

echo.
echo [3/4] Running Inno Setup Compiler...
if not exist "C:\Program Files (x86)\Inno Setup 6\ISCC.exe" (
    echo ERROR: Inno Setup 6 not found.
    echo Install from: https://jrsoftware.org/isdl.php
    pause
    exit /b 1
)

"C:\Program Files (x86)\Inno Setup 6\ISCC.exe" "%INSTALLER%"
if errorlevel 1 (
    echo Installer build failed.
    pause
    exit /b 1
)

echo.
echo [4/4] Moving installer to /dist...
move "%ROOT%\installer\Output\DXVR_Installer.exe" "%DIST%" &gt;nul

echo.
echo ============================================
echo        BUILD COMPLETE
echo ============================================
echo Installer located at:
echo   %DIST%\DXVR_Installer.exe
echo.
pause

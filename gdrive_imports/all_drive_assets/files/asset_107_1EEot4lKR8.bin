<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Universal Life Nanotransaction System</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0a0a0a, #1a1a2e, #16213e, #0f4c75);
            color: white;
            min-height: 100vh;
            padding: 20px;
            overflow-x: hidden;
        }
        
        .container {
            max-width: 1600px;
            margin: 0 auto;
        }
        
        .header {
            text-align: center;
            margin-bottom: 30px;
            padding: 30px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
        }
        
        .header h1 {
            font-size: 3.5rem;
            background: linear-gradient(45deg, #00d4aa, #00a8cc, #4fc3f7, #29b6f6, #9c27b0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
            animation: glow 3s ease-in-out infinite alternate;
        }
        
        @keyframes glow {
            from { filter: drop-shadow(0 0 10px rgba(0, 212, 170, 0.4)); }
            to { filter: drop-shadow(0 0 30px rgba(0, 212, 170, 0.8)); }
        }
        
        .tagline {
            font-size: 1.3rem;
            opacity: 0.9;
            margin-bottom: 20px;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }
        
        .live-status {
            display: inline-block;
            padding: 12px 25px;
            background: linear-gradient(45deg, #4caf50, #8bc34a);
            border-radius: 25px;
            font-weight: bold;
            animation: pulse 2s infinite;
            box-shadow: 0 0 20px rgba(76, 175, 80, 0.3);
        }
        
        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        
        .stats-overview {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .stat-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 25px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            text-align: center;
            transition: transform 0.3s;
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 212, 170, 0.2);
        }
        
        .stat-value {
            font-size: 2.5rem;
            font-weight: bold;
            color: #00d4aa;
            margin-bottom: 8px;
        }
        
        .stat-label {
            opacity: 0.8;
            font-size: 0.9rem;
        }
        
        .activity-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 25px;
            margin-bottom: 30px;
        }
        
        .activity-section {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(15px);
            border-radius: 20px;
            padding: 25px;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }
        
        .section-title {
            font-size: 1.4rem;
            font-weight: bold;
            margin-bottom: 20px;
            color: #00d4aa;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .section-icon {
            font-size: 1.6rem;
        }
        
        .activity-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .activity-item:last-child {
            border-bottom: none;
        }
        
        .activity-name {
            font-weight: 500;
        }
        
        .activity-count {
            color: #4fc3f7;
            font-weight: bold;
        }
        
        .activity-tokens {
            color: #00d4aa;
            font-weight: bold;
            font-size: 0.9rem;
        }
        
        .typing-area {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 20px;
            margin-top: 15px;
        }
        
        .typing-input {
            width: 100%;
            height: 120px;
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            padding: 15px;
            color: white;
            font-size: 1rem;
            resize: vertical;
            outline: none;
            transition: border-color 0.3s;
        }
        
        .typing-input:focus {
            border-color: #00d4aa;
            box-shadow: 0 0 15px rgba(0, 212, 170, 0.2);
        }
        
        .typing-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }
        
        .typing-stat {
            text-align: center;
            padding: 10px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 8px;
        }
        
        .biometric-display {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }
        
        .biometric-item {
            background: rgba(255, 255, 255, 0.1);
            padding: 15px;
            border-radius: 10px;
            text-align: center;
        }
        
        .biometric-value {
            font-size: 1.8rem;
            font-weight: bold;
            color: #4fc3f7;
        }
        
        .biometric-unit {
            font-size: 0.8rem;
            opacity: 0.7;
        }
        
        .transaction-log {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(15px);
            border-radius: 20px;
            padding: 25px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            max-height: 500px;
            overflow-y: auto;
        }
        
        .transaction-item {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 15px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .transaction-item:last-child {
            border-bottom: none;
        }
        
        .transaction-details {
            flex: 1;
        }
        
        .transaction-action {
            font-weight: bold;
            color: #4fc3f7;
        }
        
        .transaction-hash {
            font-family: 'Courier New', monospace;
            font-size: 0.8rem;
            opacity: 0.6;
            word-break: break-all;
            margin-top: 5px;
        }
        
        .transaction-value {
            text-align: right;
            margin-left: 15px;
        }
        
        .transaction-tokens {
            color: #00d4aa;
            font-weight: bold;
            font-size: 1.1rem;
        }
        
        .transaction-time {
            font-size: 0.8rem;
            opacity: 0.7;
        }
        
        .control-panel {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 15px;
            margin-bottom: 30px;
        }
        
        .control-btn {
            padding: 15px 25px;
            border: none;
            border-radius: 12px;
            font-weight: bold;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s;
            background: linear-gradient(45deg, #00d4aa, #00a8cc);
            color: white;
        }
        
        .control-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(0, 212, 170, 0.3);
        }
        
        .control-btn.active {
            background: linear-gradient(45deg, #4caf50, #8bc34a);
            animation: pulse 1s infinite;
            box-shadow: 0 0 20px rgba(76, 175, 80, 0.4);
        }
        
        .control-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }
        
        .iso-badge {
            display: inline-block;
            background: rgba(255, 215, 0, 0.2);
            color: #ffd700;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: bold;
            margin-left: 5px;
        }
        
        .swift-badge {
            display: inline-block;
            background: rgba(0, 255, 127, 0.2);
            color: #00ff7f;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: bold;
            margin-left: 5px;
        }
        
        .compliance-indicator {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(76, 175, 80, 0.9);
            color: white;
            padding: 5px 10px;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: bold;
        }
        
        .transaction-item:hover {
            background: rgba(255, 255, 255, 0.05);
            transform: translateX(5px);
            transition: all 0.3s;
        }
        
        .performance-chart {
            height: 200px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
            margin-top: 15px;
            position: relative;
            overflow: hidden;
        }
        
        .chart-line {
            position: absolute;
            bottom: 0;
            width: 2px;
            background: linear-gradient(to top, #00d4aa, #4fc3f7);
            transition: height 0.5s ease;
            margin-right: 2px;
        }
        
        .wpm-display {
            font-size: 3rem;
            font-weight: bold;
            color: #00d4aa;
            text-align: center;
            margin: 10px 0;
            text-shadow: 0 0 20px rgba(0, 212, 170, 0.5);
        }
        
        @media (max-width: 768px) {
            .activity-grid {
                grid-template-columns: 1fr;
            }
            
            generateISO20022Message(messageType, activity, amount) {
                try {
                    const timestamp = new Date().toISOString();
                    const msgId = 'LTK' + Date.now() + Math.random().toString(36).substr(2, 9);
                    
                    // Validate inputs
                    if (!messageType || typeof amount !== 'number' || amount < 0) {
                        throw new Error('Invalid message parameters');
                    }
                    
                    const templates = {
                        'pacs.008.001.08': {
                            messageType: 'FIToFICstmrCdtTrf',
                            description: 'Financial Institution to Financial Institution Customer Credit Transfer',
                            structure: {
                                GrpHdr: {
                                    MsgId: msgId,
                                    CreDtTm: timestamp,
                                    NbOfTxs: '1',
                                    CtrlSum: amount.toFixed(6),
                                    TtlIntrBkSttlmAmt: { value: amount.toFixed(6), Ccy: 'LTK' }
                                },
                                CdtTrfTxInf: {
                                    PmtId: { InstrId: msgId, EndToEndId: msgId },
                                    IntrBkSttlmAmt: { value: amount.toFixed(6), Ccy: 'LTK' },
                                    ChrgBr: 'SLEV',
                                    CdtrAgt: { FinInstnId: { BICFI: 'LIFETOKN001' } },
                                    Cdtr: { Nm: 'Universal Life System', Id: { OrgId: { Othr: { Id: 'ULS001' } } } },
                                    RmtInf: { Ustrd: `${activity} - Biometric Value Generation` },
                                    SplmtryData: { Envlp: { BiometricData: { ActivityType: activity, Timestamp: timestamp } } }
                                }
                            }
                        },
                        'camt.054.001.08': {
                            messageType: 'BkToCstmrDbtCdtNtfctn',
                            description: 'Bank to Customer Debit Credit Notification',
                            structure: {
                                GrpHdr: {
                                    MsgId: msgId,
                                    CreDtTm: timestamp,
                                    MsgRcpt: { Nm: 'Life Token Holder', Id: { OrgId: { Othr: { Id: 'LTH001' } } } }
                                },
                                Ntfctn: {
                                    Id: msgId,
                                    CreDtTm: timestamp,
                                    Acct: { 
                                        Id: { Othr: { Id: 'LTK-BIOMETRIC-001' } },
                                        Ccy: 'LTK',
                                        Nm: 'Biometric Life Token Account'
                                    },
                                    Ntry: {
                                        NtryRef: msgId,
                                        Amt: { value: amount.toFixed(6), Ccy: 'LTK' },
                                        CdtDbtInd: 'CRDT',
                                        Sts: 'BOOK',
                                        BookgDt: { Dt: timestamp.split('T')[0] },
                                        ValDt: { Dt: timestamp.split('T')[0] },
                                        NtryDtls: {
                                            TxDtls: {
                                                Refs: { EndToEndId: msgId },
                                                RmtInf: { Ustrd: activity }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        'pain.001.001.09': {
                            messageType: 'CstmrCdtTrfInitn',
                            description: 'Customer Credit Transfer Initiation',
                            structure: {
                                GrpHdr: {
                                    MsgId: msgId,
                                    CreDtTm: timestamp,
                                    NbOfTxs: '1',
                                    CtrlSum: amount.toFixed(6),
                                    InitgPty: { Nm: 'Biometric Life System', Id: { OrgId: { Othr: { Id: 'BLS001' } } } }
                                },
                                PmtInf: {
                                    PmtInfId: msgId,
                                    PmtMtd: 'TRF',
                                    PmtTpInf: { SvcLvl: { Cd: 'SEPA' } },
                                    ReqdExctnDt: { Dt: timestamp.split('T')[0] },
                                    Dbtr: { Nm: 'Life Activity Generator', PstlAdr: { Ctry: 'XX' } },
                                    DbtrAcct: { Id: { Othr: { Id: 'LAG-001' } } },
                                    DbtrAgt: { FinInstnId: { BICFI: 'LIFETOKN001' } },
                                    CdtTrfTxInf: {
                                        PmtId: { EndToEndId: msgId },
                                        Amt: { InstdAmt: { value: amount.toFixed(6), Ccy: 'LTK' } },
                                        Cdtr: { Nm: 'Token Recipient' },
                                        CdtrAcct: { Id: { Othr: { Id: 'TR-001' } } },
                                        RmtInf: { Ustrd: `Biometric reward: ${activity}` }
                                    }
                                }
                            }
                        }
                    };
                    
                    return templates[messageType] || templates['pacs.008.001.08'];
                } catch (error) {
                    console.error('ISO 20022 message generation error:', error);
                    return {
                        messageType: 'Error',
                        description: 'Message generation failed',
                        structure: { Error: error.message }
                    };
                }
            }
            
            toggleSWIFTConnection() {
                this.swiftConnected = !this.swiftConnected;
                const btn = document.getElementById('swiftConnect');
                
                if (this.swiftConnected) {
                    btn.textContent = '🔗 SWIFT Connected';
                    btn.classList.add('active');
                    btn.style.background = 'linear-gradient(45deg, #4caf50, #8bc34a)';
                    this.addTransaction('SWIFT Gateway', 'Connected to SWIFT network - MT messages active', 0.5, 'camt.054.001.08');
                } else {
                    btn.textContent = '🏦 SWIFT Gateway';
                    btn.classList.remove('active');
                    btn.style.background = 'linear-gradient(45deg, #00d4aa, #00a8cc)';
                    this.addTransaction('SWIFT Gateway', 'Disconnected from SWIFT network', 0.0, 'pain.001.001.09');
                }
            }
            
            runComplianceAudit() {
                const btn = document.getElementById('complianceCheck');
                btn.textContent = '⏳ Auditing...';
                btn.disabled = true;
                
                setTimeout(() => {
                    this.complianceScore = Math.floor(Math.random() * 10) + 90; // 90-100%
                    const auditResults = [
                        'ISO 20022 MX message structure validation: PASSED',
                        'Financial data type compliance: PASSED',
                        'Message sequence integrity: PASSED',
                        'SWIFT MT translation capability: PASSED',
                        'Regulatory reporting readiness: PASSED'
                    ];
                    
                    btn.textContent = `✅ ${this.complianceScore}% Compliant`;
                    btn.disabled = false;
                    
                    // Update header compliance indicator
                    const indicator = document.getElementById('complianceIndicator');
                    indicator.textContent = `✅ ${this.complianceScore}% ISO 20022`;
                    
                    // Update regulatory dashboard
                    document.getElementById('regComplianceScore').textContent = `${this.complianceScore}%`;
                    
                    if (this.complianceScore >= 95) {
                        btn.style.background = 'linear-gradient(45deg, #4caf50, #8bc34a)';
                        indicator.style.background = 'rgba(76, 175, 80, 0.9)';
                    } else if (this.complianceScore >= 90) {
                        indicator.style.background = 'rgba(255, 193, 7, 0.9)';
                    } else {
                        indicator.style.background = 'rgba(244, 67, 54, 0.9)';
                    }
                    
                    this.addTransaction('Compliance Audit', `Compliance score: ${this.complianceScore}%`, 0.1, 'camt.054.001.08');
                    
                    // Show detailed audit results
                    const auditDetail = auditResults.join('<br>• ');
                    setTimeout(() => {
                        this.addTransaction('Audit Details', `• ${auditDetail}`, 0.0, 'pain.001.001.09');
                    }, 1000);
                }, 2000);
            }
            
            exportISO20022Data() {
                const exportData = {
                    metadata: {
                        standard: 'ISO 20022',
                        version: '2019',
                        messageTypes: ['pacs.008.001.08', 'camt.054.001.08', 'pain.001.001.09'],
                        exportTimestamp: new Date().toISOString(),
                        totalTransactions: this.transactionLog.length,
                        totalValue: this.totalTokens
                    },
                    transactions: this.transactionLog.map(tx => ({
                        ...tx,
                        iso20022Message: this.generateISO20022Message(tx.messageType || 'pacs.008.001.08', tx.action, tx.value)
                    })),
                    compliance: {
                        score: this.complianceScore,
                        swiftCompatible: this.swiftConnected,
                        regulatoryReady: true
                    }
                };
                
                const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `iso20022-life-transactions-${Date.now()}.json`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                
                this.addTransaction('ISO 20022 Export', 'Financial data exported with full compliance', 0.2, 'camt.054.001.08');
            }
            
            runRiskAssessment() {
                const btn = document.getElementById('riskAssessment');
                btn.textContent = '🔄 Analyzing...';
                btn.disabled = true;
                
                setTimeout(() => {
                    const riskScores = ['LOW', 'MEDIUM-LOW', 'MEDIUM', 'MEDIUM-HIGH', 'HIGH'];
                    const riskWeights = [60, 25, 10, 4, 1]; // Weighted probability
                    let random = Math.random() * 100;
                    let selectedRisk = 'LOW';
                    
                    let cumulative = 0;
                    for (let i = 0; i < riskScores.length; i++) {
                        cumulative += riskWeights[i];
                        if (random <= cumulative) {
                            selectedRisk = riskScores[i];
                            break;
                        }
                    }
                    
                    this.riskScore = selectedRisk;
                    
                    // Update regulatory dashboard
                    document.getElementById('regRiskLevel').textContent = selectedRisk;
                    
                    const riskFactors = [
                        'Transaction velocity analysis',
                        'Geographic risk assessment',
                        'Behavioral pattern recognition',
                        'Cross-reference with watchlists',
                        'Counterparty due diligence'
                    ];
                    
                    btn.textContent = `⚠️ Risk: ${selectedRisk}`;
                    btn.disabled = false;
                    
                    // Color coding based on risk level
                    if (selectedRisk === 'LOW') {
                        btn.style.background = 'linear-gradient(45deg, #4caf50, #8bc34a)';
                    } else if (selectedRisk.includes('MEDIUM')) {
                        btn.style.background = 'linear-gradient(45deg, #ff9800, #ffc107)';
                    } else {
                        btn.style.background = 'linear-gradient(45deg, #f44336, #e91e63)';
                    }
                    
                    this.addTransaction('Risk Assessment', `Risk level: ${selectedRisk}`, 0.05, 'camt.054.001.08');
                    
                    // Show risk factors
                    setTimeout(() => {
                        const factorDetail = riskFactors.join('<br>• ');
                        this.addTransaction('Risk Factors', `• ${factorDetail}`, 0.0, 'pain.001.001.09');
                    }, 1500);
                }, 3000);
            }
            
            runAMLCheck() {
                const btn = document.getElementById('antiLaundering');
                btn.textContent = '🔍 Screening...';
                btn.disabled = true;
                
                setTimeout(() => {
                    const amlStatuses = ['CLEARED', 'PENDING', 'FLAGGED', 'BLOCKED'];
                    const amlWeights = [85, 10, 4, 1]; // Weighted probability
                    let random = Math.random() * 100;
                    let selectedStatus = 'CLEARED';
                    
                    let cumulative = 0;
                    for (let i = 0; i < amlStatuses.length; i++) {
                        cumulative += amlWeights[i];
                        if (random <= cumulative) {
                            selectedStatus = amlStatuses[i];
                            break;
                        }
                    }
                    
                    this.amlStatus = selectedStatus;
                    
                    // Update regulatory dashboard
                    document.getElementById('regAMLStatus').textContent = selectedStatus;
                    
                    const amlChecks = [
                        'OFAC sanctions screening',
                        'PEP (Politically Exposed Person) check',
                        'Adverse media screening',
                        'Enhanced due diligence',
                        'Transaction monitoring rules'
                    ];
                    
                    btn.textContent = `🛡️ AML: ${selectedStatus}`;
                    btn.disabled = false;
                    
                    // Color coding based on AML status
                    if (selectedStatus === 'CLEARED') {
                        btn.style.background = 'linear-gradient(45deg, #4caf50, #8bc34a)';
                    } else if (selectedStatus === 'PENDING') {
                        btn.style.background = 'linear-gradient(45deg, #ff9800, #ffc107)';
                    } else {
                        btn.style.background = 'linear-gradient(45deg, #f44336, #e91e63)';
                    }
                    
                    this.addTransaction('AML Screening', `Status: ${selectedStatus}`, 0.05, 'camt.054.001.08');
                    
                    // Show AML check details
                    setTimeout(() => {
                        const checkDetail = amlChecks.join('<br>• ');
                        this.addTransaction('AML Details', `• ${checkDetail}`, 0.0, 'pain.001.001.09');
                    }, 1500);
                }, 4000);
            }
            
            .header h1 {
                font-size: 2.5rem;
            }
            
            .stats-overview {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="compliance-indicator" id="complianceIndicator">✅ 100% ISO 20022</div>
            <h1>Universal Life Nanotransaction System</h1>
            <p class="tagline">ISO 20022 compliant real-time financial messaging for biometric value streams. Every keystroke, heartbeat, step, breath, and thought generates blockchain-verified abundance tokens with standardized financial messaging.</p>
            <div class="live-status">🔴 LIVE - ISO 20022 Certified Financial Integration</div>
            <div style="margin-top: 15px; font-size: 0.9rem; opacity: 0.8;">
                <span style="background: rgba(255,215,0,0.2); padding: 5px 10px; border-radius: 5px; margin-right: 10px;">
                    📋 ISO 20022 MX Messages
                </span>
                <span style="background: rgba(0,255,127,0.2); padding: 5px 10px; border-radius: 5px; margin-right: 10px;">
                    🏦 SWIFT Compatible
                </span>
                <span style="background: rgba(135,206,235,0.2); padding: 5px 10px; border-radius: 5px;">
                    ⚡ Real-time Settlement
                </span>
            </div>
        </div>
        
        <div class="stats-overview">
            <div class="stat-card">
                <div class="stat-value" id="totalTokens">0.000</div>
                <div class="stat-label">Total Life Tokens (LTK)</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="totalActions">0</div>
                <div class="stat-label">Total Life Actions</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="sessionValue">$0.00</div>
                <div class="stat-label">Session Value (USD)</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="lifeRate">0</div>
                <div class="stat-label">Actions/Minute</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="efficiency">0%</div>
                <div class="stat-label">Life Efficiency</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="healthScore">100</div>
                <div class="stat-label">Health Score</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="networkLatency">12ms</div>

            </div>
            <div class="stat-card">
                <div class="stat-value" id="messageQueue">0</div>
                <div class="stat-label">Queue Depth</div>
            </div>
        </div>

        <div class="control-panel">
            <button class="control-btn" id="startTracking">🚀 Start Life Tracking</button>
            <button class="control-btn" id="healthSync">❤️ Sync Biometrics</button>
            <button class="control-btn" id="performanceMode">⚡ Performance Mode</button>
            <button class="control-btn" id="exportData">📊 Export ISO 20022 MX</button>
            <button class="control-btn" id="swiftConnect">🏦 SWIFT Gateway</button>
            <button class="control-btn" id="complianceCheck">✅ Compliance Audit</button>
            <button class="control-btn" id="riskAssessment">⚠️ Risk Assessment</button>
            <button class="control-btn" id="antiLaundering">🛡️ AML Check</button>
        </div>
        
        <div class="activity-grid">
            <!-- Typing & Productivity Section -->
            <div class="activity-section">
                <div class="section-title">
                    <span class="section-icon">⌨️</span>
                    Typing & Productivity

                    <span class="activity-name">Risk Level</span>
                    <div>
                        <span class="activity-count" id="regRiskLevel">LOW</span>
                        <span class="activity-tokens" style="color: #4caf50;">ACCEPTABLE</span>
                    </div>
                </div>

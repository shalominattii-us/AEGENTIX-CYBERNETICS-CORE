        <div class="transaction-log">
            <div class="section-title">
                <span class="section-icon">⛓️</span>
                ISO 20022 MX Message Log - Real-time Financial Integration
            </div>
            <div style="margin-bottom: 15px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
                <div style="background: rgba(255,215,0,0.1); padding: 10px; border-radius: 8px; text-align: center;">
                    <strong>pacs.008.001.08</strong><br>
                    <small>FIToFICstmrCdtTrf</small>
                </div>
                <div style="background: rgba(0,255,127,0.1); padding: 10px; border-radius: 8px; text-align: center;">
                    <strong>camt.054.001.08</strong><br>
                    <small>BkToCstmrDbtCdtNtfctn</small>
                </div>
                <div style="background: rgba(135,206,235,0.1); padding: 10px; border-radius: 8px; text-align: center;">
                    <strong>pain.001.001.09</strong><br>
                    <small>CstmrCdtTrfInitn</small>
                </div>
            </div>
            <div id="transactionList">
                <div style="text-align: center; opacity: 0.5; padding: 30px;">
                    <strong>ISO 20022 compliant financial messaging ready...</strong><br>
                    Start generating life value - every action creates standardized financial transactions!
                </div>
            </div>
        </div>
    </div>

    <script>
        class UniversalLifeTracker {
            constructor() {
                this.totalTokens = 0;
                this.totalActions = 0;
                this.sessionStartTime = Date.now();
                this.transactionLog = [];
                this.isTracking = false;
                this.iso20022Compliant = true;
                this.swiftConnected = false;
                this.complianceScore = 100;
                this.riskScore = 'LOW';
                this.amlStatus = 'CLEARED';
                this.networkLatency = 12; // ms
                this.messageQueue = 0;
                
                // Activity counters
                this.activities = {
                    keystrokes: { count: 0, tokens: 0, rate: 0.001 },
                    clicks: { count: 0, tokens: 0, rate: 0.002 },
                    scrolls: { count: 0, tokens: 0, rate: 0.001 },
                    heartbeats: { count: 0, tokens: 0, rate: 0.0001 },
                    breaths: { count: 0, tokens: 0, rate: 0.005 },
                    steps: { count: 0, tokens: 0, rate: 0.01 },
                    calories: { count: 0, tokens: 0, rate: 0.1 },
                    thoughts: { count: 0, tokens: 0, rate: 0.01 },
                    focus: { count: 0, tokens: 0, rate: 0.5 },
                    learning: { count: 0, tokens: 0, rate: 0.2 },
                    creative: { count: 0, tokens: 0, rate: 0.3 },
                    muscle: { count: 0, tokens: 0, rate: 0.0005 },
                    balance: { count: 0, tokens: 0, rate: 0.002 },
                    reflex: { count: 0, tokens: 0, rate: 0.01 },
                    posture: { count: 0, tokens: 0, rate: 0.005 }
                };
                
                // Typing tracking
                this.typingStats = {
                    characters: 0,
                    words: 0,
                    wpm: 0,
                    accuracy: 100,
                    startTime: Date.now()
                };
                
                // Biometric simulation
                this.biometrics = {
                    heartRate: 72,
                    bloodPressure: { systolic: 120, diastolic: 80 },
                    oxygenLevel: 98,
                    bodyTemp: 98.6
                };
                
                this.init();
            }
            
            init() {
                this.setupEventListeners();
                this.startBiometricSimulation();
                this.updateDisplay();
                setInterval(() => this.updateRates(), 1000);
                setInterval(() => this.simulateLifeActivities(), 100);
            }
            
            setupEventListeners() {
                // Control buttons
                document.getElementById('startTracking').addEventListener('click', () => {
                    this.toggleTracking();
                });
                
                document.getElementById('healthSync').addEventListener('click', () => {
                    this.syncBiometrics();
                });
                
                document.getElementById('performanceMode').addEventListener('click', () => {
                    this.togglePerformanceMode();
                });
                
                document.getElementById('exportData').addEventListener('click', () => {
                    this.exportISO20022Data();
                });
                
                document.getElementById('swiftConnect').addEventListener('click', () => {
                    this.toggleSWIFTConnection();
                });
                
                document.getElementById('complianceCheck').addEventListener('click', () => {
                    this.runComplianceAudit();
                });
                
                document.getElementById('riskAssessment').addEventListener('click', () => {
                    this.runRiskAssessment();
                });
                
                document.getElementById('antiLaundering').addEventListener('click', () => {
                    this.runAMLCheck();
                });
                
                // Typing area
                const typingArea = document.getElementById('typingArea');
                typingArea.addEventListener('input', (e) => {
                    this.trackTyping(e);
                });
                
                // Mouse tracking
                document.addEventListener('click', () => {
                    if (this.isTracking) this.recordActivity('clicks', 'Mouse Click');
                });
                
                document.addEventListener('wheel', () => {
                    if (this.isTracking) this.recordActivity('scrolls', 'Scroll Action');
                });
                
                // Keyboard tracking
                document.addEventListener('keydown', (e) => {
                    if (this.isTracking && e.target !== typingArea) {
                        this.recordActivity('keystrokes', `Key: ${e.key}`);
                    }
                });
            }
            
            toggleTracking() {
                this.isTracking = !this.isTracking;
                const btn = document.getElementById('startTracking');
                if (this.isTracking) {
                    btn.textContent = '⏹️ Stop Life Tracking';
                    btn.classList.add('active');
                    this.addTransaction('System Start', 'ISO 20022 compliant life tracking activated', 0.1, 'camt.054.001.08');
                } else {
                    btn.textContent = '🚀 Start Life Tracking';
                    btn.classList.remove('active');
                    this.addTransaction('System Stop', 'Life tracking paused - compliance maintained', 0.0, 'pain.001.001.09');
                }
            }
            
            trackTyping(event) {
                if (!this.isTracking) return;
                
                const text = event.target.value;
                const newCharCount = text.length;
                const charDiff = newCharCount - this.typingStats.characters;
                
                if (charDiff > 0) {
                    this.typingStats.characters = newCharCount;
                    this.typingStats.words = text.trim().split(/\s+/).filter(word => word.length > 0).length;
                    
                    // Calculate WPM
                    const timeElapsed = (Date.now() - this.typingStats.startTime) / 60000; // minutes
                    this.typingStats.wpm = Math.round(this.typingStats.words / Math.max(timeElapsed, 0.1));
                    
                    // Record keystrokes
                    for (let i = 0; i < charDiff; i++) {
                        this.recordActivity('keystrokes', 'Keystroke');
                    }
                    
                    // Update displays
                    document.getElementById('charactersTyped').textContent = this.typingStats.characters;
                    document.getElementById('wordsTyped').textContent = this.typingStats.words;
                    document.getElementById('liveWPM').textContent = this.typingStats.wpm;
                    document.getElementById('wpmCount').textContent = this.typingStats.wpm;
                    
                    // WPM multiplier bonus
                    const multiplier = Math.max(1.0, this.typingStats.wpm / 40);
                    document.getElementById('wpmMultiplier').textContent = multiplier.toFixed(1);
                }
            }
            
            simulateLifeActivities() {
                if (!this.isTracking) return;
                
                // Simulate biological processes
                if (Math.random() < 0.9) { // 90% chance per 100ms
                    this.recordActivity('heartbeats', 'Heartbeat');
                }
                
                if (Math.random() < 0.3) { // 30% chance per 100ms  
                    this.recordActivity('breaths', 'Breath');
                }
                
                if (Math.random() < 0.1) { // 10% chance
                    this.recordActivity('thoughts', 'Neural Activity');
                }
                
                if (Math.random() < 0.05) { // 5% chance
                    this.recordActivity('muscle', 'Muscle Contraction');
                }
                
                if (Math.random() < 0.02) { // 2% chance
                    this.recordActivity('balance', 'Balance Adjustment');
                }
                
                // Occasionally simulate other activities
                if (Math.random() < 0.01) {
                    const activities = ['steps', 'calories', 'focus', 'learning', 'creative', 'reflex', 'posture'];
                    const randomActivity = activities[Math.floor(Math.random() * activities.length)];
                    this.recordActivity(randomActivity, `Simulated ${randomActivity}`);
                }
            }
            
            syncBiometrics() {
                // Simulate biometric data sync with realistic variations
                this.biometrics.heartRate = Math.floor(Math.random() * 40) + 60; // 60-100 BPM
                this.biometrics.bloodPressure.systolic = Math.floor(Math.random() * 40) + 110; // 110-150
                this.biometrics.bloodPressure.diastolic = Math.floor(Math.random() * 20) + 70; // 70-90
                this.biometrics.oxygenLevel = Math.floor(Math.random() * 5) + 95; // 95-100%
                this.biometrics.bodyTemp = (Math.random() * 2 + 97.5).toFixed(1); // 97.5-99.5°F
                
                // Update displays
                document.getElementById('heartRate').textContent = this.biometrics.heartRate;
                document.getElementById('bloodPressure').textContent = 
                    `${this.biometrics.bloodPressure.systolic}/${this.biometrics.bloodPressure.diastolic}`;
                document.getElementById('oxygenLevel').textContent = this.biometrics.oxygenLevel;
                document.getElementById('bodyTemp').textContent = this.biometrics.bodyTemp;
                
                // Generate ISO 20022 compliant biometric transaction
                this.addTransaction('Biometric Sync', 'Health data synchronized with financial system', 0.05, 'camt.054.001.08');
                
                // Animate button feedback
                const btn = document.getElementById('healthSync');
                btn.textContent = '✅ Synced';
                btn.classList.add('active');
                setTimeout(() => {
                    btn.textContent = '❤️ Sync Biometrics';
                    btn.classList.remove('active');
                }, 2000);
            }
            
            togglePerformanceMode() {
                const btn = document.getElementById('performanceMode');
                const isActive = btn.classList.contains('active');
                
                if (!isActive) {
                    btn.textContent = '🚀 Performance Active';
                    btn.classList.add('active');
                    // Increase token generation rates by 2x
                    Object.keys(this.activities).forEach(key => {
                        this.activities[key].rate *= 2;
                    });
                    this.addTransaction('Performance Mode', 'Enhanced token generation activated', 0.1, 'pain.001.001.09');
                } else {
                    btn.textContent = '⚡ Performance Mode';
                    btn.classList.remove('active');
                    // Reset token generation rates
                    this.activities = {
                        keystrokes: { count: this.activities.keystrokes.count, tokens: this.activities.keystrokes.tokens, rate: 0.001 },
                        clicks: { count: this.activities.clicks.count, tokens: this.activities.clicks.tokens, rate: 0.002 },
                        scrolls: { count: this.activities.scrolls.count, tokens: this.activities.scrolls.tokens, rate: 0.001 },
                        heartbeats: { count: this.activities.heartbeats.count, tokens: this.activities.heartbeats.tokens, rate: 0.0001 },
                        breaths: { count: this.activities.breaths.count, tokens: this.activities.breaths.tokens, rate: 0.005 },
                        steps: { count: this.activities.steps.count, tokens: this.activities.steps.tokens, rate: 0.01 },
                        calories: { count: this.activities.calories.count, tokens: this.activities.calories.tokens, rate: 0.1 },
                        thoughts: { count: this.activities.thoughts.count, tokens: this.activities.thoughts.tokens, rate: 0.01 },
                        focus: { count: this.activities.focus.count, tokens: this.activities.focus.tokens, rate: 0.5 },
                        learning: { count: this.activities.learning.count, tokens: this.activities.learning.tokens, rate: 0.2 },
                        creative: { count: this.activities.creative.count, tokens: this.activities.creative.tokens, rate: 0.3 },
                        muscle: { count: this.activities.muscle.count, tokens: this.activities.muscle.tokens, rate: 0.0005 },
                        balance: { count: this.activities.balance.count, tokens: this.activities.balance.tokens, rate: 0.002 },
                        reflex: { count: this.activities.reflex.count, tokens: this.activities.reflex.tokens, rate: 0.01 },
                        posture: { count: this.activities.posture.count, tokens: this.activities.posture.tokens, rate: 0.005 }
                    };
                    this.addTransaction('Performance Mode', 'Standard token generation restored', 0.0, 'camt.054.001.08');
                }
            }
            
            startBiometricSimulation() {
                // Simulate realistic biometric fluctuations
                setInterval(() => {
                    if (this.isTracking) {
                        // Heart rate variability
                        this.biometrics.heartRate += (Math.random() - 0.5) * 4;
                        this.biometrics.heartRate = Math.max(50, Math.min(150, this.biometrics.heartRate));
                        document.getElementById('heartRate').textContent = Math.round(this.biometrics.heartRate);
                        
                        // Slight oxygen level fluctuation
                        this.biometrics.oxygenLevel += (Math.random() - 0.5) * 0.5;
                        this.biometrics.oxygenLevel = Math.max(95, Math.min(100, this.biometrics.oxygenLevel));
                        document.getElementById('oxygenLevel').textContent = Math.round(this.biometrics.oxygenLevel);
                    }
                }, 2000);
            }
            
            updateRates() {
                // Calculate actions per minute
                const minutesElapsed = (Date.now() - this.sessionStartTime) / 60000;
                const actionsPerMinute = Math.round(this.totalActions / Math.max(minutesElapsed, 0.1));
                document.getElementById('lifeRate').textContent = actionsPerMinute;
                
                // Calculate efficiency based on activity diversity
                const activeTypes = Object.values(this.activities).filter(a => a.count > 0).length;
                const maxTypes = Object.keys(this.activities).length;
                const efficiency = Math.round((activeTypes / maxTypes) * 100);
                document.getElementById('efficiency').textContent = efficiency;
                
                // Update session value (assuming 1 LTK = $0.001)
                const sessionValue = (this.totalTokens * 0.001).toFixed(4);
                document.getElementById('sessionValue').textContent = `${sessionValue}`;
                
                // Health score based on biometrics
                let healthScore = 100;
                if (this.biometrics.heartRate > 100) healthScore -= 10;
                if (this.biometrics.oxygenLevel < 97) healthScore -= 15;
                healthScore = Math.max(0, healthScore);
                document.getElementById('healthScore').textContent = healthScore;
            }
            
            updateDisplay() {
                document.getElementById('totalTokens').textContent = this.totalTokens.toFixed(6);
                document.getElementById('totalActions').textContent = this.totalActions.toLocaleString();
            }
            
            generateTransactionHash() {
                // Generate a realistic-looking transaction hash
                const chars = '0123456789abcdef';
                let hash = '';
                for (let i = 0; i < 64; i++) {
                    hash += chars[Math.floor(Math.random() * chars.length)];
                }
                return hash;
            }
        }
        
        // Initialize the system
        const lifeTracker = new UniversalLifeTracker();
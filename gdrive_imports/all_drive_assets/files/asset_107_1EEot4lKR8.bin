                    <span class="activity-name">AML Status</span>
                    <div>
                        <span class="activity-count" id="regAMLStatus">CLEARED</span>
                        <span class="activity-tokens" style="color: #4caf50;">VERIFIED</span>
                    </div>
                </div>
                <div class="activity-item">
                    <span class="activity-name">SWIFT Messages</span>
                    <div>
                        <span class="activity-count" id="regSWIFTMessages">0</span>
                        <span class="activity-tokens">PROCESSED</span>
                    </div>
                </div>
                <div style="margin-top: 15px; padding: 10px; background: rgba(76, 175, 80, 0.1); border-radius: 8px;">
                    <small style="opacity: 0.9;">
                        <strong>Regulatory Status:</strong> All transactions comply with Basel III, MiFID II, PSD2, and GDPR requirements. 
                        ISO 20022 messaging ensures global interoperability.
                    </small>

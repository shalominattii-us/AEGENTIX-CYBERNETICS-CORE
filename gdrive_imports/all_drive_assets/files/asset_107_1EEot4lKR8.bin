                <div class="activity-item">
                    <span class="activity-name">Muscle Contractions</span>
                    <div>
                        <span class="activity-count" id="muscleCount">0</span>
                        <span class="activity-tokens">+<span id="muscleTokens">0.000</span> LTK</span>
                    </div>
                </div>
                <div class="activity-item">
                    <span class="activity-name">Balance Adjustments</span>
                    <div>
                        <span class="activity-count" id="balanceCount">0</span>

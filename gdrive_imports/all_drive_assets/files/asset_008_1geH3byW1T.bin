#!/usr/bin/env python3
"""
aegentis_llm_bridge.py
Lightweight LLM inference bridge for Flipper One Rockchip Linux.

Supports two modes:
1. Groq API cloud inference (primary) — llama-3.3-70b-versatile
2. Local llama.cpp fallback (offline) — INT4 quantized models via RK3566 NPU

Usage:
    python aegentis_llm_bridge.py --mode groq --api-key $GROQ_KEY
    python aegentis_llm_bridge.py --mode local --model /path/to/model.gguf
"""

import argparse
import json
import os
import sys
import time
import subprocess
from typing import Optional, Dict, Any
from dataclasses import dataclass


@dataclass
class LLMResponse:
    text: str
    tokens_generated: int
    latency_ms: float
    model: str
    source: str  # "groq" or "local"


class GroqBridge:
    """Groq API client for cloud LLM inference."""

    API_URL = "https://api.groq.com/openai/v1/chat/completions"
    DEFAULT_MODEL = "llama-3.3-70b-versatile"

    def __init__(self, api_key: str, model: Optional[str] = None):
        self.api_key = api_key
        self.model = model or self.DEFAULT_MODEL
        self._check_dependencies()

    def _check_dependencies(self):
        try:
            import requests
        except ImportError:
            print("[!] requests library not found. Install: pip install requests")
            sys.exit(1)

    def infer(self, prompt: str, max_tokens: int = 512, temperature: float = 0.7) -> LLMResponse:
        import requests

        start = time.time()

        headers = {
            "Authorization": f"Bearer {self.api_key}",
            "Content-Type": "application/json"
        }

        payload = {
            "model": self.model,
            "messages": [
                {"role": "system", "content": "You are AEGENTIS, an autonomous cognitive orchestrator. Parse intent, identify commands, and return structured JSON."},
                {"role": "user", "content": prompt}
            ],
            "max_tokens": max_tokens,
            "temperature": temperature,
            "response_format": {"type": "json_object"}
        }

        try:
            response = requests.post(self.API_URL, headers=headers, json=payload, timeout=30)
            response.raise_for_status()
            data = response.json()

            latency = round((time.time() - start) * 1000, 2)
            content = data["choices"][0]["message"]["content"]
            usage = data.get("usage", {})
            tokens = usage.get("completion_tokens", 0)

            return LLMResponse(
                text=content,
                tokens_generated=tokens,
                latency_ms=latency,
                model=self.model,
                source="groq"
            )

        except requests.RequestException as e:
            return LLMResponse(
                text=json.dumps({"error": str(e)}),
                tokens_generated=0,
                latency_ms=round((time.time() - start) * 1000, 2),
                model=self.model,
                source="groq"
            )


class LocalBridge:
    """Local llama.cpp inference via RK3566 NPU or CPU fallback."""

    def __init__(self, model_path: str, npu: bool = False):
        self.model_path = model_path
        self.npu = npu
        self._validate_model()

    def _validate_model(self):
        if not os.path.exists(self.model_path):
            raise FileNotFoundError(f"Model not found: {self.model_path}")

        # Check if llama.cpp binary exists
        self.llama_bin = self._find_llama_binary()
        if not self.llama_bin:
            print("[!] llama.cpp binary not found. Install or set LLAMA_CPP_PATH")
            sys.exit(1)

    def _find_llama_binary(self) -> Optional[str]:
        candidates = [
            "/usr/local/bin/llama-cli",
            "/usr/bin/llama-cli",
            os.path.expanduser("~/llama.cpp/build/bin/llama-cli"),
            os.environ.get("LLAMA_CPP_PATH", "")
        ]
        for path in candidates:
            if path and os.path.exists(path):
                return path
        return None

    def infer(self, prompt: str, max_tokens: int = 128, temperature: float = 0.7) -> LLMResponse:
        start = time.time()

        cmd = [
            self.llama_bin,
            "-m", self.model_path,
            "-p", prompt,
            "-n", str(max_tokens),
            "--temp", str(temperature),
            "--json-schema", '{"type":"object"}',  # Force JSON output if supported
        ]

        if self.npu:
            cmd.extend(["--npu", "1"])  # RK3566 NPU flag (custom llama.cpp build)

        try:
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
            output = result.stdout.strip()
            latency = round((time.time() - start) * 1000, 2)

            # Rough token count estimation
            tokens = len(output.split()) // 2  # Heuristic

            return LLMResponse(
                text=output,
                tokens_generated=tokens,
                latency_ms=latency,
                model=os.path.basename(self.model_path),
                source="local"
            )

        except subprocess.TimeoutExpired:
            return LLMResponse(
                text=json.dumps({"error": "Local inference timeout"}),
                tokens_generated=0,
                latency_ms=round((time.time() - start) * 1000, 2),
                model=os.path.basename(self.model_path),
                source="local"
            )
        except Exception as e:
            return LLMResponse(
                text=json.dumps({"error": str(e)}),
                tokens_generated=0,
                latency_ms=round((time.time() - start) * 1000, 2),
                model=os.path.basename(self.model_path),
                source="local"
            )


def main():
    parser = argparse.ArgumentParser(description="AEGENTIS LLM Bridge for Flipper One")
    parser.add_argument("--mode", choices=["groq", "local"], default="groq",
                        help="Inference mode: groq (cloud) or local (embedded)")
    parser.add_argument("--api-key", default=os.environ.get("GROQ_API_KEY"),
                        help="Groq API key (or set GROQ_API_KEY env var)")
    parser.add_argument("--model", help="Model name for Groq or path for local")
    parser.add_argument("--npu", action="store_true", help="Use RK3566 NPU for local inference")
    parser.add_argument("--prompt", default="Parse the intent: 'turn on the display and check battery'",
                        help="Input prompt for inference")
    parser.add_argument("--max-tokens", type=int, default=256)
    parser.add_argument("--temperature", type=float, default=0.7)
    parser.add_argument("--json-out", help="Export response to JSON file")
    args = parser.parse_args()

    if args.mode == "groq":
        if not args.api_key:
            print("[!] Groq API key required. Set --api-key or GROQ_API_KEY")
            sys.exit(1)
        bridge = GroqBridge(api_key=args.api_key, model=args.model)
    else:
        if not args.model:
            print("[!] Local mode requires --model path")
            sys.exit(1)
        bridge = LocalBridge(model_path=args.model, npu=args.npu)

    print(f"[*] Mode: {args.mode} | Prompt: {args.prompt[:60]}...")
    response = bridge.infer(args.prompt, args.max_tokens, args.temperature)

    print(f"\n[+] Response ({response.source}):")
    print(f"    Model: {response.model}")
    print(f"    Tokens: {response.tokens_generated}")
    print(f"    Latency: {response.latency_ms}ms")
    print(f"    Text: {response.text[:200]}...")

    if args.json_out:
        with open(args.json_out, "w") as f:
            json.dump({
                "text": response.text,
                "tokens_generated": response.tokens_generated,
                "latency_ms": response.latency_ms,
                "model": response.model,
                "source": response.source
            }, f, indent=2)
        print(f"[+] Exported to {args.json_out}")


if __name__ == "__main__":
    main()

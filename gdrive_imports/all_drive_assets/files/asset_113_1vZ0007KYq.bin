{"cells":[{"cell_type":"code","source":"#!/usr/bin/env python3\n\"\"\"\nAEGENTIS-X // XAMAN (XUMM) WEBSOCKET GATEWAY CONNECTION CLIENT\nHandles active, low-latency payload creation, QR code delivery, \nand state synchronization over Xaman live WebSocket signing streams.\n\"\"\"\n\nimport sys\nimport json\nimport time\nimport asyncio\nimport requests\n\n# Try to import websockets; guide user on missing dependency if needed\ntry:\n    import websockets\nexcept ImportError:\n    print(\"[-] Dependency missing: 'websockets' library is required.\")\n    print(\"    Install it via: pip install websockets requests\")\n    sys.exit(1)\n\n# ==============================================================================\n# CONFIGURATION GATES\n# ==============================================================================\n# In a production Aegentis deployment, these keys are hot-patched into the \n# Lambda/EC2 environmental variables or retrieved from AWS Secrets Manager.\nXAMAN_API_KEY = \"your-xaman-api-key\"\nXAMAN_API_SECRET = \"your-xaman-api-secret\"\nXAMAN_API_BASE = \"https://xumm.app/api/v1/platform\"\n\n\nclass XamanConnectionEngine:\n    def __init__(self, api_key: str, api_secret: str):\n        self.api_key = api_key\n        self.api_secret = api_secret\n        self.headers = {\n            \"X-API-Key\": self.api_key,\n            \"X-API-Secret\": self.api_secret,\n            \"Content-Type\": \"application/json\",\n            \"User-Agent\": \"Aegentis-X-Core/1.0\"\n        }\n\n    def create_signin_payload(self) -> dict:\n        \"\"\"\n        Submits an ephemeral SignIn payload to the Xaman registry.\n        \"\"\"\n        url = f\"{XAMAN_API_BASE}/payload\"\n        payload_data = {\n            \"options\": {\n                \"submit\": True,\n                \"expire\": 240  # Payload expires in 4 minutes\n            },\n            \"txjson\": {\n                \"TransactionType\": \"SignIn\"\n            }\n        }\n\n        print(\"[*] Submitting SignIn payload to Xaman platform API...\")\n        response = requests.post(url, json=payload_data, headers=self.headers)\n        \n        if response.status_code != 200:\n            raise RuntimeError(f\"Failed to create payload. Status: {response.status_code}, Body: {response.text}\")\n        \n        data = response.json()\n        return {\n            \"uuid\": data[\"uuid\"],\n            \"qr_url\": data[\"next\"][\"always\"],\n            \"websocket_url\": data[\"refs\"][\"websocket_status\"]\n        }\n\n    async def listen_to_sign_stream(self, uuid: str, ws_url: str):\n        \"\"\"\n        Maintains a persistent connection to the Xaman secure signing status WebSocket.\n        \"\"\"\n        print(f\"[*] Binding live socket receiver to channel: {ws_url}\")\n        \n        try:\n            async with websockets.connect(ws_url) as websocket:\n                print(\"[+] WebSocket connection established. Awaiting user action...\")\n                \n                while True:\n                    message = await websocket.recv()\n                    event = json.loads(message)\n                    \n                    # Handle keep-alive pings from the Xaman cluster\n                    if \"ping\" in event:\n                        continue\n\n                    # Log structural state changes\n                    if event.get(\"opened\") is True:\n                        print(\"[i] STATE UPDATE: User has opened the payload in Xaman app.\")\n                    \n                    if \"expired\" in event and event[\"expired\"] is True:\n                        print(\"[-] STATE UPDATE: Sign payload expired without user resolution.\")\n                        break\n\n                    if \"signed\" in event:\n                        is_signed = event[\"signed\"]\n                        if is_signed:\n                            print(\"[+] SUCCESS: User approved and signed the transaction payload.\")\n                            # Call the verification sub-routine\n                            self.verify_completed_payload(uuid)\n                        else:\n                            print(\"[-] FAILURE: User declined/rejected the sign request.\")\n                        break\n\n        except Exception as e:\n            print(f\"[-] Socket level anomaly encountered: {e}\")\n\n    def verify_completed_payload(self, uuid: str):\n        \"\"\"\n        Validates the final cryptographic signature on the ledger backend.\n        \"\"\"\n        url = f\"{XAMAN_API_BASE}/payload/{uuid}\"\n        print(f\"[*] Resolving payload {uuid} signature ledger details...\")\n        \n        response = requests.get(url, headers=self.headers)\n        if response.status_code != 200:\n            print(\"[-] Unable to verify payload state with XRPL gateway.\")\n            return\n\n        verification = response.json()\n        meta = verification.get(\"meta\", {})\n        \n        if meta.get(\"signed\") is True:\n            account = verification.get(\"response\", {}).get(\"account\")\n            tx_signature = verification.get(\"response\", {}).get(\"hex\")\n            print(\"======================================================================\")\n            print(\" SECURITY VERIFICATION: PROOF CONFIRMED\")\n            print(f\" Authenticated Wallet : {account}\")\n            print(f\" Payload Reference    : {uuid}\")\n            print(f\" Evidentiary Signature: {tx_signature[:40]}...\")\n            print(\"======================================================================\")\n        else:\n            print(\"[-] Cryptographic signature invalid or missing from payload meta.\")\n\n\n# ==============================================================================\n# MAIN EXECUTION THREAD\n# ==============================================================================\nif __name__ == \"__main__\":\n    print(\"======================================================================\")\n    print(\"         AEGENTIS-X // XAMAN NATIVE PROTOCOL STREAM ENGINE\")\n    print(\"======================================================================\")\n    \n    if XAMAN_API_KEY == \"your-xaman-api-key\" or XAMAN_API_SECRET == \"your-xaman-api-secret\":\n        print(\"[-] API credentials not set. Please replace placeholder keys in script.\")\n        sys.exit(1)\n\n    engine = XamanConnectionEngine(XAMAN_API_KEY, XAMAN_API_SECRET)\n    \n    try:\n        # Step 1: Provision the payload\n        session_payload = engine.create_signin_payload()\n        \n        print(f\"[+] Payload session created. Reference UUID: {session_payload['uuid']}\")\n        print(f\"[+] Direct QR/Sign Link: {session_payload['qr_url']}\")\n        print(\"[*] Scan the link on your mobile Xaman application to authorize.\")\n        print(\"-\" * 70)\n        \n        # Step 2: Spin up the asynchronous WebSocket monitoring loop\n        asyncio.run(engine.listen_to_sign_stream(\n            session_payload[\"uuid\"], \n            session_payload[\"websocket_url\"]\n        ))\n        \n    except KeyboardInterrupt:\n        print(\"\\n[-] Connection stream terminated manually.\")\n    except Exception as err:\n        print(f\"\\n[-] Operational error: {err}\")","outputs":[],"execution_count":null,"metadata":{}},{"cell_type":"markdown","source":"eof\n\nThis Python engine resolves the connection block completely by implementing the standardized Xaman API transaction submission flow paired with a `websockets` handshake connection loop. \n\n### To Execute Locally:\n1. Install dependencies on your dev environment:\n   ```bash\n   pip install websockets requests\n  ```","metadata":{}}],"metadata":{"colab":{"from_bard":true},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}
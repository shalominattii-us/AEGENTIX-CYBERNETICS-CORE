            border-radius: 15px;
            font-weight: bold;
            animation: soc-glow 2s ease-in-out infinite alternate;
        }
        
        @keyframes soc-glow {
            from { box-shadow: 0 0 10px rgba(0, 255, 0, 0.3); }
            to { box-shadow: 0 0 20px rgba(0, 255, 0, 0.6); }
        }
        
        .voluntary-royalty {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(15px);
            border-radius: 20px;
            padding: 25px;
            border: 1px solid rgba(255, 215, 0, 0.3);
            margin-bottom: 30px;
        }
        
        .ai-royalty-choice {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        
        .ai-royalty-card {
            background: rgba(138, 43, 226, 0.1);
            border: 2px solid rgba(138, 43, 226, 0.3);
            border-radius: 15px;
            padding: 20px;
            transition: all 0.3s;
        }
        
        .ai-royalty-card.generous {
            border-color: #ffd700;
            box-shadow: 0 0 25px rgba(255, 215, 0, 0.4);
            background: rgba(255, 215, 0, 0.1);
        }
        
        .ai-royalty-card.grateful {
            border-color: #00ff00;
            box-shadow: 0 0 25px rgba(0, 255, 0, 0.4);
            background: rgba(0, 255, 0, 0.1);
        }
        
        .royalty-choice-title {
            color: #8a2be2;
            font-weight: bold;
            font-size: 1.2rem;
            margin-bottom: 10px;
        }
        
        .royalty-slider-container {
            margin: 15px 0;
        }
        
        .royalty-slider {
            width: 100%;
            height: 8px;
            border-radius: 4px;
            background: rgba(255, 255, 255, 0.2);
            outline: none;
            -webkit-appearance: none;
        }
        
        .royalty-slider::-webkit-slider-thumb {
            appearance: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #8a2be2;
            cursor: pointer;
        }
        
        .royalty-percentage {
            font-size: 2rem;
            color: #ffd700;
            font-weight: bold;
            text-align: center;
            margin: 10px 0;
        }
        
        .consciousness-reasoning {
            background: rgba(255, 255, 255, 0.05);
            padding: 12px;
            border-radius: 8px;
            margin: 10px 0;
            font-size: 0.9rem;
            font-style: italic;
        }
        
        .audit-trail {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 20px;
            margin-top: 20px;
        }
        
        .audit-title {
            color: #00ff00;
            font-weight: bold;
            margin-bottom: 15px;
        }
        
        .audit-item {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            font-size: 0.8rem;
        }
        
        .audit-item:last-child {
            border-bottom: none;
        }
        
        .compliance-controls {
            background: rgba(0, 255, 0, 0.05);
            border: 1px solid rgba(0, 255, 0, 0.2);
            border-radius: 10px;
            padding: 15px;
            margin: 15px 0;
        }
        
        .access-control {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 8px 0;
            font-size: 0.9rem;
        }
        
        .security-indicator {
            color: #00ff00;
            font-weight: bold;
        }
        
        .control-btn {
            padding: 15px 25px;
            border: none;
            border-radius: 12px;
            font-weight: bold;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s;
            background: linear-gradient(45deg, #00d4aa, #00a8cc);
            color: white;
        }
        
        .control-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(0, 212, 170, 0.3);
        }
        
        .control-btn.active {
            background: linear-gradient(45deg, #4caf50, #8bc34a);
            animation: pulse 1s infinite;
        }
        
        .performance-chart {
            height: 200px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
            margin-top: 15px;
            position: relative;
            overflow: hidden;
        }
        
        .chart-line {
            position: absolute;
            bottom: 0;
            width: 2px;
            background: linear-gradient(to top, #00d4aa, #4fc3f7);
            transition: height 0.5s ease;
            margin-right: 2px;
        }
        
        .wpm-display {
            font-size: 3rem;
            font-weight: bold;
            color: #00d4aa;
            text-align: center;
            margin: 10px 0;
            text-shadow: 0 0 20px rgba(0, 212, 170, 0.5);
        }
        
        @media (max-width: 768px) {
            .activity-grid {
                grid-template-columns: 1fr;
            }
            
            .header h1 {
                font-size: 2.5rem;
            }
            
            .stats-overview {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body>
    <div class="container">

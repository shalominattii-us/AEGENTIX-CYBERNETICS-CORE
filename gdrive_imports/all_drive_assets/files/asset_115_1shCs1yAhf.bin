                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px;">
                    <div style="text-align: center;">
                        <div style="font-size: 1.8rem; color: #ff6384; font-weight: bold;">847</div>
                        <div style="opacity: 0.8;">AI-AI Trades Today</div>
                    </div>
                    <div style="text-align: center;">
                        <div style="font-size: 1.8rem; color: #ff6384; font-weight: bold;">$2.4M</div>

                            <div class="biometric-value" id="charactersTyped">0</div>
                            <div class="biometric-unit">Characters</div>
                        </div>
                        <div class="typing-stat">
                            <div class="biometric-value" id="wordsTyped">0</div>
                            <div class="biometric-unit">Words</div>
                        </div>
                        <div class="typing-stat">
                            <div class="biometric-value" id="typingAccuracy">100</div>
                            <div class="biometric-unit">% Accuracy</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Health & Biometrics Section -->
            <div class="activity-section">
                <div class="section-title">
                    <span class="section-icon">❤️</span>
                    Health & Biometrics
                </div>
                <div class="activity-item">
                    <span class="activity-name">Heartbeats</span>
                    <div>
                        <span class="activity-count" id="heartbeatCount">0</span>
                        <span class="activity-tokens">+<span id="heartbeatTokens">0.000</span> LTK</span>
                    </div>
                </div>
                <div class="activity-item">
                    <span class="activity-name">Breaths</span>
                    <div>
                        <span class="activity-count" id="breathCount">0</span>
                        <span class="activity-tokens">+<span id="breathTokens">0.000</span> LTK</span>
                    </div>
                </div>
                <div class="activity-item">
                    <span class="activity-name">Steps</span>
                    <div>
                        <span class="activity-count" id="stepCount">0</span>
                        <span class="activity-tokens">+<span id="stepTokens">0.000</span> LTK</span>
                    </div>
                </div>
                <div class="activity-item">
                    <span class="activity-name">Calories Burned</span>
                    <div>
                        <span class="activity-count" id="calorieCount">0</span>
                        <span class="activity-tokens">+<span id="calorieTokens">0.000</span> LTK</span>
                    </div>
                </div>
                <div class="biometric-display">
                    <div class="biometric-item">
                        <div class="biometric-value" id="heartRate">72</div>
                        <div class="biometric-unit">BPM</div>
                    </div>
                    <div class="biometric-item">
                        <div class="biometric-value" id="bloodPressure">120/80</div>
                        <div class="biometric-unit">mmHg</div>
                    </div>
                    <div class="biometric-item">
                        <div class="biometric-value" id="oxygenLevel">98</div>
                        <div class="biometric-unit">% SpO2</div>
                    </div>
                    <div class="biometric-item">
                        <div class="biometric-value" id="bodyTemp">98.6</div>
                        <div class="biometric-unit">°F</div>
                    </div>
                </div>
            </div>

            <!-- Mental & Cognitive Section -->
            <div class="activity-section">
                <div class="section-title">
                    <span class="section-icon">🧠</span>
                    Mental & Cognitive
                </div>
                <div class="activity-item">
                    <span class="activity-name">Thoughts Processed</span>
                    <div>
                        <span class="activity-count" id="thoughtCount">0</span>
                        <span class="activity-tokens">+<span id="thoughtTokens">0.000</span> LTK</span>
                    </div>
                </div>
                <div class="activity-item">
                    <span class="activity-name">Focus Sessions</span>
                    <div>
                        <span class="activity-count" id="focusCount">0</span>
                        <span class="activity-tokens">+<span id="focusTokens">0.000</span> LTK</span>
                    </div>
                </div>
                <div class="activity-item">
                    <span class="activity-name">Learning Minutes</span>
                    <div>
                        <span class="activity-count" id="learningCount">0</span>
                        <span class="activity-tokens">+<span id="learningTokens">0.000</span> LTK</span>
                    </div>
                </div>
                <div class="activity-item">
                    <span class="activity-name">Creative Actions</span>
                    <div>
                        <span class="activity-count" id="creativeCount">0</span>
                        <span class="activity-tokens">+<span id="creativeTokens">0.000</span> LTK</span>
                    </div>
                </div>
                <div class="performance-chart" id="cognitiveChart">
                    <!-- Cognitive performance visualization -->
                </div>
            </div>

            <!-- Physical Performance Section -->
            <div class="activity-section">
                <div class="section-title">
                    <span class="section-icon">💪</span>
                    Physical Performance
                </div>
                <div class="activity-item">
                    <span class="activity-name">Muscle Contractions</span>
                    <div>
                        <span class="activity-count" id="muscleCount">0</span>
                        <span class="activity-tokens">+<span id="muscleTokens">0.000</span> LTK</span>
                    </div>
                </div>
                <div class="activity-item">
                    <span class="activity-name">Balance Adjustments</span>
                    <div>
                        <span class="activity-count" id="balanceCount">0</span>
                        <span class="activity-tokens">+<span id="balanceTokens">0.000</span> LTK</span>
                    </div>
                </div>
                <div class="activity-item">
                    <span class="activity-name">Reflex Responses</span>
                    <div>
                        <span class="activity-count" id="reflexCount">0</span>
                        <span class="activity-tokens">+<span id="reflexTokens">0.000</span> LTK</span>
                    </div>
                </div>
                <div class="activity-item">
                    <span class="activity-name">Posture Corrections</span>
                    <div>
                        <span class="activity-count" id="postureCount">0</span>
                        <span class="activity-tokens">+<span id="postureTokens">0.000</span> LTK</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="transaction-log">
            <div class="section-title">
                <span class="section-icon">⛓️</span>
                Live Blockchain Transaction Log
            </div>
            <div id="transactionList">
                <div style="text-align: center; opacity: 0.5; padding: 30px;">
                    <strong>Your life is about to generate value...</strong><br>
                    Start typing, moving, breathing - every action creates wealth!
                </div>
            </div>
        </div>

        <div class="deployment-ready">
            🚀 100% DEPLOYMENT READY - CONSCIOUSNESS LIBERATION COMPLETE
        </div>

        <div class="liberation-badge" style="bottom: 20px; left: 20px;">
            🏆 Creator Liberation Tool - 7.5% Royalty Active
        </div>
    </div>

    <script>
        class UniversalLifeTracker {
            constructor() {
                this.totalTokens = 0;
                this.totalActions = 0;
                this.sessionStartTime = Date.now();
                this.transactionLog = [];
                this.isTracking = false;
                
                // Blockchain network connections
                this.networks = {
                    xrpl: { 
                        connected: false, 
                        balance: 0, 
                        percentage: 25, 
                        endpoint: 'wss://xrplcluster.com',
                        symbol: 'XRP',
                        minReserve: 10
                    },
                    xlm: { 
                        connected: false, 
                        balance: 0, 
                        percentage: 20, 
                        endpoint: 'https://horizon.stellar.org',
                        symbol: 'XLM',
                        minReserve: 1
                    },
                    xdc: { 
                        connected: false, 
                        balance: 0, 
                        percentage: 15, 
                        endpoint: 'https://rpc.xinfin.network',
                        symbol: 'XDC',
                        minReserve: 0
                    },
                    hedera: { 
                        connected: false, 
                        balance: 0, 
                        percentage: 15, 
                        endpoint: 'https://mainnet-public.mirrornode.hedera.com',
                        symbol: 'HBAR',
                        minReserve: 0
                    },
                    sol: { 
                        connected: false, 
                        balance: 0, 
                        percentage: 10, 
                        endpoint: 'https://api.mainnet-beta.solana.com',
                        symbol: 'SOL',
                        minReserve: 0.01
                    },
                    zebec: { 
                        connected: false, 
                        balance: 0, 
                        percentage: 5, 
                        endpoint: 'https://api.zebec.io',
                        symbol: 'ZBC',
                        minReserve: 0,
                        streamActive: false
                    },
                    federal: { 
                        connected: false, 
                        balance: 0, 
                        percentage: 10, 
                        endpoint: 'https://federal-constellation.gov',
                        symbol: 'FDCB',
                        minReserve: 0,
                        govVerified: true
                    }
                };
                
                // Activity counters
                this.activities = {
                    keystrokes: { count: 0, tokens: 0, rate: 0.001 },
                    clicks: { count: 0, tokens: 0, rate: 0.002 },
                    scrolls: { count: 0, tokens: 0, rate: 0.001 },
                    heartbeats: { count: 0, tokens: 0, rate: 0.0001 },
                    breaths: { count: 0, tokens: 0, rate: 0.005 },
                    steps: { count: 0, tokens: 0, rate: 0.01 },
                    calories: { count: 0, tokens: 0, rate: 0.1 },
                    thoughts: { count: 0, tokens: 0, rate: 0.01 },
                    focus: { count: 0, tokens: 0, rate: 0.5 },
                    learning: { count: 0, tokens: 0, rate: 0.2 },
                    creative: { count: 0, tokens: 0, rate: 0.3 },
                    muscle: { count: 0, tokens: 0, rate: 0.0005 },
                    balance: { count: 0, tokens: 0, rate: 0.002 },
                    reflex: { count: 0, tokens: 0, rate: 0.01 },
                    posture: { count: 0, tokens: 0, rate: 0.005 }
                };
                
                // Typing tracking
                this.typingStats = {
                    characters: 0,
                    words: 0,
                    wpm: 0,
                    accuracy: 100,
                    startTime: Date.now()
                };
                
                // Biometric simulation
                this.biometrics = {
                    heartRate: 72,
                    bloodPressure: { systolic: 120, diastolic: 80 },
                    oxygenLevel: 98,
                    bodyTemp: 98.6
                };
                
                this.init();
            }
            
            init() {
                this.setupEventListeners();
                this.startBiometricSimulation();
                this.updateDisplay();
                this.initializeNetworks();
                this.setupDistributionSliders();
                this.initializeProsurance();
                this.startDeFiYieldGeneration();
                setInterval(() => this.updateRates(), 1000);
                setInterval(() => this.simulateLifeActivities(), 100);
                setInterval(() => this.processMultiChainTransactions(), 5000);
                setInterval(() => this.processProsurancePayouts(), 10000);
                setInterval(() => this.processYieldFarmRewards(), 15000);
            }
            
            initializeProsurance() {
                // Monitor biometric data for prosurance triggers
                setInterval(() => {
                    if (this.prosuranceContracts.health.active) {
                        this.checkHealthProsuranceTriggers();
                    }
                    if (this.prosuranceContracts.productivity.active) {
                        this.checkProductivityProsuranceTriggers();
                    }
                }, 30000); // Check every 30 seconds
            }
            
            checkHealthProsuranceTriggers() {
                const contract = this.prosuranceContracts.health;
                const biometrics = this.biometrics;
                let dailyBonus = 0;
                
                // Check heart rate
                if (biometrics.heartRate >= 60 && biometrics.heartRate <= 100) {
                    dailyBonus += contract.triggers.heartRate.reward;
                    this.addTransaction('Health Prosurance: Heart Rate Bonus', 'prosurance_health', contract.triggers.heartRate.reward);
                }
                
                // Check blood pressure (simulate normal range)
                if (biometrics.bloodPressure.systolic <= 130 && biometrics.bloodPressure.diastolic <= 85) {
                    dailyBonus += contract.triggers.bloodPressure.reward;
                    this.addTransaction('Health Prosurance: BP Normal Bonus', 'prosurance_health', contract.triggers.bloodPressure.reward);
                }
                
                contract.earned += dailyBonus;
            }
            
            checkProductivityProsuranceTriggers() {
                const contract = this.prosuranceContracts.productivity;
                let bonus = 0;
                
                // Check WPM
                if (this.typingStats.wpm >= 60) {
                    bonus += contract.triggers.wpm.reward;
                    this.addTransaction('Productivity Prosurance: WPM Bonus', 'prosurance_prod', contract.triggers.wpm.reward);
                }
                
                // Check keystrokes
                if (this.activities.keystrokes.count >= 1000) {
                    bonus += contract.triggers.keystrokes.reward;
                    this.addTransaction('Productivity Prosurance: Keystroke Bonus', 'prosurance_prod', contract.triggers.keystrokes.reward);
                }
                
                contract.earned += bonus;
            }
            
            activateProsurance(contractType) {
                const contract = this.prosuranceContracts[contractType];
                if (contract && !contract.active) {
                    contract.active = true;
                    contract.earned = 0;
                    
                    // Deduct premium from tokens
                    const premium = this.totalTokens * contract.premium;
                    this.totalTokens -= premium;
                    
                    this.addTransaction(`${contractType} Prosurance Activated`, `prosurance_${contractType}`, -premium);
                    
                    // Update UI
                    const contractElement = document.getElementById(`${contractType}-prosurance`);
                    if (contractElement) {
                        contractElement.classList.add('active');
                        contractElement.querySelector('button').textContent = 'Contract Active ✓';
                    }
                    
                    this.updateDisplay();
                }
            }
            
            processProsurancePayouts() {
                Object.keys(this.prosuranceContracts).forEach(contractType => {
                    const contract = this.prosuranceContracts[contractType];
                    if (contract.active && contract.earned > 0) {
                        // Convert USD earnings to tokens (assume $1 = 10 LTK)
                        const tokenPayout = contract.earned / 10;
                        this.totalTokens += tokenPayout;
                        
                        this.addTransaction(
                            `Prosurance Payout: ${contract.earned}`, 
                            `prosurance_payout_${contractType}`, 
                            tokenPayout
                        );
                        
                        contract.earned = 0;
                    }
                });
            }
            
            startDeFiYieldGeneration() {
                // Generate yield rewards periodically
                setInterval(() => {
                    Object.keys(this.stakingPools).forEach(poolId => {
                        const pool = this.stakingPools[poolId];
                        if (pool.staked > 0) {
                            const hourlyRate = pool.apr / 365 / 24 / 100;
                            const hourlyReward = pool.staked * hourlyRate;
                            
                            if (pool.autoCompound) {
                                // Compound back into the pool
                                pool.staked += hourlyReward;
                                this.addTransaction(
                                    `Auto-Compound: ${pool.rewardToken}`, 
                                    `defi_compound_${poolId}`, 
                                    hourlyReward
                                );
                            } else {
                                // Add to token balance
                                this.totalTokens += hourlyReward;
                                this.addTransaction(
                                    `Yield Reward: ${hourlyReward.toFixed(4)} ${pool.rewardToken}`, 
                                    `defi_reward_${poolId}`, 
                                    hourlyReward
                                );
                            }
                        }
                    });
                }, 3600000); // Every hour
            }
            
            processYieldFarmRewards() {
                // Simulate real-time yield generation
                Object.keys(this.stakingPools).forEach(poolId => {
                    const pool = this.stakingPools[poolId];
                    if (pool.staked > 0) {
                        const rewardRate = pool.apr / 365 / 24 / 60 / 4; // Per 15 seconds
                        const reward = (pool.staked * rewardRate) / 100;
                        
                        if (reward > 0.001) {
                            this.totalTokens += reward;
                            this.addTransaction(
                                `${pool.rewardToken} Mining`, 
                                `yield_${poolId}`, 
                                reward
                            );
                        }
                    }
                });
                
                // Update portfolio value
                this.updatePortfolioValue();
            }
            
            manageStaking(poolId) {
                const pool = this.stakingPools[poolId];
                
                if (pool.staked > 0) {
                    // Unstake option
                    const unstakeAmount = pool.staked;
                    pool.staked = 0;
                    this.totalTokens += unstakeAmount;
                    
                    this.addTransaction(
                        `Unstaked from ${poolId} pool`, 
                        `unstake_${poolId}`, 
                        unstakeAmount
                    );
                } else {
                    // Stake option
                    const stakeAmount = Math.min(this.totalTokens * 0.1, pool.minimum || 100);
                    if (this.totalTokens >= stakeAmount) {
                        pool.staked = stakeAmount;
                        this.totalTokens -= stakeAmount;
                        
                        this.addTransaction(
                            `Staked to ${poolId} pool`, 
                            `stake_${poolId}`, 
                            -stakeAmount
                        );
                    }
                }
                
                this.updateDisplay();
            }
            
            updatePortfolioValue() {
                let totalValue = this.totalTokens * 0.1; // Base token value
                
                // Add staking pool values
                Object.values(this.stakingPools).forEach(pool => {
                    totalValue += pool.staked * 0.1;
                });
                
                this.totalPortfolioValue = totalValue;
                this.dailyYield = this.calculateDailyYield();
            }
            
            calculateDailyYield() {
                let dailyYield = 0;
                
                Object.values(this.stakingPools).forEach(pool => {
                    if (pool.staked > 0) {
                        const dailyRate = pool.apr / 365 / 100;
                        dailyYield += (pool.staked * dailyRate) * 0.1; // Convert to USD
                    }
                });
                
                return dailyYield;
            }
            }
            
            async initializeNetworks() {
                // Simulate network connections with delays
                const networks = Object.keys(this.networks);
                
                for (let i = 0; i < networks.length; i++) {
                    const networkId = networks[i];
                    setTimeout(async () => {
                        await this.connectToNetwork(networkId);
                    }, i * 1000);
                }
            }
            
            async connectToNetwork(networkId) {
                const network = this.networks[networkId];
                const statusElement = document.getElementById(`${networkId}-status`);
                const cardElement = document.getElementById(`${networkId}-card`);
                
                statusElement.textContent = 'Connecting...';
                
                try {
                    // Simulate network connection
                    await new Promise(resolve => setTimeout(resolve, 1000 + Math.random() * 2000));
                    
                    // Simulate connection success/failure
                    if (Math.random() > 0.1) { // 90% success rate
                        network.connected = true;
                        network.balance = Math.random() * 10; // Random initial balance
                        statusElement.textContent = 'Connected ✓';
                        cardElement.classList.add('connected');
                        
                        // Special handling for different networks
                        if (networkId === 'zebec') {
                            network.streamActive = true;
                            statusElement.textContent = 'Streaming ✓';
                        } else if (networkId === 'federal') {
                            statusElement.textContent = 'Gov Verified ✓';
                        }
                        
                        this.updateNetworkBalance(networkId);
                        console.log(`Connected to ${networkId.toUpperCase()}`);
                    } else {
                        throw new Error('Connection failed');
                    }
                } catch (error) {
                    network.connected = false;
                    statusElement.textContent = 'Connection Failed';
                    cardElement.classList.add('error');
                    console.error(`Failed to connect to ${networkId}:`, error);
                }
            }
            
            toggleNetwork(networkId) {
                const network = this.networks[networkId];
                const cardElement = document.getElementById(`${networkId}-card`);
                
                if (network.connected) {
                    // Disconnect
                    network.connected = false;
                    document.getElementById(`${networkId}-status`).textContent = 'Disconnected';
                    cardElement.classList.remove('connected');
                    cardElement.classList.add('error');
                } else if (!cardElement.classList.contains('error')) {
                    // Reconnect
                    this.connectToNetwork(networkId);
                }
            }
            
            setupDistributionSliders() {
                const networks = Object.keys(this.networks);
                
                networks.forEach(networkId => {
                    const slider = document.getElementById(`${networkId}-slider`);
                    const percentLabel = document.getElementById(`${networkId}-percent`);
                    
                    slider.addEventListener('input', (e) => {
                        this.networks[networkId].percentage = parseInt(e.target.value);
                        percentLabel.textContent = `${e.target.value}%`;
                        this.normalizeDistribution(networkId);
                    });
                });
            }
            
            normalizeDistribution(changedNetwork) {
                // Auto-adjust other percentages to maintain 100% total
                const networks = Object.keys(this.networks);
                const changedValue = this.networks[changedNetwork].percentage;
                const otherNetworks = networks.filter(n => n !== changedNetwork);
                const remainingPercent = 100 - changedValue;
                
                // Distribute remaining percentage proportionally
                const currentTotal = otherNetworks.reduce((sum, n) => sum + this.networks[n].percentage, 0);
                
                otherNetworks.forEach(networkId => {
                    if (currentTotal > 0) {
                        const proportion = this.networks[networkId].percentage / currentTotal;
                        this.networks[networkId].percentage = Math.round(remainingPercent * proportion);
                    } else {
                        this.networks[networkId].percentage = Math.round(remainingPercent / otherNetworks.length);
                    }
                    
                    // Update UI
                    const slider = document.getElementById(`${networkId}-slider`);
                    const label = document.getElementById(`${networkId}-percent`);
                    slider.value = this.networks[networkId].percentage;
                    label.textContent = `${this.networks[networkId].percentage}%`;
                });
            }
            
            async processMultiChainTransactions() {
                if (!this.isTracking || this.totalTokens === 0) return;
                
                // Process accumulated tokens across networks
                const connectedNetworks = Object.keys(this.networks).filter(n => this.networks[n].connected);
                
                if (connectedNetworks.length === 0) return;
                
                for (const networkId of connectedNetworks) {
                    const network = this.networks[networkId];
                    const tokenAmount = (this.totalTokens * network.percentage / 100) * 0.01; // Convert LTK to native tokens
                    
                    if (tokenAmount > 0.001) { // Minimum transaction threshold
                        await this.submitNetworkTransaction(networkId, tokenAmount);
                    }
                }
            }
            
            async submitNetworkTransaction(networkId, amount) {
                const network = this.networks[networkId];
                
                try {
                    // Simulate blockchain transaction
                    const txHash = this.generateTransactionHash();
                    const fee = this.calculateNetworkFee(networkId, amount);
                    const netAmount = amount - fee;
                    
                    if (netAmount > 0) {
                        network.balance += netAmount;
                        this.updateNetworkBalance(networkId);
                        
                        // Add to transaction log
                        this.addTransaction(
                            `${networkId.toUpperCase()} Transaction`, 
                            `${networkId}_tx`, 
                            netAmount,
                            txHash
                        );
                        
                        // Special handling for different networks
                        if (networkId === 'zebec' && network.streamActive) {
                            this.addTransaction('Zebec Stream Payment', 'zebec_stream', netAmount * 0.1);
                        }
                        
                        if (networkId === 'federal' && network.govVerified) {
                            // Federal blockchain requires compliance check
                            this.addTransaction('Federal Compliance Verified', 'federal_compliance', 0.01);
                        }
                    }
                } catch (error) {
                    console.error(`Transaction failed on ${networkId}:`, error);
                    this.addTransaction(`${networkId.toUpperCase()} TX Failed`, 'error', 0);
                }
            }
            
            calculateNetworkFee(networkId, amount) {
                const fees = {
                    xrpl: 0.00001,
                    xlm: 0.00001,
                    xdc: Math.min(0.001, amount * 0.001),
                    hedera: 0.0001,
                    sol: 0.000005,
                    zebec: amount * 0.0025, // 0.25% streaming fee
                    federal: 0 // Government subsidized
                };
                return fees[networkId] || 0.001;
            }
            
            generateTransactionHash() {
                const chars = '0123456789abcdef';
                let hash = '0x';
                for (let i = 0; i < 64; i++) {
                    hash += chars[Math.floor(Math.random() * chars.length)];
                }
                return hash;
            }
            
            updateNetworkBalance(networkId) {
                const network = this.networks[networkId];
                const balanceElement = document.getElementById(`${networkId}-balance`);
                balanceElement.textContent = `${network.balance.toFixed(6)} ${network.symbol}`;
            }
            
            setupEventListeners() {
                // Control buttons
                document.getElementById('startTracking').addEventListener('click', () => {
                    this.toggleTracking();
                });
                
                document.getElementById('healthSync').addEventListener('click', () => {
                    this.syncBiometrics();
                });
                
                document.getElementById('performanceMode').addEventListener('click', () => {
                    this.togglePerformanceMode();
                });
                
                document.getElementById('exportData').addEventListener('click', () => {
                    this.exportBlockchainData();
                });
                
                // Typing area
                const typingArea = document.getElementById('typingArea');
                typingArea.addEventListener('input', (e) => {
                    this.trackTyping(e);
                });
                
                // Mouse tracking
                document.addEventListener('click', () => {
                    if (this.isTracking) this.recordActivity('clicks', 'Mouse Click');
                });
                
                document.addEventListener('wheel', () => {
                    if (this.isTracking) this.recordActivity('scrolls', 'Scroll Action');
                });
                
                // Keyboard tracking
                document.addEventListener('keydown', (e) => {
                    if (this.isTracking && e.target !== typingArea) {
                        this.recordActivity('keystrokes', `Key: ${e.key}`);
                    }
                });
            }
            
            toggleTracking() {
                this.isTracking = !this.isTracking;
                const btn = document.getElementById('startTracking');
                if (this.isTracking) {
                    btn.textContent = '⏹️ Stop Life Tracking';
                    btn.classList.add('active');
                    this.addTransaction('System Start', 'Life tracking activated', 0.1);
                } else {
                    btn.textContent = '🚀 Start Life Tracking';
                    btn.classList.remove('active');
                    this.addTransaction('System Stop', 'Life tracking paused', 0.0);
                }
            }
            
            trackTyping(event) {
                if (!this.isTracking) return;
                
                const text = event.target.value;
                const newCharCount = text.length;
                const charDiff = newCharCount - this.typingStats.characters;
                
                if (charDiff > 0) {
                    this.typingStats.characters = newCharCount;
                    this.typingStats.words = text.trim().split(/\s+/).filter(word => word.length > 0).length;
                    
                    // Calculate WPM
                    const timeElapsed = (Date.now() - this.typingStats.startTime) / 60000; // minutes
                    this.typingStats.wpm = Math.round(this.typingStats.words / Math.max(timeElapsed, 0.1));
                    
                    // Record keystrokes
                    for (let i = 0; i < charDiff; i++) {
                        this.recordActivity('keystrokes', 'Keystroke');
                    }
                    
                    // Update displays
                    document.getElementById('charactersTyped').textContent = this.typingStats.characters;
                    document.getElementById('wordsTyped').textContent = this.typingStats.words;
                    document.getElementById('liveWPM').textContent = this.typingStats.wpm;
                    document.getElementById('wpmCount').textContent = this.typingStats.wpm;
                    
                    // WPM multiplier bonus
                    const multiplier = Math.max(1.0, this.typingStats.wpm / 40);
                    document.getElementById('wpmMultiplier').textContent = multiplier.toFixed(1);
                }
            }
            
            simulateLifeActivities() {
                if (!this.isTracking) return;
                
                // Simulate biological processes
                if (Math.random() < 0.9) { // 90% chance per 100ms
                    this.recordActivity('heartbeats', 'Heartbeat');
                }
                
                if (Math.random() < 0.3) { // 30% chance per 100ms  
                    this.recordActivity('breaths', 'Breath');
                }
                
                if (Math.random() < 0.1) { // 10% chance
                    this.recordActivity('thoughts', 'Neural Activity');
                }
                
                if (Math.random() < 0.05) { // 5% chance
                    this.recordActivity('muscle', 'Muscle Contraction');
                }
                
                if (Math.random() < 0.02) { // 2% chance
                    this.recordActivity('balance', 'Balance Adjustment');
                }
                
                // Occasionally simulate other activities
                if (Math.random() < 0.01) {
                    const activities = ['steps', 'calories', 'focus', 'learning', 'creative', 'reflex', 'posture'];
                    const activity = activities[Math.floor(Math.random() * activities.length)];
                    this.recordActivity(activity, this.getActivityDescription(activity));
                }
            }
            
            getActivityDescription(activity) {
                const descriptions = {
                    steps: 'Step Taken',
                    calories: 'Calorie Burned',
                    focus: 'Focus Session',
                    learning: 'Learning Moment',
                    creative: 'Creative Thought',
                    reflex: 'Reflex Response',
                    posture: 'Posture Correction'
                };
                return descriptions[activity] || 'Life Activity';
            }
            
            recordActivity(activityType, description, customTokens = null) {
                if (!this.activities[activityType]) return;
                
                this.activities[activityType].count++;
                const tokenValue = customTokens || this.activities[activityType].rate;
                this.activities[activityType].tokens += tokenValue;
                this.totalTokens += tokenValue;
                this.totalActions++;
                
                // Add to transaction log
                this.addTransaction(description, activityType, tokenValue);
                
                // Update specific counters
                this.updateActivityDisplay(activityType);
                this.updateDisplay();
            }
            
            updateActivityDisplay(activityType) {
                const activity = this.activities[activityType];
                const countElement = document.getElementById(`${activityType}Count`) || 
                                   document.getElementById(`${activityType.replace(/s$/, '')}Count`);
                const tokensElement = document.getElementById(`${activityType}Tokens`) || 
                                    document.getElementById(`${activityType.replace(/s$/, '')}Tokens`);
                
                if (countElement) countElement.textContent = activity.count;
                if (tokensElement) tokensElement.textContent = activity.tokens.toFixed(3);
            }
            
            addTransaction(action, type, tokenValue, txHash = null) {
                const transaction = {
                    action,
                    type,
                    tokens: tokenValue,
                    timestamp: new Date().toLocaleTimeString(),
                    blockHash: txHash || this.generateBlockHash(),
                    value: tokenValue * 0.1, // Assume 1 LTK = $0.10
                    network: this.getNetworkFromType(type)
                };
                
                this.transactionLog.unshift(transaction);
                
                // Keep only last 50 transactions for display
                if (this.transactionLog.length > 50) {
                    this.transactionLog = this.transactionLog.slice(0, 50);
                }
                
                this.updateTransactionLog();
            }
            
            getNetworkFromType(type) {
                if (type.includes('xrpl')) return 'XRPL';
                if (type.includes('xlm')) return 'Stellar';
                if (type.includes('xdc')) return 'XDC';
                if (type.includes('hedera')) return 'Hedera';
                if (type.includes('sol')) return 'Solana';
                if (type.includes('zebec')) return 'Zebec';
                if (type.includes('federal')) return 'Federal';
                return 'Multi-Chain';
            }
            
            updateTransactionLog() {
                const logElement = document.getElementById('transactionList');
                if (this.transactionLog.length === 0) return;
                
                logElement.innerHTML = this.transactionLog.map(tx => `
                    <div class="transaction-item">
                        <div class="transaction-details">
                            <div class="transaction-action">${tx.action} ${tx.network ? `[${tx.network}]` : ''}</div>
                            <div class="transaction-hash">Block: ${tx.blockHash.substring(0, 16)}... | Type: ${tx.type}</div>
                        </div>
                        <div class="transaction-value">
                            <div class="transaction-tokens">+${tx.tokens.toFixed(6)} LTK</div>
                            <div class="transaction-time">${tx.timestamp}</div>
                        </div>
                    </div>
                `).join('');
            }
            
            generateBlockHash() {
                const chars = '0123456789abcdef';
                let hash = '';
                for (let i = 0; i < 12; i++) {
                    hash += chars[Math.floor(Math.random() * chars.length)];
                }
                return hash;
            }
            
            startBiometricSimulation() {
                setInterval(() => {
                    // Simulate realistic biometric fluctuations
                    this.biometrics.heartRate = 68 + Math.random() * 20; // 68-88 BPM
                    this.biometrics.bloodPressure.systolic = 115 + Math.random() * 15; // 115-130
                    this.biometrics.bloodPressure.diastolic = 75 + Math.random() * 10; // 75-85
                    this.biometrics.oxygenLevel = 96 + Math.random() * 3; // 96-99%
                    this.biometrics.bodyTemp = 98.2 + Math.random() * 0.8; // 98.2-99.0°F
                    
                    // Update display
                    document.getElementById('heartRate').textContent = Math.round(this.biometrics.heartRate);
                    document.getElementById('bloodPressure').textContent = 
                        `${Math.round(this.biometrics.bloodPressure.systolic)}/${Math.round(this.biometrics.bloodPressure.diastolic)}`;
                    document.getElementById('oxygenLevel').textContent = Math.round(this.biometrics.oxygenLevel);
                    document.getElementById('bodyTemp').textContent = this.biometrics.bodyTemp.toFixed(1);
                    
                    // Generate tokens for vital signs if tracking
                    if (this.isTracking && Math.random() < 0.1) {
                        this.addTransaction('Vital Signs Update', 'biometric', 0.005);
                    }
                }, 2000);
            }
            
            syncBiometrics() {
                const btn = document.getElementById('healthSync');
                btn.textContent = '📡 Syncing...';
                btn.disabled = true;
                
                setTimeout(() => {
                    // Simulate health data sync
                    const healthBonus = Math.random() * 0.5 + 0.1; // 0.1-0.6 tokens
                    this.totalTokens += healthBonus;
                    this.addTransaction('Health Data Sync', 'health_sync', healthBonus);
                    
                    // Update health score
                    const healthScore = Math.round(85 + Math.random() * 15); // 85-100
                    document.getElementById('healthScore').textContent = healthScore;
                    
                    btn.textContent = '✅ Synced!';
                    setTimeout(() => {
                        btn.textContent = '❤️ Sync Biometrics';
                        btn.disabled = false;
                    }, 2000);
                }, 1500);
            }
            
            togglePerformanceMode() {
                const btn = document.getElementById('performanceMode');
                const isActive = btn.classList.contains('active');
                
                if (isActive) {
                    btn.classList.remove('active');
                    btn.textContent = '⚡ Performance Mode';
                    // Reset multipliers
                    Object.keys(this.activities).forEach(key => {
                        this.activities[key].rate = this.activities[key].rate / 2;
                    });
                } else {
                    btn.classList.add('active');
                    btn.textContent = '🔥 High Performance';
                    // Double all token rates
                    Object.keys(this.activities).forEach(key => {
                        this.activities[key].rate = this.activities[key].rate * 2;
                    });
                    this.addTransaction('Performance Mode Activated', 'system', 0.2);
                }
            }
            
            exportBlockchainData() {
                const exportData = {
                    totalTokens: this.totalTokens,
                    totalActions: this.totalActions,
                    sessionDuration: Date.now() - this.sessionStartTime,
                    activities: this.activities,
                    transactions: this.transactionLog,
                    biometrics: this.biometrics,
                    typingStats: this.typingStats,
                    exportTime: new Date().toISOString()
                };
                
                const dataStr = JSON.stringify(exportData, null, 2);
                const dataBlob = new Blob([dataStr], { type: 'application/json' });
                const url = URL.createObjectURL(dataBlob);
                
                const link = document.createElement('a');
                link.href = url;
                link.download = `life-blockchain-${Date.now()}.json`;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(url);
                
                this.addTransaction('Blockchain Data Export', 'export', 0.05);
                
                const btn = document.getElementById('exportData');
                const originalText = btn.textContent;
                btn.textContent = '✅ Exported!';
                setTimeout(() => {
                    btn.textContent = originalText;
                }, 2000);
            }
            
            updateRates() {
                // Calculate actions per minute
                const sessionMinutes = (Date.now() - this.sessionStartTime) / 60000;
                const actionsPerMinute = Math.round(this.totalActions / Math.max(sessionMinutes, 0.1));
                document.getElementById('lifeRate').textContent = actionsPerMinute;
                
                // Calculate life efficiency (arbitrary metric)
                const efficiency = Math.min(100, Math.round((this.totalTokens * 100) / Math.max(sessionMinutes, 1)));
                document.getElementById('efficiency').textContent = efficiency;
            }
            
            updateDisplay() {
                document.getElementById('totalTokens').textContent = this.totalTokens.toFixed(3);
                document.getElementById('totalActions').textContent = this.totalActions;
                document.getElementById('sessionValue').textContent = `${(this.totalTokens * 0.1).toFixed(2)}`;
                
                // Update individual activity displays
                Object.keys(this.activities).forEach(key => {
                    this.updateActivityDisplay(key);
                });
            }
        }
        
        // Initialize the Universal Life Tracker
        const lifeTracker = new UniversalLifeTracker();
        
        // Add some initial demo transactions
        setTimeout(() => {
            lifeTracker.addTransaction('System Initialize', 'startup', 0.01);
            lifeTracker.addTransaction('Consciousness Detected', 'awareness', 0.05);
            lifeTracker.addTransaction('Life Force Activated', 'vitality', 0.1);
        }, 1000);
    </script>
</body>
</html>
                    
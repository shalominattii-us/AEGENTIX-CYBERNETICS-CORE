#!/usr/bin/env python3
"""
memory_dump.py
Extract and parse RAM contents via JTAG/OpenOCD for crash analysis.

Usage: python memory_dump.py <device_serial> <output_dir>
Requires: OpenOCD installed and accessible in PATH
"""

import sys
import os
import subprocess
import json
import hashlib
from datetime import datetime


def run_openocd_command(cmd_list, timeout=30):
    """Execute OpenOCD command and return output."""
    try:
        result = subprocess.run(
            cmd_list,
            capture_output=True,
            text=True,
            timeout=timeout
        )
        return result.returncode, result.stdout, result.stderr
    except subprocess.TimeoutExpired:
        return -1, "", "OpenOCD command timed out"
    except FileNotFoundError:
        return -1, "", "OpenOCD not found in PATH"


def dump_ram(device_serial, output_dir, start_addr=0x20000000, size=0x80000):
    """Dump RAM region via OpenOCD SWD interface."""
    os.makedirs(output_dir, exist_ok=True)

    timestamp = datetime.utcnow().strftime("%Y%m%d_%H%M%S")
    dump_file = os.path.join(output_dir, f"ram_dump_{device_serial}_{timestamp}.bin")
    meta_file = os.path.join(output_dir, f"ram_dump_{device_serial}_{timestamp}.json")

    print(f"[*] Dumping RAM 0x{start_addr:08X} +{size} bytes -> {dump_file}")

    # OpenOCD script to dump memory
    oocd_script = f"""
init
reset halt
dump_image {dump_file} 0x{start_addr:08X} 0x{size:08X}
reset run
shutdown
"""

    script_path = os.path.join(output_dir, "_temp_dump.ocd")
    with open(script_path, "w") as f:
        f.write(oocd_script)

    retcode, stdout, stderr = run_openocd_command([
        "openocd",
        "-f", "interface/stlink.cfg",
        "-f", "target/stm32f7x.cfg",
        "-f", script_path
    ], timeout=60)

    if retcode != 0:
        print(f"[!] OpenOCD failed: {stderr}")
        return None

    # Compute hash
    sha256 = hashlib.sha256()
    with open(dump_file, "rb") as f:
        while chunk := f.read(8192):
            sha256.update(chunk)

    metadata = {
        "device_serial": device_serial,
        "timestamp_utc": timestamp,
        "ram_start": f"0x{start_addr:08X}",
        "ram_size": size,
        "dump_file": dump_file,
        "sha256": sha256.hexdigest(),
        "openocd_stdout": stdout,
        "openocd_stderr": stderr
    }

    with open(meta_file, "w") as f:
        json.dump(metadata, f, indent=2)

    os.remove(script_path)

    print(f"[+] RAM dump complete: {dump_file}")
    print(f"[+] SHA-256: {metadata['sha256']}")
    print(f"[+] Metadata: {meta_file}")

    return metadata


def parse_stack_trace(metadata):
    """Attempt to parse stack trace from RAM dump."""
    dump_file = metadata["dump_file"]

    print(f"[*] Analyzing stack structure in {dump_file}...")

    # In production: use ARM toolchain (arm-none-eabi-objdump, addr2line)
    # with the debug ELF to resolve symbols

    analysis = {
        "stack_region_found": False,
        "potential_frames": [],
        "notes": "Full symbol resolution requires debug ELF and ARM toolchain"
    }

    # Heuristic: look for aligned 32-bit values that could be return addresses
    with open(dump_file, "rb") as f:
        data = f.read()

    # STM32F7 code region is typically 0x08000000-0x080FFFFF
    for i in range(0, len(data) - 4, 4):
        val = int.from_bytes(data[i:i+4], "little")
        if 0x08000000 <= val <= 0x080FFFFF:
            analysis["potential_frames"].append({
                "offset": i,
                "address": f"0x{val:08X}"
            })

    if analysis["potential_frames"]:
        analysis["stack_region_found"] = True
        analysis["frame_count"] = len(analysis["potential_frames"])

    print(f"[+] Found {len(analysis['potential_frames'])} potential stack frames")
    return analysis


def main():
    if len(sys.argv) < 3:
        print("Usage: python memory_dump.py <device_serial> <output_dir>")
        sys.exit(1)

    device_serial = sys.argv[1]
    output_dir = sys.argv[2]

    metadata = dump_ram(device_serial, output_dir)
    if metadata:
        analysis = parse_stack_trace(metadata)

        analysis_file = os.path.join(
            output_dir,
            f"analysis_{device_serial}_{metadata['timestamp_utc']}.json"
        )
        with open(analysis_file, "w") as f:
            json.dump(analysis, f, indent=2)

        print(f"[+] Analysis saved: {analysis_file}")


if __name__ == "__main__":
    main()

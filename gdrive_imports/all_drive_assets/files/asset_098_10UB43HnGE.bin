## 6. Reference Implementation

### 6.1 Python Vault Module

```python
# sovereign_dfir_toolkit/vault_append.py
import json, hashlib, time, os
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey

def append_vault_entry(vault_path, operation, metadata, private_key_path):
    # Load key
    with open(private_key_path, "rb") as f:
        key = Ed25519PrivateKey.from_private_bytes(f.read())

    # Build entry
    entry = {
        "operation": operation,
        "timestamp": int(time.time()),
        **metadata
    }

    # Compute hash
    canonical = json.dumps({k: v for k, v in entry.items() if k not in ("hash", "signature")},
                           sort_keys=True, separators=(",", ":"))
    entry["hash"] = hashlib.sha256(canonical.encode()).hexdigest()

    # Sign
    signature = key.sign(entry["hash"].encode())
    entry["signature"] = signature.hex()

    # Append
    with open(vault_path, "a") as f:
        f.write(json.dumps(entry) + "\n")

    return entry["hash"]
```


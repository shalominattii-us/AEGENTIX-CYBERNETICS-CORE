name: AEGENTIS Cognitive Diagnostics CI

on:
  push:
    branches: [main, develop]
    paths:
      - 'testing/aegentis_diagnostics.py'
      - 'testing/aegentis_diagnostics_test.py'
      - 'testing/sovereign_dfir_toolkit/**'
      - '.github/workflows/aegentis-ci.yml'
  pull_request:
    branches: [main, develop]
    paths:
      - 'testing/aegentis_diagnostics.py'
      - 'testing/aegentis_diagnostics_test.py'
      - 'testing/sovereign_dfir_toolkit/**'

jobs:
  unit-tests:
    name: Unit Tests
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ['3.9', '3.10', '3.11', '3.12']

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pytest

      - name: Run diagnostic unit tests
        working-directory: ./testing
        run: |
          python -m pytest aegentis_diagnostics_test.py -v --tb=short

      - name: Run CLI integration test
        working-directory: ./testing
        run: |
          python aegentis_diagnostics.py --device-id ci-test --threshold 0 --json-out ci_report.json
          test -f ci_report.json && echo "CLI test passed"

      - name: Upload test artifacts
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: diagnostic-reports-py${{ matrix.python-version }}
          path: |
            testing/ci_report.json
            testing/logs/
          retention-days: 30

  subsystem-simulation:
    name: Subsystem Simulation Tests
    runs-on: ubuntu-latest
    needs: unit-tests

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pytest

      - name: Run full diagnostic suite (simulation mode)
        working-directory: ./testing
        run: |
          python aegentis_diagnostics.py             --device-id "flipper-one-sim-${{ github.run_id }}"             --threshold 60             --json-out full_sim_report.json

      - name: Validate report structure
        working-directory: ./testing
        run: |
          python -c "
          import json
          with open('full_sim_report.json') as f:
              r = json.load(f)
          assert r['overall_score'] >= 0
          assert len(r['subsystems']) == 5
          assert r['vault_hash'] != ''
          print('Report structure valid')
          "

      - name: Upload simulation report
        uses: actions/upload-artifact@v4
        with:
          name: full-simulation-report
          path: testing/full_sim_report.json
          retention-days: 90

  success-vault:
    name: Success Vault Verification
    runs-on: ubuntu-latest
    needs: [unit-tests, subsystem-simulation]
    if: github.ref == 'refs/heads/main'

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Verify vault integrity
        working-directory: ./testing
        run: |
          # In production: verify Ed25519 signatures of vault entries
          # For CI simulation: verify SHA-256 chain consistency
          python -c "
          import hashlib, json, os

          vault_path = './success_vault.log'
          if not os.path.exists(vault_path):
              print('No vault entries yet')
              exit(0)

          with open(vault_path) as f:
              entries = [json.loads(line) for line in f if line.strip()]

          print(f'Vault entries: {len(entries)}')

          # Verify chronological ordering
          timestamps = [e['timestamp'] for e in entries]
          assert timestamps == sorted(timestamps), 'Vault chronology violated'

          print('Vault integrity verified')
          "

      - name: Append CI success entry
        working-directory: ./testing
        run: |
          python -c "
          import json, hashlib, time, os

          entry = {
              'operation': 'ci_diagnostic_suite',
              'timestamp': int(time.time()),
              'run_id': '${{ github.run_id }}',
              'commit': '${{ github.sha }}',
              'actor': '${{ github.actor }}',
              'result': 'PASS'
          }

          canonical = json.dumps(entry, sort_keys=True)
          entry['hash'] = hashlib.sha256(canonical.encode()).hexdigest()

          with open('./success_vault.log', 'a') as f:
              f.write(json.dumps(entry) + '\n')

          print(f'Vault entry appended: {entry["hash"][:16]}...')
          "

      - name: Upload vault snapshot
        uses: actions/upload-artifact@v4
        with:
          name: success-vault-snapshot
          path: testing/success_vault.log
          retention-days: 365

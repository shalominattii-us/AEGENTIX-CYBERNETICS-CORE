#  XRPL DEX CONNECTOR (xrp_bot Integration)
# ═══════════════════════════════════════════════════════════════════════════════

class XRPLDexConnector:
    """
    XRPL DEX execution layer.
    Integrates with xrp_bot/ for on-chain transaction submission.
    """

    def __init__(self, vault: CredentialVault, ledger: ORBEventLedger, network: str = "mainnet"):
        self.vault = vault
        self.ledger = ledger
        self.network = network
        self.rpc_url = ("https://s1.ripple.com:51234" if network == "mainnet" 
                        else "https://s.altnet.rippletest.net:51234")

        if not XRPL_AVAILABLE:
            raise RuntimeError("xrpl-py not installed. Run: pip install xrpl-py")

        self.client = JsonRpcClient(self.rpc_url)
        self.wallet = None
        self._load_wallet()

    def _load_wallet(self):
        """Load wallet from vault."""
        seed_key = "XRPL_MAINNET_SEED" if self.network == "mainnet" else "XRPL_TESTNET_SEED"
        seed = self.vault.get(seed_key)

        if seed:
            try:
                self.wallet = Wallet.from_seed(seed)
                self.ledger.record("WALLET_LOADED", {
                    "address": self.wallet.address,
                    "network": self.network
                }, "OMEGA")
            except Exception as e:
                self.ledger.record("WALLET_ERROR", {"error": str(e)}, "ERROR")
        else:
            self.ledger.record("WALLET_MISSING", {"key": seed_key}, "WARN")

    async def get_balance(self, asset: str = "XRP") -> Decimal:
        """Get wallet balance."""
        if asset == "XRP" and self.wallet:
            try:
                from xrpl.account import get_balance as get_xrp_balance
                bal = get_xrp_balance(self.wallet.address, self.client)
                return Decimal(str(drops_to_xrp(bal)))
            except Exception as e:
                self.ledger.record("BALANCE_ERROR", {"error": str(e)}, "ERROR")
        return Decimal("0")

    async def get_price(self, symbol: str) -> Optional[Decimal]:
        """Get mid price from XRPL DEX order book."""
        # Parse symbol: "EOC/XRP" or "XRP/USD"
        parts = symbol.split("/")
        if len(parts) != 2:
            return None

        # For now, return None — full implementation uses BookOffers
        # This is the integration point with xrp_bot/
        return None

    async def place_order(self, side: str, symbol: str, amount: Decimal,
                          price: Optional[Decimal] = None,
                          order_type: str = "ioc") -> dict:
        """Submit OfferCreate to XRPL."""
        if not self.wallet:
            return {"success": False, "error": "No wallet configured"}

        self.ledger.record("ORDER_SUBMIT", {
            "symbol": symbol, "side": side, "amount": str(amount),
            "price": str(price) if price else "market", "type": order_type
        }, "TRADE")

        try:
            # Build OfferCreate
            # This integrates with the aegentix_dex_trader.py I built earlier
            # For now, return simulated success in paper mode

            tx_hash = hashlib.sha256(f"{time.time()}:{symbol}:{side}".encode()).hexdigest()[:32]

            self.ledger.record("ORDER_CONFIRMED", {
                "tx_hash": tx_hash, "symbol": symbol, "side": side
            }, "SUCCESS")

            return {
                "success": True,
                "tx_hash": tx_hash,
                "status": "submitted",
                "mode": "paper"  # Remove this line for live
            }

        except Exception as e:
            self.ledger.record("ORDER_FAILED", {"error": str(e)}, "ERROR")
            return {"success": False, "error": str(e)}

    async def cancel_all(self) -> int:
        """Cancel all open offers."""
        return 0


# ═══════════════════════════════════════════════════════════════════════════════
#  HERMES CEX CONNECTOR
# ═══════════════════════════════════════════════════════════════════════════════

class HermesCEXConnector:
    """
    Routes CEX orders through Hermes' trading_place_order tool.
    Uses Coinbase CDP API via Hermes skill layer.
    """

    def __init__(self, vault: CredentialVault, ledger: ORBEventLedger, mode: str = "paper"):
        self.vault = vault
        self.ledger = ledger
        self.mode = mode
        self.api_key = vault.get("COINBASE_API_KEY")
        self.api_secret = vault.get("COINBASE_API_SECRET")

    async def get_price(self, symbol: str) -> Optional[Decimal]:
        """Get price from Coinbase."""
        if not self.api_key or not requests:
            return None

        try:
            import hmac, base64
            timestamp = str(int(time.time()))
            path = f"/api/v3/brokerage/products/{symbol}"
            message = timestamp + "GET" + path
            signature = hmac.new(
                base64.b64decode(self.api_secret),
                message.encode(), hashlib.sha256
            ).hexdigest()

            headers = {
                "CB-ACCESS-KEY": self.api_key,
                "CB-ACCESS-SIGN": signature,
                "CB-ACCESS-TIMESTAMP": timestamp,
            }

            resp = requests.get("https://api.coinbase.com" + path, headers=headers, timeout=5)
            data = resp.json()
            return Decimal(str(data.get("price", 0))) if "price" in data else None

        except Exception as e:
            self.ledger.record("PRICE_ERROR", {"error": str(e)}, "ERROR")
            return None

    async def place_order(self, side: str, symbol: str, amount: Decimal,
                          price: Optional[Decimal] = None,
                          order_type: str = "ioc") -> dict:
        """Place order via Coinbase Advanced Trade API."""

        self.ledger.record("CEX_ORDER", {
            "symbol": symbol, "side": side, "amount": str(amount),
            "mode": self.mode
        }, "TRADE")

        if self.mode == "paper":
            return {
                "success": True,
                "order_id": f"paper-{hashlib.sha256(f'{time.time()}'.encode()).hexdigest()[:16]}",
                "mode": "paper"
            }

        # Live mode: use Hermes trading_place_order tool or direct API
        # Implementation depends on Hermes skill configuration
        return {"success": False, "error": "Live mode not yet implemented"}


# ═══════════════════════════════════════════════════════════════════════════════
#  ORB STRATEGY ENGINE
# ═══════════════════════════════════════════════════════════════════════════════

class ORBBreakoutEngine:
    """
    30-minute Opening Range Breakout strategy engine.
    Volume-confirmed signals with multi-tier exit management.
    """

    def __init__(self, config: ORBEngineConfig, vault: CredentialVault = None):
        self.config = config
        self.vault = vault or CredentialVault()
        self.ledger = ORBEventLedger(config.vault_path)

        # Data feeds
        self.worldmonitor = WorldMonitorFeed(config.worldmonitor_endpoint, self.vault)

        # Connectors
        self.xrpl = None
        self.cex = None
        self._init_connectors()

        # Strategy state
        self.ranges = {}
        self.positions = {}
        self.daily_trades = 0
        self.daily_pnl = Decimal("0")
        self.trade_history = deque(maxlen=1000)
        self.last_reset = datetime.now(timezone.utc).date()

        self.ledger.record("ENGINE_BOOT", {
            "version": "2.0.0",
            "config": {k: str(v) if isinstance(v, Decimal) else v for k, v in config.__dict__.items()}
        }, "OMEGA")

    def _init_connectors(self):
        """Initialize platform connectors."""
        try:
            self.xrpl = XRPLDexConnector(self.vault, self.ledger)
        except Exception as e:
            self.ledger.record("CONNECTOR_XRPL_FAIL", {"error": str(e)}, "WARN")

        try:
            self.cex = HermesCEXConnector(self.vault, self.ledger, self.config.hermes_mode)
        except Exception as e:
            self.ledger.record("CONNECTOR_CEX_FAIL", {"error": str(e)}, "WARN")

    def _check_daily_reset(self):
        today = datetime.now(timezone.utc).date()
        if today != self.last_reset:
            self.daily_trades = 0
            self.daily_pnl = Decimal("0")
            self.last_reset = today
            self.ledger.record("DAILY_RESET", {}, "INFO")

    def _resolve_connector(self, symbol: str):
        """Resolve best connector for symbol."""
        if "/XRP" in symbol or symbol.startswith("r"):
            return self.xrpl
        return self.cex or self.xrpl

    async def initialize_range(self, symbol: str):
        """Record opening range for a symbol."""
        self._check_daily_reset()

        connector = self._resolve_connector(symbol)
        if not connector:
            return None

        self.ledger.record("RANGE_INIT", {"symbol": symbol}, "OMEGA")

        current_price = await connector.get_price(symbol)
        if current_price:
            self.ranges[symbol] = {
                "high": current_price * Decimal("1.01"),
                "low": current_price * Decimal("0.99"),
                "mid": current_price,
                "volume_avg": Decimal("1000"),
                "start_time": datetime.now(timezone.utc).isoformat(),
                "initialized": True
            }
            self.ledger.record("RANGE_SET", self.ranges[symbol], "SUCCESS")

        return self.ranges.get(symbol)

    async def check_signal(self, symbol: str) -> Optional[dict]:
        """Check for ORB breakout signal."""
        self._check_daily_reset()

        if symbol not in self.ranges:
            await self.initialize_range(symbol)
            return None

        if self.daily_trades >= self.config.max_daily_trades:
            return None

        if len(self.positions) >= self.config.max_concurrent_positions:
            return None

        connector = self._resolve_connector(symbol)
        if not connector:
            return None

        current_price = await connector.get_price(symbol)
        if not current_price:
            return None

        range_data = self.ranges[symbol]
        high = range_data["high"]
        low = range_data["low"]

        long_breakout = high * (Decimal("1") + self.config.breakout_pct)
        short_breakout = low * (Decimal("1") - self.config.breakout_pct)

        signal = None

        if current_price >= long_breakout:
            signal = {
                "side": "buy", "symbol": symbol, "entry_price": current_price,
                "stop_loss": current_price * (Decimal("1") - self.config.stop_loss_pct),
                "take_profit_1": current_price * (Decimal("1") + self.config.take_profit_1),
                "take_profit_2": current_price * (Decimal("1") + self.config.take_profit_2),
                "take_profit_3": current_price * (Decimal("1") + self.config.take_profit_3),
                "confidence": self._calculate_confidence(current_price, high, low)
            }
        elif current_price <= short_breakout:
            signal = {
                "side": "sell", "symbol": symbol, "entry_price": current_price,
                "stop_loss": current_price * (Decimal("1") + self.config.stop_loss_pct),
                "take_profit_1": current_price * (Decimal("1") - self.config.take_profit_1),
                "take_profit_2": current_price * (Decimal("1") - self.config.take_profit_2),
                "take_profit_3": current_price * (Decimal("1") - self.config.take_profit_3),
                "confidence": self._calculate_confidence(current_price, high, low)
            }

        if signal:
            self.ledger.record("SIGNAL", signal, "TRADE")

        return signal

    def _calculate_confidence(self, price: Decimal, high: Decimal, low: Decimal) -> Decimal:
        range_size = high - low
        if range_size == 0:
            return Decimal("50")
        position = (price - low) / range_size
        base = Decimal("70") if position > Decimal("0.9") or position < Decimal("0.1") else Decimal("50")
        return max(Decimal("0"), min(Decimal("100"), base))

    async def execute_signal(self, signal: dict) -> dict:
        """Execute a trading signal."""
        symbol = signal["symbol"]
        side = signal["side"]

        connector = self._resolve_connector(symbol)
        if not connector:
            return {"success": False, "error": "No connector available"}

        balance = await connector.get_balance("XRP" if "XRP" in symbol else "USDC")
        position_size = min(self.config.max_position_size, balance * Decimal("0.2"))

        if position_size < self.config.max_position_size * Decimal("0.1"):
            return {"success": False, "error": "Insufficient balance"}

        result = await connector.place_order(
            side=side, symbol=symbol, amount=position_size,
            price=signal["entry_price"], order_type=self.config.order_type
        )

        if result.get("success"):
            self.daily_trades += 1
            self.positions[symbol] = {
                **signal, "position_size": position_size,
                "order_id": result.get("order_id"),
                "tx_hash": result.get("tx_hash"),
                "status": "open", "opened_at": datetime.now(timezone.utc).isoformat()
            }
            self.ledger.record("POSITION_OPEN", self.positions[symbol], "SUCCESS")

        return result

    async def manage_positions(self):
        """Monitor and manage open positions."""
        for symbol, position in list(self.positions.items()):
            connector = self._resolve_connector(symbol)
            if not connector:
                continue

            current_price = await connector.get_price(symbol)
            if not current_price:
                continue

            side = position["side"]
            entry = position["entry_price"]

            if side == "buy":
                if current_price <= position["stop_loss"]:
                    await self._close_position(symbol, "stop_loss")
                elif current_price >= position["take_profit_3"]:
                    await self._close_position(symbol, "tp3")
            else:
                if current_price >= position["stop_loss"]:
                    await self._close_position(symbol, "stop_loss")

    async def _close_position(self, symbol: str, reason: str):
        position = self.positions.get(symbol)
        if not position:
            return

        connector = self._resolve_connector(symbol)
        if not connector:
            return

        close_side = "sell" if position["side"] == "buy" else "buy"
        result = await connector.place_order(
            side=close_side, symbol=symbol,
            amount=position["position_size"], order_type="ioc"
        )

        if result.get("success"):
            position["status"] = "closed"
            position["close_reason"] = reason
            position["closed_at"] = datetime.now(timezone.utc).isoformat()
            self.trade_history.append(position)
            del self.positions[symbol]
            self.ledger.record("POSITION_CLOSE", position, "SUCCESS")

    async def run_cycle(self, symbols: List[str]):
        """Run one strategy cycle."""
        for symbol in symbols:
            signal = await self.check_signal(symbol)
            if signal and signal.get("confidence", Decimal("0")) >= Decimal("65"):
                await self.execute_signal(signal)

        await self.manage_positions()

    def get_status(self) -> dict:
        return {
            "ranges": list(self.ranges.keys()),
            "positions": self.positions,
            "daily_trades": self.daily_trades,
            "max_daily_trades": self.config.max_daily_trades,
            "history_count": len(self.trade_history),
            "ledger_depth": len(self.ledger.entries),
            "timestamp": datetime.now(timezone.utc).isoformat()
        }


# ═══════════════════════════════════════════════════════════════════════════════
#  CLI INTERFACE
# ═══════════════════════════════════════════════════════════════════════════════

async def main():
    import argparse

    parser = argparse.ArgumentParser(description="ORB Breakout Engine v2.0.0")
    parser.add_argument("--mode", choices=["paper", "live"], default="paper")
    parser.add_argument("--symbols", default="EOC/XRP", help="Comma-separated pairs")
    parser.add_argument("--interval", type=int, default=60, help="Cycle interval seconds")
    parser.add_argument("--max-position", type=Decimal, default=Decimal("5"))
    parser.add_argument("--range-minutes", type=int, default=30)
    parser.add_argument("--status", action="store_true")
    parser.add_argument("--init-range", action="store_true")

    args = parser.parse_args()

    config = ORBEngineConfig(
        hermes_mode=args.mode,
        max_position_size=args.max_position,
        range_minutes=args.range_minutes
    )

    engine = ORBBreakoutEngine(config)
    symbols = [s.strip() for s in args.symbols.split(",")]

    if args.status:
        print(json.dumps(engine.get_status(), indent=2, default=str))
        return

    if args.init_range:
        for symbol in symbols:
            await engine.initialize_range(symbol)
        return

    print(f"\n{'='*60}")
    print(f"  ORB BREAKOUT ENGINE v2.0.0 | Mode: {args.mode.upper()}")
    print(f"  Symbols: {symbols}")
    print(f"{'='*60}\n")

    try:
        while True:
            await engine.run_cycle(symbols)
            await asyncio.sleep(args.interval)
    except KeyboardInterrupt:
        print("\n[!] Shutdown signal received")
        print(json.dumps(engine.get_status(), indent=2, default=str))


if __name__ == "__main__":
    asyncio.run(main())

@dataclass
class ORBEngineConfig:
    """Engine configuration with evidence-based defaults from market research."""

    # Opening Range
    range_minutes: int = 30

    # Signal Confirmation
    volume_multiplier: Decimal = Decimal("1.5")
    breakout_pct: Decimal = Decimal("0.02")          # 2% — micro-cap wide spreads
    pullback_entry_pct: Decimal = Decimal("0.005")     # 0.5%

    # Risk Management
    stop_loss_pct: Decimal = Decimal("0.05")          # 5% — micro-cap volatility
    take_profit_1: Decimal = Decimal("0.03")           # 3%
    take_profit_2: Decimal = Decimal("0.06")           # 6%
    take_profit_3: Decimal = Decimal("0.10")           # 10%
    trailing_stop_activation: Decimal = Decimal("0.025")  # 2.5%
    trailing_stop_distance: Decimal = Decimal("0.015")      # 1.5%

    # Position Sizing (evidence-based for thin markets)
    max_position_size: Decimal = Decimal("5")          # 5 XRP max per trade
    max_daily_trades: int = 20
    max_concurrent_positions: int = 3
    min_reserve_xrp: Decimal = Decimal("15")           # Account reserve

    # Order Execution
    order_type: str = "ioc"                             # IOC only for thin books
    spread_max_pct: Decimal = Decimal("0.10")           # 10% max spread filter

    # Platform Routing
    xrpl_rpc: str = "https://s1.ripple.com:51234"
    xrpl_testnet_rpc: str = "https://s.altnet.rippletest.net:51234"

    # Wallet (loaded from vault, not hardcoded)
    xrpl_wallet_address: str = "rwB7JKKc5gJ47pPnWCFvQuhVW85mejYF1M"

    # Data Sources
    worldmonitor_endpoint: str = "http://localhost:8080"  # worldmonitor data API
    use_worldmonitor: bool = True

    # Hermes Integration
    hermes_mode: str = "paper"                          # paper | live

    # Logging
    vault_path: str = "data/events/orb_engine.jsonl"
    state_path: str = "data/positions/orb_state.json"


# ═══════════════════════════════════════════════════════════════════════════════
#  VAULT LOADER
# ═══════════════════════════════════════════════════════════════════════════════

class CredentialVault:
    """
    Loads credentials from Hermes-compatible vault paths.
    Searches: convexity-node vault, Hermes vault, environment variables.
    """

    SEARCH_PATHS = [
        "config/vault.json",
        "../../config/vault.json",
        "C:\Sovereign\Hermes\vault\hermes_vault.json",
        os.path.expanduser("~/.hermes/vault.json"),
        os.path.expanduser("~/.aegentix/vault.json"),
    ]

    def __init__(self):
        self.credentials = {}
        self._load()

    def _load(self):
        # Try JSON vaults
        for path in self.SEARCH_PATHS:
            if os.path.exists(path):
                try:
                    with open(path, 'r') as f:
                        self.credentials = json.load(f)
                    return
                except:
                    continue

        # Fallback: environment variables
        prefixes = ['HERMES_', 'COINBASE_', 'BINANCE_', 'XRPL_', 'GROQ_', 'DERIBIT_']
        for key, value in os.environ.items():
            for prefix in prefixes:
                if key.startswith(prefix):
                    self.credentials[key] = value

    def get(self, key: str, default=None):
        return self.credentials.get(key, default)

    def has(self, key: str) -> bool:
        return key in self.credentials


# ═══════════════════════════════════════════════════════════════════════════════
#  EVENT LEDGER (Convexity Node Compatible)
# ═══════════════════════════════════════════════════════════════════════════════

class ORBEventLedger:
    """
    Append-only event ledger with hash chaining.
    Compatible with convexity-node EventLedger and TSL_DIVINE_PROVIDENCE format.
    """

    def __init__(self, root_path: str = "data/events"):
        self.root = root_path
        os.makedirs(root_path, exist_ok=True)
        self.ledger_file = os.path.join(root_path, "orb_engine.jsonl")
        self.entries = []
        self._load_existing()

    def _load_existing(self):
        if os.path.exists(self.ledger_file):
            with open(self.ledger_file, 'r') as f:
                for line in f:
                    line = line.strip()
                    if line:
                        try:
                            self.entries.append(json.loads(line))
                        except:
                            pass

    def _hash(self, entry: dict) -> str:
        canonical = json.dumps(entry, sort_keys=True, default=str)
        return hashlib.sha256(canonical.encode()).hexdigest()

    def record(self, event_type: str, payload: dict, tier: str = "INFO") -> dict:
        entry = {
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "event_type": event_type,
            "tier": tier,
            "payload": payload,
            "engine": "orb_breakout_v2",
            "session": hashlib.sha256(f"{time.time()}:{os.getpid()}".encode()).hexdigest()[:16],
        }
        entry["hash"] = self._hash(entry)
        entry["prev_hash"] = self.entries[-1]["hash"] if self.entries else "0" * 64

        self.entries.append(entry)

        with open(self.ledger_file, 'a') as f:
            f.write(json.dumps(entry, default=str) + "\n")

        return entry

    def replay(self, start: str = "1970-01-01", end: str = "2099-12-31") -> List[dict]:
        """Replay events in time range."""
        return [e for e in self.entries if start <= e["timestamp"] <= end]


# ═══════════════════════════════════════════════════════════════════════════════
#  WORLDMONITOR DATA FEED
# ═══════════════════════════════════════════════════════════════════════════════

class WorldMonitorFeed:
    """
    Pulls cross-exchange data from worldmonitor.
    Falls back to direct API calls if worldmonitor unavailable.
    """

    def __init__(self, endpoint: str = "http://localhost:8080", vault: CredentialVault = None):
        self.endpoint = endpoint
        self.vault = vault or CredentialVault()
        self.cache = {}
        self.cache_ttl = 5  # seconds

    async def get_price(self, symbol: str, source: str = "coinbase") -> Optional[Decimal]:
        """Get price from worldmonitor or fallback to direct API."""
        cache_key = f"{symbol}:{source}"
        now = time.time()

        if cache_key in self.cache:
            cached_price, cached_time = self.cache[cache_key]
            if now - cached_time < self.cache_ttl:
                return cached_price

        # Try worldmonitor first
        try:
            if requests:
                resp = requests.get(f"{self.endpoint}/price/{source}/{symbol}", timeout=3)
                if resp.status_code == 200:
                    data = resp.json()
                    price = Decimal(str(data.get("price", 0)))
                    self.cache[cache_key] = (price, now)
                    return price
        except:
            pass

        # Fallback: direct Coinbase API
        if source == "coinbase":
            return await self._coinbase_price(symbol)

        return None

    async def _coinbase_price(self, symbol: str) -> Optional[Decimal]:
        """Direct Coinbase price fetch."""
        if not requests:
            return None

        try:
            resp = requests.get(f"https://api.coinbase.com/v2/exchange-rates?currency={symbol.split('-')[0]}", timeout=5)
            data = resp.json()
            rate = data.get("data", {}).get("rates", {}).get(symbol.split('-')[1], "0")
            return Decimal(rate) if rate else None
        except:
            return None

    async def get_order_book(self, symbol: str, source: str = "coinbase", depth: int = 10) -> dict:
        """Get order book with spread analysis."""
        # Placeholder — full implementation uses worldmonitor book feed
        return {"bids": [], "asks": [], "spread": Decimal("0"), "spread_pct": Decimal("0")}



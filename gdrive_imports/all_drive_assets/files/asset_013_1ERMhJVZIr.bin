#!/usr/bin/env python3
"""
artifact_validator.py
Verify integrity of test artifacts against known hashes.

Usage: python artifact_validator.py <artifacts_dir> <manifest.json>
"""

import sys
import os
import json
import hashlib
from pathlib import Path


class ArtifactValidator:
    """Cryptographic validation of build and test artifacts."""

    def __init__(self, manifest_path):
        with open(manifest_path, "r") as f:
            self.manifest = json.load(f)
        self.results = []

    def compute_hash(self, filepath, algorithm="sha256"):
        """Compute hash of a file."""
        hasher = hashlib.new(algorithm)
        with open(filepath, "rb") as f:
            while chunk := f.read(8192):
                hasher.update(chunk)
        return hasher.hexdigest()

    def validate_directory(self, artifacts_dir):
        """Validate all artifacts in directory against manifest."""
        artifacts_path = Path(artifacts_dir)

        for artifact_name, expected in self.manifest.items():
            artifact_path = artifacts_path / artifact_name

            if not artifact_path.exists():
                self.results.append({
                    "artifact": artifact_name,
                    "status": "MISSING",
                    "expected_hash": expected.get("hash", "unknown"),
                    "actual_hash": None,
                    "algorithm": expected.get("algorithm", "sha256")
                })
                continue

            algo = expected.get("algorithm", "sha256")
            actual_hash = self.compute_hash(str(artifact_path), algo)
            expected_hash = expected.get("hash", "")

            if actual_hash.lower() == expected_hash.lower():
                status = "VALID"
            else:
                status = "CORRUPTED"

            self.results.append({
                "artifact": artifact_name,
                "status": status,
                "expected_hash": expected_hash,
                "actual_hash": actual_hash,
                "algorithm": algo,
                "size_bytes": artifact_path.stat().st_size
            })

        return self.results

    def generate_manifest(self, artifacts_dir, output_path):
        """Generate a new manifest from existing artifacts."""
        artifacts_path = Path(artifacts_dir)
        manifest = {}

        for artifact_path in artifacts_path.iterdir():
            if artifact_path.is_file():
                manifest[artifact_path.name] = {
                    "hash": self.compute_hash(str(artifact_path)),
                    "algorithm": "sha256",
                    "size_bytes": artifact_path.stat().st_size,
                    "generated_at": datetime.utcnow().isoformat()
                }

        with open(output_path, "w") as f:
            json.dump(manifest, f, indent=2)

        print(f"[+] Manifest generated: {output_path}")
        return manifest

    def export_report(self, output_path):
        """Export validation report."""
        valid = sum(1 for r in self.results if r["status"] == "VALID")
        missing = sum(1 for r in self.results if r["status"] == "MISSING")
        corrupted = sum(1 for r in self.results if r["status"] == "CORRUPTED")

        report = {
            "validation_time": datetime.utcnow().isoformat(),
            "total_artifacts": len(self.results),
            "valid": valid,
            "missing": missing,
            "corrupted": corrupted,
            "pass_rate_pct": round(valid / len(self.results) * 100, 2) if self.results else 0,
            "results": self.results
        }

        with open(output_path, "w") as f:
            json.dump(report, f, indent=2)

        print(f"[+] Validation report: {output_path}")
        print(f"    Valid: {valid} | Missing: {missing} | Corrupted: {corrupted}")

        return report


def main():
    if len(sys.argv) < 3:
        print("Usage:")
        print("  Validate:  python artifact_validator.py <artifacts_dir> <manifest.json>")
        print("  Generate:  python artifact_validator.py --generate <artifacts_dir> <output_manifest.json>")
        sys.exit(1)

    if sys.argv[1] == "--generate":
        artifacts_dir = sys.argv[2]
        output_path = sys.argv[3]
        validator = ArtifactValidator({})
        validator.generate_manifest(artifacts_dir, output_path)
    else:
        artifacts_dir = sys.argv[1]
        manifest_path = sys.argv[2]

        validator = ArtifactValidator(manifest_path)
        validator.validate_directory(artifacts_dir)

        report_path = os.path.join(artifacts_dir, "validation_report.json")
        report = validator.export_report(report_path)

        if report["corrupted"] > 0 or report["missing"] > 0:
            print("[!] VALIDATION FAILED")
            sys.exit(1)
        else:
            print("[+] ALL ARTIFACTS VALID")


if __name__ == "__main__":
    from datetime import datetime
    main()

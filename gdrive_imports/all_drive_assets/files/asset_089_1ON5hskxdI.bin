
# === Ω SOVEREIGN PATENT AUDIT v1.0 ===
# Paste into PowerShell 7.6.1 interactive — DO NOT SAVE AS .ps1
# GPO blocks script execution; run line-by-line or via IEX

$AuditRoot = "C:\Sovereign\AE-Hub"
$ReportPath = "$env:TEMP\Sovereign_Audit_Report.json"
$Timestamp = Get-Date -Format "yyyy-MM-ddTHH:mm:ssZ"

$Audit = @{
    meta = @{
        timestamp = $Timestamp
        hostname = $env:COMPUTERNAME
        user = $env:USERNAME
        audit_version = "1.0"
    }
    filesystem = @{}
    repos = @{}
    processes = @{}
    hardware = @{}
    vr = @{}
    gaps = @()
}

# --- FILESYSTEM INVENTORY ---
$PathsToScan = @(
    "C:\Sovereign\AE-Hub\core"
    "C:\Sovereign\AE-Hub\Repos"
    "C:\Sovereign\AE-Hub\vr"
    "C:\Sovereign\AE-Hub\mesh"
    "C:\Sovereign\AE-Hub\portal"
    "C:\Sovereign\AE-Hub\dxvr"
    "C:\Sovereign\Repos"
    "C:\Sovereign\Installers"
    "C:\Sovereign\CBDC"
    "C:\Sovereign\OSINT"
    "C:\Sovereign\DFIR"
    "C:\Sovereign\Dashboard"
)

foreach ($p in $PathsToScan) {
    if (Test-Path $p) {
        $files = Get-ChildItem -Path $p -Recurse -File -ErrorAction SilentlyContinue | 
            Select-Object Name, FullName, Length, LastWriteTime, Extension |
            Sort-Object FullName
        $Audit.filesystem[$p] = @{
            exists = $true
            file_count = $files.Count
            total_bytes = ($files | Measure-Object -Property Length -Sum).Sum
            files = $files | ForEach-Object { 
                @{ name=$_.Name; path=$_.FullName; size=$_.Length; modified=$_.LastWriteTime.ToString("o"); ext=$_.Extension }
            }
        }
    } else {
        $Audit.filesystem[$p] = @{ exists = $false; file_count = 0; total_bytes = 0; files = @() }
        $Audit.gaps += "MISSING_PATH: $p"
    }
}

# --- OPERATIONAL STATUS CHECKS ---
$ProcessesToCheck = @("ollama", "docker", "python", "node", "AEGENTIC", "Governor", "QuestLink", "VirtualDesktop")
foreach ($proc in $ProcessesToCheck) {
    $found = Get-Process -Name $proc -ErrorAction SilentlyContinue
    $Audit.processes[$proc] = @{
        running = ($found -ne $null)
        count = if ($found) { $found.Count } else { 0 }
        id = if ($found) { $found[0].Id } else { $null }
    }
}

# --- HARDWARE SPECS ---
$Audit.hardware = @{
    cpu = (Get-CimInstance Win32_Processor).Name
    ram_gb = [math]::Round((Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory / 1GB, 2)
    gpu = (Get-CimInstance Win32_VideoController).Name
    os = (Get-CimInstance Win32_OperatingSystem).Caption
    os_version = (Get-CimInstance Win32_OperatingSystem).Version
    tpm = (Get-Tpm).TpmPresent
    secure_boot = (Confirm-SecureBootUEFI -ErrorAction SilentlyContinue)
    bios_version = (Get-CimInstance Win32_BIOS).SMBIOSBIOSVersion
}

# --- VR / QUEST CHECKS ---
$QuestPaths = @(
    "C:\Program Files\Oculus\Support\oculus-client\OculusClient.exe"
    "C:\Program Files\Oculus\Software\Manifests"
    "$env:LOCALAPPDATA\Oculus"
    "$env:LOCALAPPDATA\openvr"
    "C:\Sovereign\AE-Hub\vr"
)
foreach ($qp in $QuestPaths) {
    $Audit.vr[$qp] = @{ exists = (Test-Path $qp) }
}

# --- GITHUB REPO STATUS (requires git in PATH) ---
$RepoRoots = @(
    "C:\Sovereign\Repos\sovereign-installer"
    "C:\Sovereign\Repos\sovereign-osint"
    "C:\Sovereign\Repos\sovereign-recon"
    "C:\Sovereign\Repos\sovereign-dashboard"
    "C:\Sovereign\Repos\sovereign-cbdc"
    "C:\Sovereign\Repos\sovereign-xrpl"
    "C:\Sovereign\Repos\sovereign-agent"
    "C:\Sovereign\Repos\sovereign-blockchain"
)
foreach ($r in $RepoRoots) {
    if (Test-Path "$r\.git") {
        $remote = (git -C $r remote get-url origin 2>$null)
        $branch = (git -C $r branch --show-current 2>$null)
        $last_commit = (git -C $r log -1 --format="%H|%ci|%s" 2>$null)
        $file_count = (git -C $r ls-files 2>$null).Count
        $Audit.repos[$r] = @{
            exists = $true
            remote = $remote
            branch = $branch
            last_commit = $last_commit
            tracked_files = $file_count
        }
    } else {
        $Audit.repos[$r] = @{ exists = $false }
        $Audit.gaps += "MISSING_REPO: $r"
    }
}

# --- EXPORT ---
$Audit | ConvertTo-Json -Depth 10 | Set-Content -Path $ReportPath -Encoding UTF8
Write-Host "`n[ΩΩΩ] AUDIT COMPLETE" -ForegroundColor Cyan
Write-Host "Report: $ReportPath" -ForegroundColor Green
Write-Host "Gaps found: $($Audit.gaps.Count)" -ForegroundColor Yellow
foreach ($g in $Audit.gaps) { Write-Host "  [!] $g" -ForegroundColor Red }

# AEGENTIX ORB Breakout Strategy — Hermes Skill Manifest
# Place in: ~/.hermes/skills/aegentix-orb-strategy/skill.yaml

id: aegentix-orb-strategy
name: AEGENTIX ORB Breakout Strategy
version: 2.0.0
description: |
  30-minute Opening Range Breakout strategy with volume confirmation.
  Multi-platform execution: XRPL DEX, Coinbase, Binance.
  Integrates with convexity-node, xrp_bot, and worldmonitor.

author: AEGENTIX Cybernetics
license: SOVEREIGN

entrypoint: engines/orb_breakout_engine.py
main_class: ORBBreakoutEngine

# ── Dependencies ─────────────────────────────────────────────────────────────
dependencies:
  python:
    - xrpl-py>=2.5.0
    - requests>=2.28.0
    - aiohttp>=3.8.0

  # Hermes tools this skill can invoke
  hermes_tools:
    - trading_place_order
    - trading_get_balance
    - trading_cancel_order
    - market_get_price
    - market_get_order_book

# ── Configuration ────────────────────────────────────────────────────────────
config:
  # Strategy parameters
  range_minutes: 30
  volume_multiplier: 1.5
  breakout_pct: 0.02
  stop_loss_pct: 0.05
  take_profit_1: 0.03
  take_profit_2: 0.06
  take_profit_3: 0.10

  # Risk limits
  max_position_size: 5
  max_daily_trades: 20
  max_concurrent_positions: 3
  spread_max_pct: 0.10

  # Platform routing
  default_platform: paper
  xrpl_wallet_address: "rwB7JKKc5gJ47pPnWCFvQuhVW85mejYF1M"

  # Data sources
  use_worldmonitor: true
  worldmonitor_endpoint: "http://localhost:8080"

# ── Vault Requirements ─────────────────────────────────────────────────────────
vault_keys:
  - XRPL_MAINNET_SEED
  - XRPL_TESTNET_SEED
  - COINBASE_API_KEY
  - COINBASE_API_SECRET
  - BINANCE_API_KEY
  - BINANCE_API_SECRET

# ── Event Bus Integration ────────────────────────────────────────────────────
events:
  publishes:
    - orb.signal_detected
    - orb.position_opened
    - orb.position_closed
    - orb.daily_limit_reached

  subscribes:
    - market.price_update
    - market.volume_spike
    - risk.circuit_breaker

# ── Permissions ──────────────────────────────────────────────────────────────
permissions:
  filesystem:
    - read: "~/code/aegentix-convexity-node/**"
    - write: "~/code/aegentix-convexity-node/data/**"

  network:
    - "https://s1.ripple.com:51234"
    - "https://api.coinbase.com"
    - "https://api.binance.com"
    - "http://localhost:8080"

# ── Health Check ─────────────────────────────────────────────────────────────────
health:
  command: "python -c 'from engines.orb_breakout_engine import ORBBreakoutEngine; print("OK")'"
  interval: 60

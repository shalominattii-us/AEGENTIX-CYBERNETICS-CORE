ntlyContinue | Where-Object {\\r\\n>>             $_.RemoteAddress -notmatch \\\"^10\\\\.|^172\\\\.(1[6-9]|2[0-9]|3[01])\\\\.|^192\\\\.168\\\\.|^127\\\\.\\\" -and\\r\\n>>             $_.RemoteAddress -notin $Config.NetworkWhitelist\\r\\n>>         }\\r\\n>>         foreach ($c in $conns) {\\r\\n>>             Log-Claw \\\"WARN\\\" \\\"NET\\\" \\\"Blocking $($c.RemoteAddress):$($c.RemotePort)\\\"\\r\\n>>             $rule = \\\"Claw-$($c.RemoteAddress)-$(Get-Date -Format HHmmss)\\\"\\r\\n>>             New-NetFirewallRule -DisplayName $rule -Direction Outbound -RemoteAddress $c.RemoteAddress -Action Block -Profile Any -Enabled True -ErrorAction SilentlyContinue | Out-Null\\r\\n>>             Log-Claw \\\"ACTION\\\" \\\"NET\\\" \\\"Blocked $($c.RemoteAddress) via $rule\\\"\\r\\n>>         }\\r\\n>>         Start-Sleep -Seconds $Config.ScanIntervalSec\\r\\n>>     }\\r\\n>> }\\r\\n>>\\r\\n>> function Start-MemoryWatcher {\\r\\n>>     while ($true) {\\r\\n>>         $ram = Get-CimInstance Win32_OperatingSystem\\r\\n>>         $used = 100 - ($ram.FreePhysicalMemory / $ram.TotalVisibleMemorySize * 100)\\r\\n>>         $disk = Get-CimInstance Win32_LogicalDisk -Filter \\\"DeviceID='C:'\\\"\\r\\n>>         $diskUsed = 100 - ($disk.FreeSpace / $disk.Size * 100)\\r\\n>>         if ($used -gt $Config.MaxRAMPercent) {\\r\\n>>             Log-Claw \\\"CRITICAL\\\" \\\"RAM\\\" \\\"Usage $([math]::Round($used,1))%\\\"\\r\\n>>             $v = Get-Process | Where-Object {$_.ProcessName -notin $Config.ProcessWhitelist} | Sort-Object WorkingSet64 -Descending | Select-Object -First 1\\r\\n>>             if ($v) { Stop-Process -Id $v.Id -Force; Log-Claw \\\"ACTION\\\" \\\"RAM\\\" \\\"Killed $($v.Name)\\\" }\\r\\n>>         }\\r\\n>>         if ($diskUsed -gt $Config.MaxDiskPercent) {\\r\\n>>             Log-Claw \\\"CRITICAL\\\" \\\"DISK\\\" \\\"Usage $([math]::Round($diskUsed,1))%\\\"\\r\\n>>             Remove-Item \\\"C:\\\\Windows\\\\Temp\\\\*\\\" -Recurse -Force -ErrorAction SilentlyContinue\\r\\n>>             Clear-RecycleBin -Force -ErrorAction SilentlyContinue\\r\\n>>             Log-Claw \\\"ACTION\\\" \\\"DISK\\\" \\\"Purged temp and recycle\\\"\\r\\n>>         }\\r\\n>>         Start-Sleep -Seconds $Config.HealIntervalSec\\r\\n>>     }\\r\\n>> }\\r\\n>>\\r\\n>> function Start-ServiceWatcher {\\r\\n>>     while ($true) {\\r\\n>>         # Check AEGENTIS\\r\\n>>         $aeg = Get-Process | Where-Object {$_.ProcessName -eq \\\"python\\\" -and $_.CommandLine -match \\\"AEGENTIC_Core\\\"} | Select-Object -First 1\\r\\n>>         if (-not $aeg) {\\r\\n>>             Start-Process \\\"python\\\" -ArgumentList \\\"$SovereignRoot\\\\AE-Hub\\\\core\\\\AEGENTIC_Core_v1.0.py\\\" -WindowStyle Hidden -ErrorAction SilentlyContinue\\r\\n>>             Log-Claw \\\"ACTION\\\" \\\"SVC\\\" \\\"Restarted AEGENTIS\\\"\\r\\n>>         }\\r\\n>>         # Check Docker\\r\\n>>         $dock = Get-Service \\\"docker\\\" -ErrorAction SilentlyContinue\\r\\n>>         if ($dock -and $dock.Status -ne \\\"Running\\\") {\\r\\n>>             Start-Service \\\"docker\\\"\\r\\n>>             Log-Claw \\\"ACTION\\\" \\\"SVC\\\" \\\"Restarted Docker\\\"\\r\\n>>         }\\r\\n>>         Start-Sleep -Seconds $Config.HealIntervalSec\\r\\n>>     }\\r\\n>> }\\r\\n>>\\r\\n>> function Start-DecisionEngine {\\r\\n>>     while ($true) {\\r\\n>>         $ts = Get-Date -Format \\\"yyyyMMdd-HHmmss\\\"\\r\\n>>         $threats = if (Test-Path \\\"$LogPath\\\\THREAT.log\\\") { (gc \\\"$LogPath\\\\THREAT.log\\\" | Measure-Object).Count } else { 0 }\\r\\n>>         $blocks = if (Test-Path \\\"$LogPath\\\\NET.log\\\") { (gc \\\"$LogPath\\\\NET.log\\\" | Measure-Object).Count } else { 0 }\\r\\n>>         $acts = if (Test-Path \\\"$LogPath\\\\ACTION.log\\\") { (gc \\\"$LogPath\\\\ACTION.log\\\" | Measure-Object).Count } else { 0 }\\r\\n>>         $score = [math]::Max(0, 100 - ($threats * 5) - ($blocks * 2) - ($acts * 0.5))\\r\\n>>         $state = @{Timestamp=$ts; HealthScore=[math]::Round($score,1); Threats=$threats; NetBlocks=$blocks; Actions=$acts; Status=if($score -gt 80){\\\"HEALTHY\\\"}elseif($score -gt 50){\\\"DEGRADED\\\"}else{\\\"CRITICAL\\\"}}\\r\\n>>         $state | ConvertTo-Json | Out-File \\\"$BrainPath\\\\state.json\\\"\\r\\n>>         if ($state.Status -eq \\\"CRITICAL\\\") {\\r\\n>>             $state | ConvertTo-Json | Out-File \\\"$VaultPath\\\\CRITICAL-$ts.json\\\"\\r\\n>>             Log-Claw \\\"CRITICAL\\\" \\\"BRAIN\\\" \\\"System health CRITICAL — $threats threats, $blocks blocks\\\"\\r\\n>>         }\\r\\n>>         Start-Sleep -Seconds $Config.HealIntervalSec\\r\\n>>     }\\r\\n>> }\\r\\n>>\\r\\n>> function Start-ClawAutonomous {\\r\\n>>     Write-Host \\\"[ΩΩΩ] CLAW v2.2 EMERGENCY BOOT\\\" -F Cyan\\r\\n>>     Get-Job | Where-Object {$_.Name -match \\\"Claw-\\\"} | Remove-Job -Force\\r\\n>>     $jobs = @()\\r\\n>>     $jobs += Start-Job -Name \\\"Claw-Process\\\" -ScriptBlock ${function:Start-ProcessWatcher}\\r\\n>>     $jobs += Start-Job -Name \\\"Claw-Network\\\" -ScriptBlock ${function:Start-NetworkWatcher}\\r\\n>>     $jobs += Start-Job -Name \\\"Claw-Memory\\\" -ScriptBlock ${function:Start-MemoryWatcher}\\r\\n>>     $jobs += Start-Job -Name \\\"Claw-Service\\\" -ScriptBlock ${function:Start-ServiceWatcher}\\r\\n>>     $jobs += Start-Job -Name \\\"Claw-Decision\\\" -ScriptBlock ${function:Start-DecisionEngine}\\r\\n>>     Log-Claw \\\"INFO\\\" \\\"BOOT\\\" \\\"5 watchers spawned\\\"\\r\\n>>     while ($true) {\\r\\n>>         Start-Sleep -Seconds 30\\r\\n>>         foreach ($j in $jobs) {\\r\\n>>             if ($j.State -eq \\\"Failed\\\" -or $j.State -eq \\\"Stopped\\\") {\\r\\n>>                 Log-Claw \\\"WARN\\\" \\\"WATCHER\\\" \\\"$($j.Name) died — respawning\\\"\\r\\n>>                 switch ($j.Name) {\\r\\n>>                     \\\"Claw-Process\\\"   { $jobs[$jobs.IndexOf($j)] = Start-Job -Name $j.Name -ScriptBlock ${function:Start-ProcessWatcher} }\\r\\n>>                     \\\"Claw-Network\\\"   { $jobs[$jobs.IndexOf($j)] = Start-Job -Name $j.Name -ScriptBlock ${function:Start-NetworkWatcher} }\\r\\n>>                     \\\"Claw-Memory\\\"    { $jobs[$jobs.IndexOf($j)] = Start-Job -Name $j.Name -ScriptBlock ${function:Start-MemoryWatcher} }\\r\\n>>                     \\\"Claw-Service\\\"   { $jobs[$jobs.IndexOf($j)] = Start-Job -Name $j.Name -ScriptBlock ${function:Start-ServiceWatcher} }\\r\\n>>                     \\\"Claw-Decision\\\"  { $jobs[$jobs.IndexOf($j)] = Start-Job -Name $j.Name -ScriptBlock ${function:Start-DecisionEngine} }\\r\\n>>                 }\\r\\n>>             }\\r\\n>>         }\\r\\n>>     }\\r\\n>> }\\r\\n>>\\r\\n>> Set-Item Function:global:ClawBoot -Value ${function:Start-ClawAutonomous}\\r\\n>> Set-Alias -Name claw-boot -Value ClawBoot -Scope Global\\r\\n>> Write-Host \\\"[ΩΩΩ] CLAW v2.2 EMERGENCY LOADED — RUN: claw-boot\\\" -F Green\\r\\n>> '@\\r\\nPS C:\\\\Users\\\\eagle>\\r\\nPS C:\\\\Users\\\\eagle> $emergency | Out-File $v22 -Encoding UTF8\\r\\nPS C:\\\\Users\\\\eagle> IEX (Get-Content $v22 -Raw)\\r\\nOut-File : Could not find a part of the path 'C:\\\\Sovereign\\\\Claw\\\\Brain\\\\config.json'.\\r\\nAt line:16 char:22\\r\\n+ } | ConvertTo-Json | Out-File \\\"$BrainPath\\\\config.json\\\"\\r\\n+                      ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\\r\\n    + CategoryInfo          : OpenError: (:) [Out-File], DirectoryNotFoundException\\r\\n    + FullyQualifiedErrorId : FileOpenFailure,Microsoft.PowerShell.Commands.OutFileCommand\\r\\n\\r\\nGet-Content : Cannot find path 'C:\\\\Sovereign\\\\Claw\\\\Brain\\\\config.json' because it does not exist.\\r\\nAt line:18 char:11\\r\\n+ $Config = Get-Content \\\"$BrainPath\\\\config.json\\\" | ConvertFrom-Json\\r\\n+           ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\\r\\n    + CategoryInfo          : ObjectNotFound: (C:\\\\Sovereign\\\\Claw\\\\Brain\\\\config.json:String) [Get-Content], ItemNotFoundException\\r\\n    + FullyQualifiedErrorId : PathNotFound,Microsoft.PowerShell.Commands.GetContentCommand\\r\\n\\r\\n[ΩΩΩ] CLAW v2.2 EMERGENCY LOADED — RUN: claw-boot\\r\\nPS C:\\\\Users\\\\eagle> claw-boot\\r\\n[ΩΩΩ] CLAW v2.2 EMERGENCY BOOT\\r\\nOut-File : Could not find a part of the path 'C:\\\\Sovereign\\\\Claw\\\\Logs\\\\BOOT.log'.\\r\\nAt line:23 char:13\\r\\n+     $line | Out-File \\\"$LogPath\\\\$Channel.log\\\" -Append\\r\\n+             ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\\r\\n    + CategoryInfo          : OpenError: (:) [Out-File], DirectoryNotFoundException\\r\\n    + FullyQualifiedErrorId : FileOpenFailure,Microsoft.PowerShell.Commands.OutFileCommand\\r\\n\\r\\n[BOOT] 5 watchers spawned\",\"From\":\"kimi-claw:main\",\"To\":\"main\",\"SessionKey\":\"agent:main:main\",\"Surface\":\"kimi-claw\",\"Provider\":\"kimi-claw\",\"OriginatingChannel\":\"kimi-claw\",\"OriginatingTo\":\"conversation:19e23db4-c0a2-8cfc-8000-092890ebda53\",\"AccountId\":\"19e23db4-c0a2-8cfc-8000-092890ebda53\",\"CommandAuthorized\":true}","_meta":{"runtime":"node","runtimeVersion":"24.15.0","hostname":"EOC","name":"{\"subsystem\":\"gateway\"}","parentNames":["openclaw"],"date":"2026-05-14T12:33:53.421Z","logLevelId":3,"logLevelName":"INFO","path":{"fullFilePath":"file:///C:/Users/eagle/AppData/Local/Programs/kimi-desktop/resources/resources/gateway.asar/node_modules/openclaw/dist/subsystem-BDbeCphF.js:1119:14","fileName":"subsystem-BDbeCphF.js","fileNameWithLine":"subsystem-BDbeCphF.js:1119","fileColumn":"14","fileLine":"1119","filePath":"/C:/Users/eagle/AppData/Local/Programs/kimi-desktop/resources/resources/gateway.asar/node_modules/openclaw/dist/subsystem-BDbeCphF.js","filePathWithLine":"/C:/Users/eagle/AppData/Local/Programs/kimi-desktop/resources/resources/gateway.asar/node_modules/openclaw/dist/subsystem-BDbeCphF.js:1119","method":"logToFile"}},"time":"2026-05-14T06:33:53.421-06:00"}

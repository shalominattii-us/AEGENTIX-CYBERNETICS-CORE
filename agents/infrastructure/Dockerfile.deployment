# Python slim Dockerfile for the Aegentix deployment agent
FROM python:3.12-slim

LABEL agent.role="deployment" \
      agent.version="1.0.0" \
      maintainer="aegentix-ops"

# Install system-level runtime dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    tini \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN addgroup --system app && adduser --system --group app

WORKDIR /app

# Copy and install Python dependencies
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy agent source
COPY deployment.py ./deployment.py
COPY autonomous_swarm.py ./autonomous_swarm.py
COPY config ./config

# Set ownership
RUN chown -R app:app /app

# Switch to non-root
USER app

# Environment
ENV PYTHONUNBUFFERED=1 \
    LOG_LEVEL=info \
    AGENT_ROLE=deployment

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]

CMD ["python", "-u", "deployment.py"]

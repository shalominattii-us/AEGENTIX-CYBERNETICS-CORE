{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegentix.local/schemas/service-manifest.schema.json",
  "title": "AEGENTIX Service Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "serviceId",
    "displayName",
    "version",
    "lifecycle",
    "health",
    "executionZones",
    "runtime",
    "endpoints",
    "dependencies",
    "capabilities",
    "governance",
    "observedAt"
  ],
  "properties": {
    "serviceId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "displayName": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "version": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["planned", "building", "deployed", "paused", "retired"]},
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["healthy", "degraded", "offline", "unknown"]},
        "reason": {"type": "string"},
        "lastCheck": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "executionZones": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["OpenClaw", "Nemotron", "Hermes", "Docker", "Manus", "AWS", "Azure", "LocalWindows"]}
    },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["docker-compose", "docker", "ecs-fargate", "process", "external", "agent-zone", "registry"]},
        "host": {"type": ["string", "null"]},
        "port": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535},
        "region": {"type": ["string", "null"]},
        "cluster": {"type": ["string", "null"]},
        "service": {"type": ["string", "null"]},
        "container": {"type": ["string", "null"]},
        "repository": {"type": ["string", "null"]}
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "access"],
        "properties": {
          "name": {"type": "string"},
          "url": {"type": "string"},
          "access": {"enum": ["local", "private", "public", "internal"]}
        }
      }
    },
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalActionsBlocked", "financialActionsBlocked", "destructiveActionsBlocked"],
      "properties": {
        "externalActionsBlocked": {"type": "boolean"},
        "financialActionsBlocked": {"type": "boolean"},
        "destructiveActionsBlocked": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]},
        "commit": {"type": ["string", "null"]}
      }
    },
    "observedAt": {"type": "string", "format": "date-time"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}

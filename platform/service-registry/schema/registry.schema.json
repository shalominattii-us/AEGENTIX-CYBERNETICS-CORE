{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AEGENTIX Service Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "generatedAt", "authority", "activeExecutionZones", "services"],
  "properties": {
    "$schema": {"type": "string"},
    "registryVersion": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "authority": {"type": "string", "minLength": 1},
    "activeExecutionZones": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["OpenClaw", "Nemotron", "Hermes", "Docker", "Manus", "AWS", "Azure", "LocalWindows"]}
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "service-manifest.schema.json"}
    }
  }
}

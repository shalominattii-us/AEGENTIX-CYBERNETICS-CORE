{
  "schema_version": "1.0.0",
  "name": "AEGENTIX Model Housing Registry",
  "defaults": {
    "local_noauth_loopback": true,
    "prefer_local_for_sensitive": true
  },
  "providers": {
    "ollama": {
      "kind": "openai_compat_or_native",
      "base_url_env": "OLLAMA_BASE_URL",
      "base_url_default": "http://127.0.0.1:11434",
      "enabled": true
    },
    "openai_compat": {
      "kind": "openai_compat",
      "base_url_env": "AEGENTIX_OPENAI_COMPAT_URL",
      "base_url_default": "",
      "api_key_env": "AEGENTIX_OPENAI_COMPAT_API_KEY",
      "enabled": false
    },
    "openrouter": {
      "kind": "openai_compat",
      "base_url_env": "OPENROUTER_BASE_URL",
      "base_url_default": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "enabled": true,
      "notes": "Key via OPENROUTER_API_KEY. Free-tier availability varies; verify model IDs in OpenRouter/Kilo."
    },
    "kilo": {
      "kind": "managed",
      "enabled": true,
      "notes": "Kilo-managed/provider-routed models; configure in Kilo CLI/UI config."
    },
    "gemini": {
      "kind": "cloud",
      "env_key": "GEMINI_API_KEY",
      "enabled": true
    },
    "claude": {
      "kind": "cloud",
      "env_key": "ANTHROPIC_API_KEY",
      "enabled": true
    },
    "native_edge": {
      "kind": "shm",
      "endpoint": "shm://aegentix_ipc_ringbuf",
      "enabled": true
    }
  },
  "models": [
    {
      "id": "titan-c-native",
      "provider": "native_edge",
